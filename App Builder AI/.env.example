DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
ANTHROPIC_API_KEY=sk-ant-...

# App URL used by Better Auth and Stripe checkout/portal redirects.
# Use your deployed domain in production, for example:
# BETTER_AUTH_URL=https://appweaverai.com
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional OAuth providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe billing.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe recurring Price IDs for the marketing pricing page checkout buttons.
STRIPE_BUILDER_MONTHLY_PRICE_ID=price_...
STRIPE_BUILDER_YEARLY_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_...
STRIPE_BUSINESS_YEARLY_PRICE_ID=price_...

# Legacy/single-plan billing page fallback. Usually match the Pro monthly price.
STRIPE_PRO_PRICE_ID=price_...
# Or configure the product instead and let the app resolve its default/monthly price.
STRIPE_PRO_PRODUCT_ID=prod_...
