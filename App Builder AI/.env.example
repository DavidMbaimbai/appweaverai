DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
# AI: all Claude calls go through Amazon Bedrock. AWS credentials are
# resolved via the standard AWS SDK credential chain (env vars, shared
# config/credentials files, or an IAM role) unless AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY are set below.
AWS_REGION=eu-north-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_TRANSLATE_MODEL_ID=eu.anthropic.claude-3-5-haiku-20241022-v1:0
# Optional overrides for the agent chat's model picker (Opus/Haiku variants).
# BEDROCK_MODEL_ID_OPUS=eu.anthropic.claude-opus-4-1-20250805-v1:0
# BEDROCK_MODEL_ID_HAIKU=eu.anthropic.claude-3-5-haiku-20241022-v1:0

# App URL used by Better Auth and Stripe checkout/portal redirects.
# Use your deployed domain in production, for example:
# BETTER_AUTH_URL=https://appweaverai.com
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hosting: managed subdomains are <slug>.<APP_ROOT_DOMAIN> (default appweaverai.com).
# Requires a wildcard DNS record (*.<root>) pointing at the host.
# APP_ROOT_DOMAIN=appweaverai.com
# DNS targets shown to users for custom domains (Vercel defaults):
# HOSTING_CNAME_TARGET=cname.vercel-dns.com
# HOSTING_A_RECORD=76.76.21.21
# Optional: attach verified custom domains to the Vercel project automatically.
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# Optional OAuth providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe billing.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe recurring Price IDs for the marketing pricing page checkout buttons.
STRIPE_BUILDER_MONTHLY_PRICE_ID=price_...
STRIPE_BUILDER_YEARLY_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_...
STRIPE_BUSINESS_YEARLY_PRICE_ID=price_...

# Legacy/single-plan billing page fallback. Usually match the Pro monthly price.
STRIPE_PRO_PRICE_ID=price_...
# Or configure the product instead and let the app resolve its default/monthly price.
STRIPE_PRO_PRODUCT_ID=prod_...

# Shared secret for cron endpoints (Vercel sends it as a Bearer token) and for
# the /api/social/posts queue API.
CRON_SECRET=

# Privacy: HMAC key for hashed opt-outs that survive erasure, and the account-deletion grace period (days).
# WARNING: falls back to BETTER_AUTH_SECRET when unset. Whichever key is in use must never change, or every
# hashed opt-out stops matching and erased people could be contacted again. Set it explicitly (and back it up)
# so rotating the auth secret does not silently break suppression. Required in production.
PRIVACY_HASH_SECRET=
PRIVACY_DELETION_GRACE_DAYS=14
# Set to true to force every retention policy into dry-run regardless of its stored setting.
PRIVACY_RETENTION_FORCE_DRY_RUN=false
# AI email auto-responder (polls this mailbox over IMAP every 5 minutes and
# replies via the SMTP_* settings, which must send as the same address).
SUPPORT_EMAIL=david.mbaimbai@appweaverai.com
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=david.mbaimbai@appweaverai.com
IMAP_PASSWORD=
# Replies the AI is less sure about than this (0-1) are held for human review
# (flagged + left unread) instead of being sent.
# SUPPORT_MIN_CONFIDENCE=0.6
# Shared rate limiting across instances (Upstash Redis REST); in-memory if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Operational alerts (failed crons/posts, server errors): Slack/Discord webhook and/or email.
# ALERT_WEBHOOK_URL=
# ALERT_EMAIL=
# Set true to queue new social posts as DRAFT until approved via PATCH /api/social/posts/<id>.
# SOCIAL_REQUIRE_APPROVAL=true
# Replies to inbound social comments/mentions/DMs (POST /api/social/interactions, cron /api/cron/social-replies).
# Users are auto-answered, investors are always held for approval (PATCH /api/social/interactions/<id>).
# Optional separate bearer secret for webhook senders (CRON_SECRET is also accepted).
# SOCIAL_WEBHOOK_SECRET=
# Comma-separated handles of our own accounts (never replied to, avoids loops).
# SOCIAL_OWN_HANDLES=appweaverai
# Set true to hold every reply for approval; min confidence (0-1) for auto-sending.
# SOCIAL_REPLY_REQUIRE_APPROVAL=true
# SOCIAL_REPLY_MIN_CONFIDENCE=0.7
# Live reply credentials reuse the FACEBOOK_*, X_*, LINKEDIN_*, INSTAGRAM_*, YOUTUBE_* values above.
# Extra: X_USER_ID + YOUTUBE_CHANNEL_ID enable polling mentions/comments (/api/cron/social-ingest);
# META_APP_SECRET + META_WEBHOOK_VERIFY_TOKEN enable the Facebook/Instagram webhook (/api/webhooks/meta);
# REDDIT_CLIENT_ID/REDDIT_CLIENT_SECRET/REDDIT_REFRESH_TOKEN enable Reddit replies;
# SOCIAL_REPLY_WEBHOOK_URL (+ optional SOCIAL_REPLY_WEBHOOK_SECRET) delivers replies for generic sources.
# LinkedIn and Reddit messages are fed in through POST /api/social/interactions.
# Paid Meta ads (Facebook + Instagram), fully automatic. Off unless META_ADS_ENABLED=true.
# Needs META_AD_ACCOUNT_ID, META_ADS_ACCESS_TOKEN (ads_management) and META_PAGE_ID.
# META_ADS_DAILY_BUDGET_CENTS can only lower the hard cap of 500 (USD 5/day in the account currency).
# META_ADS_COUNTRIES (default US,GB,CA,AU). Images use Bedrock Nova Canvas (ADS_IMAGE_MODEL_ID, ADS_IMAGE_REGION).
# Customer-run ads ("Connect Facebook" in Studio): set META_APP_ID + META_APP_SECRET, add the OAuth redirect
# URI <app url>/api/meta-ads/callback, and pass Meta app review for ads_management before customers can connect.
# SOCIAL_REPLY_DRY_RUN=true logs replies instead of sending them.
# Auto-written adverts: the daily social-post cron restocks the queue with AI adverts.
# SOCIAL_AD_AUTOGEN=false turns it off; SOCIAL_AD_MIN_QUEUE (default 2) sets queue size;
# SOCIAL_AD_FACTS lists extra approved facts the AI may use (nothing else is invented).
# X_USER_ID=
# YOUTUBE_CHANNEL_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# Investor outreach (POST /api/outreach/discover, GET /api/outreach/leads, PATCH /api/outreach/leads/<id>).
# Emails are only drafted; each is sent after approval, with opt-out footer and do-not-contact list.
# BRAVE_SEARCH_API_KEY=
# Facts the emails may state (stage, traction, ask, deck link). Required for drafting.
# OUTREACH_PITCH=
# Required by CAN-SPAM-style rules; sending is refused without it. SMTP_* must also be set.
# OUTREACH_POSTAL_ADDRESS=
# Sender address (the SMTP account must be allowed to send as it) and daily send cap.
# OUTREACH_FROM_EMAIL=david.mbaimbai@appweaverai.com
# OUTREACH_DAILY_LIMIT=20
# HMAC key for opt-out links (falls back to CRON_SECRET).
# OUTREACH_SECRET=
# Backups (npm run db:backup): use docker exec when Postgres runs in a container.
# BACKUP_DOCKER_CONTAINER=appweaverai-postgres
# BACKUP_KEEP=14
#
# Error monitoring (optional; everything is a no-op when unset). Secrets/PII are redacted before leaving the app.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
# Source-map upload during `next build` only when SENTRY_AUTH_TOKEN is set:
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Job failure-rate alerts reuse ALERT_WEBHOOK_URL / ALERT_EMAIL above.
#
# Automated backups (GitHub Action .github/workflows/backup.yml -> S3; see docs/runbooks/backup-restore.md).
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=db-backups/
# BACKUP_S3_SSE=AES256            # or aws:kms with BACKUP_S3_KMS_KEY_ID
# BACKUP_S3_KMS_KEY_ID=
# BACKUP_RETENTION_DAYS=30
# BACKUP_MIN_KEEP=7
# BACKUP_REPORT_URL=https://your-app/api/cron/backups   # reports use CRON_SECRET as bearer
# BACKUP_MAX_AGE_HOURS=30          # watchdog alerts when the last good backup is older
# BACKUP_DRILL_MAX_AGE_DAYS=10     # watchdog warns when the last restore drill is older

# Daily social posting (platforms without credentials are skipped).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
X_USER_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:organization:XXXX
# LINKEDIN_API_VERSION=202506
# Video-only platforms (skipped for posts without a video)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_PRIVACY_STATUS=private

# Real backend preview for generated Spring Boot / FastAPI apps (runs
# user-generated code in Docker WITH network access — enable only on a host
# with egress filtering). Optional: a pre-created Docker network that blocks
# internal/cloud-metadata addresses, and a cap on concurrent previews.
BACKEND_PREVIEW_ENABLED=false
# BACKEND_PREVIEW_NETWORK=
# BACKEND_PREVIEW_MAX=5

# Managed Postgres for generated apps (one role + database per project/environment)
MANAGED_DB_ADMIN_URL=
MANAGED_DB_HOST=
MANAGED_DB_SSLMODE=

# Cloudflare Turnstile CAPTCHA on sign-up (optional; both keys enable it)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Daily marketing video (GitHub Actions secrets): DEMO_BASE_URL, DEMO_DATABASE_URL, CRON_SECRET, MARKETING_S3_BUCKET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
# The recorder needs a working AI agent (AWS Bedrock credentials) on the target app.

# Per-project marketing with the customer's OWN social accounts (Project > Marketing). A connect button
# only shows when its credentials exist. Redirect URIs: {APP_URL}/api/project-marketing/callback/{x|linkedin|facebook}
# X: OAuth2 PKCE app (scopes tweet.read tweet.write users.read offline.access); X_CLIENT_SECRET only for confidential clients.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# LinkedIn: app with "Share on LinkedIn" + "Sign In with OpenID Connect" (scopes openid profile w_member_social).
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Facebook Pages reuse META_APP_ID + META_APP_SECRET (scopes pages_show_list pages_manage_posts pages_read_engagement; needs Meta app review).
# Instagram publishing (image posts only) goes through the connected Facebook Page's linked Instagram Business/Creator account and
# additionally needs instagram_basic + instagram_content_publish (Meta app review). Posts without an https image URL stay MANUAL.
# If the owner manages several Pages, they pick one after connecting.
# Investor Hub: cron /api/cron/investor-reminders (daily, CRON_SECRET) emails the owner a digest of due follow-ups.
# SMS to investors uses Twilio only, per-investor recorded consent, 08:00-20:00 investor-local, STOP honoured. Dry-run (logged, not sent) when unset.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=
# Public URL Twilio calls for inbound replies (/api/investor-hub/sms); used for signature validation behind proxies.
# TWILIO_WEBHOOK_URL=
# SMS_DRY_RUN=true
# Investor campaigns: cron /api/cron/investor-campaigns (every 15 min, CRON_SECRET) sends owner-approved campaigns. Needs SMTP, OUTREACH_POSTAL_ADDRESS,
# OUTREACH_SECRET (or CRON_SECRET) for unsubscribe links, and IMAP (support inbox) for reply/bounce detection. Not configured = dry run, nothing sent.
# AI voice calls (only to investors with recorded AI_CALL consent, weekdays 09:00-18:00 investor-local). Needs TWILIO_ACCOUNT_SID/AUTH_TOKEN and a verified number.
# TWILIO_VOICE_NUMBER=+15551234567
# Public base URL Twilio calls for /api/investor-voice/* (signature validated with TWILIO_AUTH_TOKEN); defaults to the app URL.
# TWILIO_VOICE_WEBHOOK_BASE=
# Founder phone for "transfer me to a human".
# INVESTOR_VOICE_TRANSFER_NUMBER=
# INVESTOR_VOICE_DAILY_CAP=10
# Unified inbox (/admin/inbox, /app/projects/<ws>/<project>/inbox). Channels without these show "not configured" in the UI.
# WhatsApp Business Cloud API: webhook URL /api/webhooks/whatsapp (verify token = WHATSAPP_VERIFY_TOKEN; payloads signed with META_APP_SECRET).
# Free-form replies only within 24h of the customer's last message; outside it only templates listed in WHATSAPP_APPROVED_TEMPLATES.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APPROVED_TEMPLATES=order_update,appointment_reminder
# SMS inbox: a dedicated Twilio number (not TWILIO_FROM_NUMBER, which serves investor SMS). Set its webhook to /api/webhooks/sms.
# Uses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN. STOP / START keywords update consent.
# TWILIO_INBOX_NUMBER=+15551234567
# Public URL Twilio signs (defaults to NEXT_PUBLIC_APP_URL + /api/webhooks/sms).
# TWILIO_INBOX_WEBHOOK_URL=
# SMS and WhatsApp stay UNAVAILABLE (sends return an error, nothing is simulated) until credentials are set AND "Verify now"
# in the inbox channel panel has succeeded (Twilio account fetch / WhatsApp phone-number GET); re-verify after 7 days or credential changes.
# Set the Twilio status callback to the same /api/webhooks/sms URL. Lead/marketing messages need a recorded opt-in (source, proof, timestamp).
# Messenger / Instagram DMs reuse FACEBOOK_PAGE_ID/FACEBOOK_PAGE_ACCESS_TOKEN, INSTAGRAM_USER_ID/INSTAGRAM_ACCESS_TOKEN,
# META_APP_SECRET and META_WEBHOOK_VERIFY_TOKEN on /api/webhooks/meta (subscribe the "messages" field; 24h window).
# Email uses the existing support mailbox (IMAP_* / SMTP_*). Web chat widget for projects:
#   <script src="https://YOUR_APP/api/messaging/webchat/widget" data-project-id="PROJECT_ID" async></script>
# Cron /api/cron/project-posts (every 15 min, CRON_SECRET) publishes only owner-approved posts.
# PROJECT_MARKETING_DRY_RUN=true logs due posts instead of sending them.

# AI video generation (Studio > Video). Provider: Amazon Nova Reel on Bedrock (amazon.nova-reel-v1:1),
# which is only available in us-east-1 and writes its output to S3 in the SAME region.
# VIDEO_S3_BUCKET=            # falls back to MARKETING_S3_BUCKET; needs s3:PutObject/GetObject/HeadObject and the
#                             # bedrock:InvokeModel, bedrock:StartAsyncInvoke, bedrock:GetAsyncInvoke permissions
# VIDEO_S3_REGION=us-east-1   # bucket region (must match VIDEO_BEDROCK_REGION for Nova Reel output)
# VIDEO_BEDROCK_REGION=us-east-1
# VIDEO_NOVA_REEL_CENTS_PER_SECOND=8   # ~0.08 USD per generated second, used for estimates, quotas and budgets
# Uses the same AWS credentials as the rest of the app. Enable the provider and set limits in /admin/video.
# Cron /api/cron/video-jobs (every 2 min, CRON_SECRET) submits queued jobs and polls running ones.
# --- Video release scheduler ---
# Cron: /api/cron/video-releases (every 5 min, CRON_SECRET bearer). Set true to log instead of publishing.
# VIDEO_RELEASE_DRY_RUN=true
# OAuth redirect URIs to register: {APP_URL}/api/video-release/callback/youtube and .../tiktok
# YouTube uses GOOGLE_CLIENT_ID/SECRET (scope youtube.upload). Unaudited API projects upload as private.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TikTok: unaudited apps can only post PRIVATE (SELF_ONLY). Set true only after TikTok approves the audit.
# TIKTOK_APP_AUDITED=false
# X video upload needs media.write and a paid API plan; manual download unless enabled.
# VIDEO_RELEASE_X_AUTO=false
# --- Public media hosting (generated marketing images/videos) ---
# Uploads reuse the video bucket (VIDEO_S3_BUCKET / MARKETING_S3_BUCKET) under media/private/<scope>/ and media/public/<scope>/.
# The bucket stays private. Point a CDN (e.g. CloudFront with an origin access control) at the bucket, restricted to the
# media/public/* prefix, and set its base URL here to give PUBLIC assets a permanent link (served as {base}/media/public/...).
# Without it every asset is served through presigned GET URLs that are re-signed and re-checked just before publishing.
# MEDIA_PUBLIC_BASE_URL=https://media.example.com
# MEDIA_URL_TTL_SECONDS=86400   # presigned link lifetime (min 300, max 604800 = 7 days; role credentials may cap it lower)

# Calendar sync + meetings. Each integration stays UNAVAILABLE until its credentials are set AND a live verification passes.
# OAuth redirect URIs: {APP_URL}/api/calendar/callback/google and {APP_URL}/api/calendar/callback/microsoft
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=
# Zoom Server-to-Server OAuth (meeting links):
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# Signs participant confirm/reschedule/cancel links (falls back to BETTER_AUTH_SECRET):
# MEETING_LINK_SECRET=
