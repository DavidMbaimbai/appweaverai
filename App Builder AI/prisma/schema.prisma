// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tables

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
  ANALYTICS_VIEWER
  SECURITY_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
  BANNED
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  /// Public handle shown in URLs, e.g. @username
  username      String?  @unique
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  subscriptionStatus   String? @map("subscription_status")
  subscriptionPlan     String  @default("free") @map("subscription_plan")

  /// Current Stripe billing period end (renewal/expiry date) for the active
  /// subscription, kept in sync from Stripe webhooks.
  subscriptionCurrentPeriodEnd DateTime? @map("subscription_current_period_end")

  /// Timestamps used to avoid re-sending the same billing alert email
  /// repeatedly. Cleared automatically once the underlying condition
  /// resolves (credits topped up / subscription renews into a new period).
  lowCreditsAlertSentAt     DateTime? @map("low_credits_alert_sent_at")
  renewalReminderSentForEnd DateTime? @map("renewal_reminder_sent_for_end")

  /// Admin Console: null means the user has no administrative access.
  adminRole AdminRole? @map("admin_role")

  accountStatus     AccountStatus @default(ACTIVE) @map("account_status")
  statusReason      String?       @map("status_reason") @db.Text
  statusChangedAt   DateTime?     @map("status_changed_at")
  statusChangedById String?       @map("status_changed_by_id")
  bannedAt          DateTime?     @map("banned_at")
  banExpiresAt      DateTime?     @map("ban_expires_at")

  /// AI usage credit balance available to the user (Admin Console: ADM-025).
  creditBalance Int @default(0) @map("credit_balance")

  accounts Account[]
  sessions Session[]

  ownedWorkspaces             Workspace[]             @relation("WorkspaceOwner")
  workspaceMemberships        WorkspaceMember[]
  createdProjects             Project[]               @relation("ProjectCreator")
  projectMemberships          ProjectMember[]
  projectPreferences          UserProjectPreference[]
  workspaceInvitesSent        WorkspaceInvitation[]   @relation("WorkspaceInviter")
  projectInvitesSent          ProjectInvitation[]     @relation("ProjectInviter")
  agentConversations          AgentConversation[]
  deploymentsCreated          Deployment[]            @relation("DeploymentCreator")
  projectCheckpointsCreated   ProjectCheckpoint[]     @relation("ProjectCheckpointCreator")
  projectGithubLinksConnected ProjectGithubLink[]     @relation("ProjectGithubLinkConnector")
  githubConnection            UserGithubConnection?
  settings                    UserSettings?

  aiUsageEvents          AiUsageEvent[]
  creditAdjustments      CreditAdjustment[] @relation("CreditAdjustmentTarget")
  flags                  UserFlag[]         @relation("FlaggedUser")
  ssoProvidersRegistered SsoProvider[]

  cliDeviceAuthorizations CliDeviceAuthorization[]
  cliTokens               CliToken[]
  savedSections           UserSavedSection[]
  brandKitDefault         UserBrandKit?
  savedPages              UserSavedPage[]
  templateFavorites       UserTemplateFavorite[]

  @@index([adminRole])
  @@index([accountStatus])
  @@map("users")
}

enum DefaultStartPage {
  HOME
  PROJECTS
}

model UserSettings {
  id                 String           @id @default(cuid())
  userId             String           @unique @map("user_id")
  emailNotifications Boolean          @default(true) @map("email_notifications")
  productUpdates     Boolean          @default(true) @map("product_updates")
  defaultStartPage   DefaultStartPage @default(HOME) @map("default_start_page")
  showShortcuts      Boolean          @default(true) @map("show_shortcuts")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Stores a user's personal-access-token connection to their own GitHub
/// account, used for the "Export to GitHub" feature (create/push a repo for
/// a project). The token is encrypted at rest with lib/crypto/secret-box.ts.
model UserGithubConnection {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  githubUsername       String   @map("github_username")
  encryptedAccessToken String   @map("encrypted_access_token") @db.Text
  scopes               String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_github_connections")
}

enum CliDeviceAuthorizationStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

/// OAuth-style device authorization grant (RFC 8628) used by the AppWeaverAI
/// CLI to sign in: the CLI requests a device_code/user_code pair here, the
/// user approves the user_code on the web, and the CLI then exchanges the
/// device_code for a CliToken. Rows are single-use once consumed/expired.
model CliDeviceAuthorization {
  id         String                       @id @default(cuid())
  deviceCode String                       @unique @map("device_code")
  userCode   String                       @unique @map("user_code")
  status     CliDeviceAuthorizationStatus @default(PENDING)
  userId     String?                      @map("user_id")
  clientName String?                      @map("client_name")
  interval   Int                          @default(5)
  expiresAt  DateTime                     @map("expires_at")
  createdAt  DateTime                     @default(now()) @map("created_at")
  updatedAt  DateTime                     @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("cli_device_authorizations")
}

/// Long-lived CLI access tokens. Only a salted hash of the token is ever
/// stored (see lib/crypto/token-hash.ts) since the CLI only needs equality
/// verification, not retrieval of the plaintext.
model CliToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  name       String?
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cli_tokens")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token") @db.Text
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model StripeEvent {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stripe_events")
}

/// Enterprise SSO/SAML connections, managed by the @better-auth/sso plugin
/// (see lib/auth.ts). Registration is gated to internal Admin Console staff
/// (see lib/admin/actions/sso.ts) rather than exposed for customer
/// self-service, since Enterprise SSO onboarding is handled through our
/// sales/support process.
model SsoProvider {
  id             String   @id @default(cuid())
  issuer         String
  oidcConfig     String?  @db.Text
  samlConfig     String?  @db.Text
  userId         String?  @map("user_id")
  providerId     String   @unique @map("provider_id")
  organizationId String?  @map("organization_id")
  domain         String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([domain])
  @@map("sso_providers")
}

enum AuthReminderKind {
  SIGNUP
  PASSWORD_RESET
}

/// Tracks an in-progress signup (email verification) or password-reset
/// attempt so we can nudge the user with a reminder email if they never
/// finish within 30 minutes. Resolved automatically once the user
/// verifies their email / resets their password / signs in successfully.
model PendingAuthReminder {
  id             String           @id @default(cuid())
  email          String
  kind           AuthReminderKind
  createdAt      DateTime         @default(now()) @map("created_at")
  /// When the reminder email should go out (createdAt + 30 minutes),
  /// refreshed each time the user re-requests a code for the same flow.
  remindAfter    DateTime         @map("remind_after")
  reminderSentAt DateTime?        @map("reminder_sent_at")
  resolvedAt     DateTime?        @map("resolved_at")

  @@index([kind, remindAfter, reminderSentAt, resolvedAt])
  @@index([email, kind])
  @@map("pending_auth_reminders")
}

// -----------------------------------------------------------------------------
// Workspaces — personal (solo) or team (shared access to all projects)
// -----------------------------------------------------------------------------

enum WorkspaceType {
  PERSONAL
  TEAM
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  GUEST
  VIEWER
}

model Workspace {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  type      WorkspaceType @default(PERSONAL)
  /// Owner of a personal workspace; billing admin for team workspaces.
  ownerId   String        @map("owner_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  projects    Project[]

  @@index([ownerId])
  @@index([type])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  invitedById String        @map("invited_by_id")
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@map("workspace_invitations")
}

// -----------------------------------------------------------------------------
// Projects — container for code, data, artifacts, and shared resources
// -----------------------------------------------------------------------------

enum ProjectAdminStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Project {
  id             String                 @id @default(cuid())
  reviews        ProjectReview[]
  reviewSettings ProjectReviewSettings?
  knowledgeDocs  ProjectKnowledge[]
  supportTickets ProjectSupportTicket[]
  workspaceId    String                 @map("workspace_id")
  name           String
  slug           String
  description    String?                @db.Text
  iconUrl        String?                @map("icon_url")
  createdById    String                 @map("created_by_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  deletedAt      DateTime?              @map("deleted_at")

  /// Admin Console lifecycle controls (ADM-073, ADM-074).
  adminStatus     ProjectAdminStatus @default(ACTIVE) @map("admin_status")
  suspendedReason String?            @map("suspended_reason") @db.Text
  suspendedAt     DateTime?          @map("suspended_at")
  suspendedById   String?            @map("suspended_by_id")
  archivedAt      DateTime?          @map("archived_at")

  /// Set when this project was created via the "Remix" action from a
  /// publicly-published project. Used to show remix counts in the gallery
  /// (Replit/Lovable-style community discovery).
  remixedFromProjectId String? @map("remixed_from_project_id")

  /// SEO metadata surfaced for the published site: <title>/<meta
  /// description>, the Open Graph/Twitter share image, and a custom
  /// favicon. All optional — falls back to the project name when unset.
  seoTitle          String? @map("seo_title")
  seoDescription    String? @map("seo_description") @db.Text
  seoImageUrl       String? @map("seo_image_url")
  faviconUrl        String? @map("favicon_url")
  /// Where form-submission emails go; falls back to the project owner.
  notificationEmail String? @map("notification_email")

  workspace         Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy         User                      @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members           ProjectMember[]
  invitations       ProjectInvitation[]
  preferences       UserProjectPreference[]
  artifacts         Artifact[]
  files             ProjectFile[]
  databases         ProjectDatabase[]
  storage           ProjectStorage?
  githubLink        ProjectGithubLink?
  githubSyncedFiles ProjectGithubSyncedFile[]
  customDomain      ProjectCustomDomain?
  secrets           ProjectSecret[]
  deployments       Deployment[]
  launchReports     LaunchReport[]
  checkpoints       ProjectCheckpoint[]
  conversations     AgentConversation[]
  agentToolCalls    AgentToolCall[]
  aiUsageEvents     AiUsageEvent[]
  flags             ProjectFlag[]
  pageViews         ProjectPageView[]
  brandKit          ProjectBrandKit?
  formSubmissions   ProjectFormSubmission[]
  leads             Lead[]
  leadSlots         LeadAvailabilitySlot[]
  growthExperiments GrowthExperiment[]
  remixedFrom       Project?                  @relation("ProjectRemixes", fields: [remixedFromProjectId], references: [id], onDelete: SetNull)
  remixes           Project[]                 @relation("ProjectRemixes")

  @@unique([workspaceId, slug])
  @@index([remixedFromProjectId])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, deletedAt])
  @@index([createdById])
  @@index([adminStatus])
  @@map("projects")
}

enum ProjectRole {
  OWNER
  PUBLISHER
  EDITOR
  VIEWER
}

/// Project-level access for guests and explicit grants (common in personal workspaces).
model ProjectMember {
  id        String      @id @default(cuid())
  projectId String      @map("project_id")
  userId    String      @map("user_id")
  role      ProjectRole @default(EDITOR)
  joinedAt  DateTime    @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectInvitation {
  id          String      @id @default(cuid())
  projectId   String      @map("project_id")
  email       String
  role        ProjectRole @default(EDITOR)
  token       String      @unique
  invitedById String      @map("invited_by_id")
  expiresAt   DateTime    @map("expires_at")
  acceptedAt  DateTime?   @map("accepted_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("ProjectInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([projectId, email])
  @@map("project_invitations")
}

/// Per-user project UI state: pins and recency ("last opened by you").
model UserProjectPreference {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  projectId            String    @map("project_id")
  isPinned             Boolean   @default(false) @map("is_pinned")
  lastOpenedAt         DateTime? @map("last_opened_at")
  /// Last artifact tab the user had open in the project editor.
  lastActiveArtifactId String?   @map("last_active_artifact_id")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId, lastOpenedAt])
  @@index([userId, isPinned])
  @@map("user_project_preferences")
}

// -----------------------------------------------------------------------------
// Artifacts — publishable outputs inside a project (max 7 per project in app logic)
// -----------------------------------------------------------------------------

enum ArtifactType {
  WEB_APP
  MOBILE_APP
  DATA_VIZ
  SLIDES
  ANIMATION
  GAME_3D
  DESIGN
  AGENT_AUTOMATION
}

enum ArtifactStatus {
  DRAFT
  READY
}

model Artifact {
  id              String         @id @default(cuid())
  projectId       String         @map("project_id")
  type            ArtifactType
  name            String
  slug            String
  status          ArtifactStatus @default(DRAFT)
  previewImageUrl String?        @map("preview_image_url")
  /// Live URL after the project is published (artifacts share one deployment).
  publishedUrl    String?        @map("published_url")
  sortOrder       Int            @default(0) @map("sort_order")
  /// When set, this artifact is a plain-code program in this language
  /// (e.g. "python", "java", "go") run via a sandboxed Docker container
  /// instead of the browser iframe preview used for web stacks. See
  /// lib/code-run/languages.ts for the supported id list.
  codingLanguage  String?        @map("coding_language")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files   ProjectFile[]

  @@unique([projectId, slug])
  @@index([projectId, sortOrder])
  @@map("artifacts")
}

// -----------------------------------------------------------------------------
// Project resources — shared by all artifacts in a project
// -----------------------------------------------------------------------------

enum ResourceEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum DatabaseProvider {
  NEON
  POSTGRES
}

/// Metadata for the managed Postgres database attached to a project.
/// Connection secrets are stored in ProjectSecret, not in plain text here.
model ProjectDatabase {
  id           String              @id @default(cuid())
  projectId    String              @map("project_id")
  environment  ResourceEnvironment @default(DEVELOPMENT)
  provider     DatabaseProvider    @default(NEON)
  databaseName String              @map("database_name")
  host         String?
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, environment])
  @@map("project_databases")
}

enum StorageProvider {
  S3
  R2
  GCS
}

/// Object storage bucket for unstructured files (images, uploads, exports).
model ProjectStorage {
  id         String          @id @default(cuid())
  projectId  String          @unique @map("project_id")
  provider   StorageProvider @default(R2)
  bucketName String          @map("bucket_name")
  region     String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_storages")
}

/// Tracks a project's linked GitHub repository for export/sync (ADM-parity with
/// Lovable/Replit "Export to GitHub"). One project links to at most one repo.
model ProjectGithubLink {
  id                  String    @id @default(cuid())
  projectId           String    @unique @map("project_id")
  repoOwner           String    @map("repo_owner")
  repoName            String    @map("repo_name")
  repoFullName        String    @map("repo_full_name")
  defaultBranch       String    @default("main") @map("default_branch")
  htmlUrl             String    @map("html_url")
  private             Boolean   @default(true)
  connectedById       String    @map("connected_by_id")
  /// Git commit SHA of the last successful import or push, used to detect
  /// whether the remote branch has moved since (fast-forward safety check).
  lastSyncedCommitSha String?   @map("last_synced_commit_sha")
  lastSyncedAt        DateTime? @map("last_synced_at")
  lastSyncedById      String?   @map("last_synced_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectedBy User    @relation("ProjectGithubLinkConnector", fields: [connectedById], references: [id], onDelete: Restrict)

  @@map("project_github_links")
}

/// Tracks the git blob SHA of each file as of the last successful GitHub
/// import/push, so the next push can diff current project files against
/// this snapshot and commit only what actually changed (incremental sync)
/// instead of force-overwriting the whole branch.
model ProjectGithubSyncedFile {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  path      String
  blobSha   String   @map("blob_sha")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@map("project_github_synced_files")
}

/// A verified custom domain pointing at a project's published deployment.
/// Verified via a DNS TXT record; once verified, requests to `domain` are
/// rewritten (see middleware.ts) to the project's published path.
model ProjectCustomDomain {
  id                String    @id @default(cuid())
  projectId         String    @unique @map("project_id")
  domain            String    @unique
  verificationToken String    @map("verification_token")
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_custom_domains")
}

/// Editor and deployment secrets (API keys, DATABASE_URL for user apps, etc.).
model ProjectSecret {
  id          String              @id @default(cuid())
  projectId   String              @map("project_id")
  key         String
  /// Encrypted at the application layer before persistence.
  value       String              @db.Text
  environment ResourceEnvironment @default(DEVELOPMENT)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, environment, key])
  @@map("project_secrets")
}

/// Source file metadata. File bytes live in object storage (ProjectStorage).
model ProjectFile {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  artifactId String?  @map("artifact_id")
  path       String
  storageKey String   @map("storage_key")
  mimeType   String?  @map("mime_type")
  sizeBytes  Int      @default(0) @map("size_bytes")
  checksum   String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifact Artifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@unique([projectId, path])
  @@index([projectId, updatedAt])
  @@index([artifactId])
  @@map("project_files")
}

// -----------------------------------------------------------------------------
// Version history — lightweight file snapshots so agent-driven changes can be
// rolled back (an automatic checkpoint is taken after every agent turn that
// writes files, plus users can save a named checkpoint manually).
// -----------------------------------------------------------------------------

model ProjectCheckpoint {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  label       String
  description String?  @db.Text
  /// false for user-triggered "Save checkpoint" — these are never
  /// auto-pruned, unlike automatic post-turn snapshots.
  isAutomatic Boolean  @default(true) @map("is_automatic")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project   Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?                   @relation("ProjectCheckpointCreator", fields: [createdById], references: [id], onDelete: SetNull)
  files     ProjectCheckpointFile[]

  @@index([projectId, createdAt])
  @@index([projectId, isAutomatic, createdAt])
  @@map("project_checkpoints")
}

/// Records which files (and sizes) existed at snapshot time. The actual
/// bytes are copied on disk under project-workspace/{projectId}/.checkpoints/{id}/.
model ProjectCheckpointFile {
  id           String  @id @default(cuid())
  checkpointId String  @map("checkpoint_id")
  path         String
  mimeType     String? @map("mime_type")
  sizeBytes    Int     @default(0) @map("size_bytes")

  checkpoint ProjectCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@unique([checkpointId, path])
  @@index([checkpointId])
  @@map("project_checkpoint_files")
}

// -----------------------------------------------------------------------------
// Website template & section library — curated starting points users can
// launch a new project from (full templates) or insert into an existing
// artifact (sections). Content is stored as text in the DB and copied onto
// disk (same layout the AI agent writes to) when used.
// -----------------------------------------------------------------------------

enum TemplateKind {
  /// A full starter website (index.html + styles.css + script.js).
  FULL_TEMPLATE
  /// A single reusable block (hero, pricing, testimonials, footer, etc.)
  /// meant to be inserted into an existing artifact.
  SECTION
}

enum TemplateMarket {
  FREELANCER
  SMALL_BUSINESS
  AGENCY
  SAAS
  GENERAL
}

model WebsiteTemplate {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  description     String?        @db.Text
  kind            TemplateKind
  market          TemplateMarket @default(GENERAL)
  previewImageUrl String?        @map("preview_image_url")
  sortOrder       Int            @default(0) @map("sort_order")
  isPublished     Boolean        @default(true) @map("is_published")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  files     WebsiteTemplateFile[]
  favorites UserTemplateFavorite[]

  @@index([kind, market, sortOrder])
  @@index([isPublished])
  @@map("website_templates")
}

/// Relative paths mirror the artifact file layout (index.html, styles.css,
/// script.js). For SECTION templates, path is a fixed virtual name
/// ("section.html") since sections are inserted rather than copied wholesale.
model WebsiteTemplateFile {
  id         String @id @default(cuid())
  templateId String @map("template_id")
  path       String
  content    String @db.Text

  template WebsiteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, path])
  @@map("website_template_files")
}

/// Account-level brand kit: new websites start with these values.
model UserBrandKit {
  userId         String   @id @map("user_id")
  logoUrl        String?  @map("logo_url")
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  accentColor    String?  @map("accent_color")
  fontFamily     String?  @map("font_family")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_brand_kits")
}

/// A section a user saved from one of their websites ("Save as Template",
/// Flow 5). `html` is the section's self-contained outerHTML.
model UserSavedSection {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  html      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_saved_sections")
}

/// A whole page (index.html + assets) saved as a personal template.
/// `files` is an array of { path, content } text files.
model UserSavedPage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  files     Json
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_saved_pages")
}

/// Starred built-in templates/sections for quick access.
model UserTemplateFavorite {
  userId     String   @map("user_id")
  templateId String   @map("template_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template WebsiteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([userId, templateId])
  @@map("user_template_favorites")
}

// -----------------------------------------------------------------------------
// Brand kit — logo/colors/font saved per project. Applied to the live site as
// a block of CSS custom properties written into the main artifact's
// stylesheet, so it has an immediate, visible effect without requiring the
// user (or agent) to manually restyle every element.
// -----------------------------------------------------------------------------

model ProjectBrandKit {
  id             String   @id @default(cuid())
  projectId      String   @unique @map("project_id")
  logoUrl        String?  @map("logo_url")
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  accentColor    String?  @map("accent_color")
  fontFamily     String?  @map("font_family")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_brand_kits")
}

// -----------------------------------------------------------------------------
// Form submissions — lets static-HTML contact/lead forms (e.g. the seeded
// "Contact Form" section) actually deliver messages somewhere. The preview
// runtime posts submissions to a public API route; the project owner reads
// them from the editor's Forms panel.
// -----------------------------------------------------------------------------

model ProjectFormSubmission {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  formName  String   @map("form_name")
  data      Json
  visitorId String?  @map("visitor_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_form_submissions")
}

// -----------------------------------------------------------------------------
// Deployments — publishing is project-wide; all artifacts go live together
// -----------------------------------------------------------------------------

enum DeploymentType {
  AUTOSCALE
  RESERVED_VM
  STATIC
  SCHEDULED
}

enum DeploymentVisibility {
  PUBLIC
  WORKSPACE_ONLY
  PRIVATE
}

enum DeploymentStatus {
  PENDING
  PROVISIONING
  BUILDING
  BUNDLING
  PROMOTING
  LIVE
  FAILED
  SUPERSEDED
}

model Deployment {
  id                  String                @id @default(cuid())
  projectId           String                @map("project_id")
  version             Int
  status              DeploymentStatus      @default(PENDING)
  deploymentType      DeploymentType        @default(AUTOSCALE) @map("deployment_type")
  visibility          DeploymentVisibility  @default(PUBLIC)
  /// Default subdomain, e.g. my-app.appweaverai.app
  domain              String
  customDomain        String?               @map("custom_domain")
  /// `isCurrent` marks the live PRODUCTION deployment only (staging rows never
  /// set it, so existing production queries stay correct). The live STAGING
  /// deployment is the one STAGING row with status LIVE; the migration enforces
  /// at most one current row per environment with partial unique indexes.
  isCurrent           Boolean               @default(false) @map("is_current")
  environment         DeploymentEnvironment @default(PRODUCTION)
  /// Random share token gating a STAGING deployment (null = open link).
  accessToken         String?               @map("access_token")
  /// Set on a PRODUCTION deployment created by promoting a staging version.
  promotedFromVersion Int?                  @map("promoted_from_version")
  createdById         String                @map("created_by_id")
  publishedAt         DateTime?             @map("published_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("DeploymentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, version])
  @@index([projectId, isCurrent])
  @@index([projectId, environment, status])
  @@index([domain])
  @@map("deployments")
}

/// One row per anonymous visit to a published project's public URL
/// (app/p/[workspaceSlug]/[projectSlug]). Powers the owner-facing public
/// analytics dashboard (page views, unique visitors, referrers, top paths).
/// `visitorId` is a daily-rotating hash (never the raw IP/UA), so it's only
/// good for a rough "unique visitors today/this week" count, not persistent
/// cross-session tracking.
model ProjectPageView {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  path      String
  referrer  String?
  /// UTM parameters of the landing URL (source/medium/campaign/content), when present.
  utm       Json?
  visitorId String   @map("visitor_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_page_views")
}

// -----------------------------------------------------------------------------
// Agent — conversations tied to a project (AppWeaver AI Agent)
// -----------------------------------------------------------------------------

enum AgentMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AgentConversation {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AgentMessage[]
  toolCalls AgentToolCall[]

  @@index([projectId, updatedAt])
  @@index([userId])
  @@map("agent_conversations")
}

enum AgentToolRiskLevel {
  /// Read-only or purely informational; always auto-executed.
  SAFE
  /// Mutates project files but is easily reversible via checkpoints;
  /// auto-executed and logged.
  REVIEW
  /// Destructive or hard-to-reverse (deletes, running commands, force
  /// pushes, etc.); requires explicit user approval before executing.
  DESTRUCTIVE
}

enum AgentToolCallStatus {
  /// Awaiting the user's approve/deny decision (DESTRUCTIVE tools only).
  PENDING
  APPROVED
  DENIED
  /// Ran successfully (immediately, for SAFE/REVIEW tools, or after approval).
  EXECUTED
  FAILED
}

/// Persisted audit trail + approval gate for every tool call the coding
/// agent makes. DESTRUCTIVE tool calls are created with status PENDING and
/// the agent loop blocks on them until a human decides via the
/// /api/agent/tool-calls/[id]/decision route; SAFE/REVIEW tool calls are
/// recorded for audit purposes immediately after they execute.
model AgentToolCall {
  id             String              @id @default(cuid())
  conversationId String              @map("conversation_id")
  projectId      String              @map("project_id")
  toolName       String              @map("tool_name")
  input          Json
  riskLevel      AgentToolRiskLevel  @map("risk_level")
  status         AgentToolCallStatus @default(PENDING)
  result         String?             @db.Text
  decidedById    String?             @map("decided_by_id")
  decidedAt      DateTime?           @map("decided_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([projectId])
  @@map("agent_tool_calls")
}

model AgentMessage {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  role           AgentMessageRole
  content        String           @db.Text
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

// -----------------------------------------------------------------------------
// Admin Console — audit, security, AI cost telemetry, and governance
// docs/ADMIN_CONSOLE_BACKLOG.md (EPIC 1, 7, 10, 12)
// -----------------------------------------------------------------------------

enum AuditResult {
  SUCCESS
  FAILURE
}

/// Immutable record of every privileged admin action (ADM-005). Never updated
/// or deleted through normal admin APIs.
model AdminAuditLog {
  id            String      @id @default(cuid())
  adminId       String?     @map("admin_id")
  adminEmail    String?     @map("admin_email")
  action        String
  targetType    String      @map("target_type")
  targetId      String?     @map("target_id")
  before        Json?
  after         Json?
  result        AuditResult @default(SUCCESS)
  reason        String?     @db.Text
  correlationId String      @map("correlation_id")
  ipAddress     String?     @map("ip_address")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}

enum SecurityEventType {
  LOGIN_FAILURE
  LOGIN_SUCCESS
  LOGOUT
  EMAIL_VERIFIED
  BRUTE_FORCE_SUSPECTED
  UNUSUAL_ACCESS
  RATE_LIMIT_VIOLATION
  ACCOUNT_BANNED
  ACCOUNT_SUSPENDED
  PAYMENT_ANOMALY
  ABUSE_SIGNAL
  OTHER
}

enum SecurityEventSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

/// Common security event model (ADM-091) for authentication, abuse, and
/// payment-related signals.
model SecurityEvent {
  id          String                @id @default(cuid())
  type        SecurityEventType
  severity    SecurityEventSeverity @default(INFO)
  subjectType String                @map("subject_type")
  subjectId   String?               @map("subject_id")
  message     String                @db.Text
  metadata    Json?
  ipAddress   String?               @map("ip_address")
  createdAt   DateTime              @default(now()) @map("created_at")

  @@index([severity, createdAt])
  @@index([type, createdAt])
  @@index([subjectType, subjectId])
  @@map("security_events")
}

enum FeedbackStatus {
  NEW
  READ
  RESOLVED
}

/// Star-rating product review left by a signed-in customer after using the
/// app (no admin FK relation, mirroring AdminAuditLog/SecurityEvent — kept
/// intentionally decoupled from User so a deleted account never blocks
/// reading historical feedback).
model ProductReview {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  userEmail String?  @map("user_email")
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@map("product_reviews")
}

/// Free-form message sent to the company from inside the app (e.g. a
/// "Send feedback" widget). Reviewed by admins in the Admin Console, who
/// may reply — the response is shown back to the user in the same widget.
model FeedbackMessage {
  id                 String         @id @default(cuid())
  userId             String?        @map("user_id")
  userEmail          String?        @map("user_email")
  message            String         @db.Text
  status             FeedbackStatus @default(NEW)
  response           String?        @db.Text
  respondedAt        DateTime?      @map("responded_at")
  respondedBy        String?        @map("responded_by")
  /// Human-readable name of the detected language of `message` (e.g. "Spanish").
  /// Null/omitted when the message is already in English.
  language           String?        @map("language")
  /// Auto-translated English version of `message`, shown to admins when
  /// `language` isn't English.
  translatedMessage  String?        @map("translated_message") @db.Text
  /// Auto-translated version of `response` in the user's original
  /// `language`, shown/emailed back to the user instead of the English reply.
  translatedResponse String?        @map("translated_response") @db.Text
  createdAt          DateTime       @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@map("feedback_messages")
}

enum AiUsageStatus {
  SUCCESS
  FAILURE
}

/// Per-request AI telemetry (ADM-060). Prompt content is intentionally not
/// stored here.
model AiUsageEvent {
  id                 String        @id @default(cuid())
  userId             String?       @map("user_id")
  projectId          String?       @map("project_id")
  provider           String
  model              String
  inputTokens        Int           @default(0) @map("input_tokens")
  outputTokens       Int           @default(0) @map("output_tokens")
  estimatedCostCents Int           @default(0) @map("estimated_cost_cents")
  latencyMs          Int?          @map("latency_ms")
  status             AiUsageStatus @default(SUCCESS)
  errorCategory      String?       @map("error_category")
  createdAt          DateTime      @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([provider, model, createdAt])
  @@map("ai_usage_events")
}

/// Manual credit grants/resets by support staff (ADM-025).
model CreditAdjustment {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  amount    Int
  reason    String   @db.Text
  adminId   String   @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation("CreditAdjustmentTarget", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_adjustments")
}

enum FlagStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum FlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Internal review flag on a user account (ADM-027).
model UserFlag {
  id           String       @id @default(cuid())
  userId       String       @map("user_id")
  reason       String       @db.Text
  severity     FlagSeverity @default(MEDIUM)
  status       FlagStatus   @default(OPEN)
  createdById  String       @map("created_by_id")
  reviewerNote String?      @map("reviewer_note") @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user User @relation("FlaggedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("user_flags")
}

/// Internal review flag on a project (ADM-075).
model ProjectFlag {
  id           String       @id @default(cuid())
  projectId    String       @map("project_id")
  reason       String       @db.Text
  severity     FlagSeverity @default(MEDIUM)
  status       FlagStatus   @default(OPEN)
  createdById  String       @map("created_by_id")
  reviewerNote String?      @map("reviewer_note") @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("project_flags")
}

/// Centralized, typed admin settings (ADM-110). Values are validated at the
/// application layer before being written here.
model AdminSetting {
  key         String   @id
  value       Json
  description String?  @db.Text
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("admin_settings")
}

// -----------------------------------------------------------------------------
// Social media — queue of marketing posts published daily by a cron job
// -----------------------------------------------------------------------------

enum SocialPostStatus {
  /// Awaiting human approval; never published until approved (-> PENDING).
  DRAFT
  PENDING
  POSTED
  FAILED
}

model SocialPost {
  id           String           @id @default(cuid())
  title        String
  /// Core marketing message; per-platform captions are derived from it.
  message      String
  /// Publicly reachable video URL (https, mp4). Optional for text-only posts.
  videoUrl     String?          @map("video_url")
  /// Subset of FACEBOOK, X, LINKEDIN. Empty means every configured platform.
  platforms    String[]
  status       SocialPostStatus @default(PENDING)
  scheduledFor DateTime         @default(now()) @map("scheduled_for")
  postedAt     DateTime?        @map("posted_at")
  attempts     Int              @default(0)
  /// Per-platform outcome: { FACEBOOK: { ok, id?, error? }, ... }
  results      Json?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([status, scheduledFor])
  @@map("social_posts")
}

// -----------------------------------------------------------------------------
// Social media — inbound comments/mentions/DMs from users and investors that the
// system classifies and answers (users auto-sent, investors held for approval)
// -----------------------------------------------------------------------------

enum SocialInteractionStatus {
  /// Ingested, waiting for the cron to classify and draft a reply.
  RECEIVED
  /// Claimed by a worker (drafting or sending); prevents double handling.
  PROCESSING
  /// Draft reply waiting for a human to approve, edit or reject it.
  PENDING_APPROVAL
  SENT
  SKIPPED
  FAILED
}

enum SocialAudience {
  USER
  INVESTOR
  /// Spam, abuse, bots or messages that need no reply.
  IGNORE
}

model SocialInteraction {
  id           String                  @id @default(cuid())
  /// X, LINKEDIN, FACEBOOK, INSTAGRAM, REDDIT, YOUTUBE or OTHER (generic webhook).
  platform     String
  /// Platform's own id for the message; unique per platform so retries are idempotent.
  externalId   String                  @map("external_id")
  /// Where to reply (parent post/comment/thread id), when the platform needs it.
  replyToId    String?                 @map("reply_to_id")
  authorHandle String                  @map("author_handle")
  authorName   String?                 @map("author_name")
  text         String
  status       SocialInteractionStatus @default(RECEIVED)
  audience     SocialAudience?
  /// Model's confidence (0-1) that the draft is correct and complete.
  confidence   Float?
  escalate     Boolean                 @default(false)
  reply        String?
  /// Why it was held, skipped or failed.
  note         String?
  attempts     Int                     @default(0)
  /// Outcome of the send: { ok, id?, error?, stubbed? }
  result       Json?
  repliedAt    DateTime?               @map("replied_at")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  @@unique([platform, externalId])
  @@index([status, createdAt])
  @@map("social_interactions")
}

// -----------------------------------------------------------------------------
// Investor outreach — leads found via web search, personalised email drafts that
// a human approves before sending, and a do-not-contact (suppression) list
// -----------------------------------------------------------------------------

enum InvestorLeadStatus {
  /// Found; no email draft yet, or no public email (usable as a call/manual list).
  DISCOVERED
  /// Email drafted; never sent until a human approves it.
  PENDING_APPROVAL
  /// Claimed by a sender; prevents double sends.
  SENDING
  SENT
  REJECTED
  DO_NOT_CONTACT
}

model InvestorLead {
  id            String             @id @default(cuid())
  name          String
  firm          String?
  /// Investment focus as stated on the source page.
  focus         String?
  sourceUrl     String             @map("source_url")
  /// Only addresses/numbers literally published on the source page are stored.
  email         String?            @unique
  phone         String?
  status        InvestorLeadStatus @default(DISCOVERED)
  subject       String?
  body          String?
  /// Short bullet points for a human to use on a call.
  talkingPoints String?            @map("talking_points")
  note          String?
  sentAt        DateTime?          @map("sent_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@unique([sourceUrl, name])
  @@index([status, createdAt])
  @@map("investor_leads")
}

model OutreachSuppression {
  /// Lowercased address that must never be emailed again.
  email     String   @id
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("outreach_suppressions")
}

// -----------------------------------------------------------------------------
// Paid advertising (Meta) — AI-written creatives, launched and optimised
// automatically, with sign-up / paid conversions attributed per creative
// -----------------------------------------------------------------------------
enum AdCreativeStatus {
  DRAFT
  ACTIVE
  PAUSED
  FAILED
}

model AdCreative {
  id          String           @id @default(cuid())
  headline    String
  primaryText String           @map("primary_text") @db.Text
  imagePrompt String           @map("image_prompt") @db.Text
  status      AdCreativeStatus @default(DRAFT)
  metaAdId    String?          @map("meta_ad_id")
  note        String?          @db.Text
  spendCents  Int              @default(0) @map("spend_cents")
  impressions Int              @default(0)
  clicks      Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@map("ad_creatives")
}

/// First-touch attribution captured from the aw_attr cookie at sign-up.
model AdAttribution {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  source    String?
  medium    String?
  campaign  String?
  /// utm_content: the AdCreative id for paid ads.
  content   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([content])
  @@map("ad_attributions")
}

/// Small key/value store, e.g. the Meta campaign and ad set ids.
model AdState {
  key   String @id
  value String

  @@map("ad_state")
}

/// Saved output of the Studio one-prompt launch (brand kit, ad pack, plan).
model LaunchKit {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  brief       String   @db.Text
  brand       String   @db.Text
  adPack      String   @map("ad_pack") @db.Text
  plan        String   @db.Text
  buildPrompt String   @map("build_prompt") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("launch_kits")
}

// -----------------------------------------------------------------------------
// Customer-run Meta ads — a customer connects their own Facebook account and
// launches AI-written ads, spending their own money under a per-user cap
// -----------------------------------------------------------------------------
model MetaAdConnection {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  /// Encrypted long-lived user access token.
  accessTokenEnc String    @map("access_token_enc") @db.Text
  tokenExpiresAt DateTime? @map("token_expires_at")
  adAccountId    String?   @map("ad_account_id")
  adAccountName  String?   @map("ad_account_name")
  currency       String?
  pageId         String?   @map("page_id")
  pageName       String?   @map("page_name")
  /// Max total daily budget across the user's running ads, in minor currency units (cents).
  dailyCapCents  Int       @default(500) @map("daily_cap_cents")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("meta_ad_connections")
}

model CustomerAd {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  headline     String
  primaryText  String   @map("primary_text") @db.Text
  link         String
  dailyCents   Int      @map("daily_cents")
  startsAt     DateTime @default(now()) @map("starts_at")
  endsAt       DateTime @map("ends_at")
  status       String   @default("ACTIVE")
  metaAdId     String?  @map("meta_ad_id")
  metaCampaign String?  @map("meta_campaign_id")
  spendCents   Int      @default(0) @map("spend_cents")
  clicks       Int      @default(0)
  impressions  Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("customer_ads")
}

// -----------------------------------------------------------------------------
// Customer-app reviews + support assistant (for customers' own published apps;
// AppWeaver's own platform AI never replies to reviews).
// -----------------------------------------------------------------------------

model ProjectReview {
  id            String    @id @default(cuid())
  projectId     String    @map("project_id")
  rating        Int
  authorName    String    @map("author_name")
  authorEmail   String?   @map("author_email")
  body          String    @db.Text
  topic         String?
  sentiment     String?
  urgency       String?
  status        String    @default("PENDING")
  aiDraft       String?   @map("ai_draft") @db.Text
  reply         String?   @db.Text
  replyStatus   String    @default("NONE") @map("reply_status")
  createdAt     DateTime  @default(now()) @map("created_at")
  /// Observatory: READY_FOR_REVIEW | NEEDS_INVESTIGATION | ESCALATION_REQUIRED | APPROVED_FOR_AUTOMATION
  responseState String    @default("READY_FOR_REVIEW") @map("response_state")
  /// Evidence bundle used for the draft (redacted; never contains secrets).
  evidence      Json?
  /// Original AI draft kept so owner corrections can be recorded.
  draftOriginal String?   @map("draft_original") @db.Text
  approvedById  String?   @map("approved_by_id")
  approvedAt    DateTime? @map("approved_at")
  repliedAt     DateTime? @map("replied_at")
  corrections   Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, createdAt])
  @@map("project_reviews")
}

model ProjectReviewSettings {
  id                String   @id @default(cuid())
  projectId         String   @unique @map("project_id")
  enabled           Boolean  @default(false)
  autoReplyPositive Boolean  @default(false) @map("auto_reply_positive")
  businessInfo      String   @default("") @map("business_info") @db.Text
  tone              String   @default("friendly")
  notifyEmail       String?  @map("notify_email")
  /// Optional owner-configured read-only status endpoint; only a reference id is sent.
  statusWebhookUrl  String?  @map("status_webhook_url")
  updatedAt         DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_review_settings")
}

model ProjectKnowledge {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_knowledge")
}

model ProjectSupportTicket {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  question   String   @db.Text
  contact    String?
  transcript Json?
  status     String   @default("OPEN")
  createdAt  DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, createdAt])
  @@map("project_support_tickets")
}

// -----------------------------------------------------------------------------
// Per-project marketing: campaigns and posts published to the customer's OWN
// social accounts. userId/projectId are plain indexed columns (no relations) so
// this feature does not touch the User/Project models.
// -----------------------------------------------------------------------------

enum MarketingPlatform {
  X
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

enum ProjectCampaignStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum ProjectPostStatus {
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  MANUAL
}

/// OAuth connection to a customer's own social account. Tokens are encrypted.
model SocialConnection {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  platform        MarketingPlatform
  accessTokenEnc  String            @map("access_token_enc")
  refreshTokenEnc String?           @map("refresh_token_enc")
  expiresAt       DateTime?         @map("expires_at")
  accountName     String?           @map("account_name")
  accountId       String?           @map("account_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@unique([userId, platform])
  @@map("social_connections")
}

model ProjectCampaign {
  id        String                @id @default(cuid())
  projectId String                @map("project_id")
  userId    String                @map("user_id")
  name      String
  brief     String                @default("") @db.Text
  status    ProjectCampaignStatus @default(DRAFT)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  posts ProjectPost[]

  @@index([projectId, createdAt])
  @@index([userId])
  @@map("project_campaigns")
}

model ProjectPost {
  id          String            @id @default(cuid())
  campaignId  String            @map("campaign_id")
  platform    MarketingPlatform
  text        String            @db.Text
  imageUrl    String?           @map("image_url")
  hashtags    String[]
  /// UTC instant; the owner's wall-clock choice is converted with timeZone.
  scheduledAt DateTime?         @map("scheduled_at")
  timeZone    String            @default("UTC") @map("time_zone")
  status      ProjectPostStatus @default(DRAFT)
  externalId  String?           @map("external_id")
  error       String?           @db.Text
  publishedAt DateTime?         @map("published_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  campaign ProjectCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([campaignId])
  @@map("project_posts")
}

/// Managed subdomain `<subdomain>.<APP_ROOT_DOMAIN>` served from a project's
/// published deployment. No FK relation so the schema stays append-only; a row
/// whose project no longer exists is treated as free (see subdomain-store.ts).
model ProjectSubdomain {
  id        String   @id @default(cuid())
  projectId String   @unique @map("project_id")
  subdomain String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_subdomains")
}

/// Result of a real health check against a project's live deployment.
model ProjectHealthCheck {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  ok         Boolean
  statusCode Int?     @map("status_code")
  latencyMs  Int?     @map("latency_ms")
  detail     String   @db.Text
  checkedAt  DateTime @default(now()) @map("checked_at")

  @@index([projectId, checkedAt])
  @@map("project_health_checks")
}

// -----------------------------------------------------------------------------
// Investor Hub (customer-facing fundraising CRM). Every row is scoped by userId
// AND projectId; no FK to User/Project so the schema stays append-only.
// -----------------------------------------------------------------------------
enum HubInvestorType {
  VC
  ANGEL
  FAMILY_OFFICE
  GRANT
  ACCELERATOR
  LENDER
  OTHER
}

enum HubInvestorStage {
  DISCOVERED
  RESEARCHED
  QUALIFIED
  OUTREACH_DRAFTED
  CONTACTED
  REPLIED
  MEETING_SCHEDULED
  PITCH_DELIVERED
  DUE_DILIGENCE
  NEGOTIATION
  FUNDING_SECURED
  DECLINED
}

enum HubOutreachKind {
  EMAIL
  FOLLOW_UP
  LINKEDIN
  CALL_SCRIPT
  MEETING_REQUEST
}

enum HubOutreachStatus {
  DRAFT
  APPROVED
  SENT
  CANCELLED
}

/// Only facts the founder typed in; these are the sole facts AI may use.
model InvestorHubProfile {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  projectId    String   @map("project_id")
  companyName  String   @default("") @map("company_name")
  website      String   @default("")
  description  String   @default("") @db.Text
  sector       String   @default("")
  stage        String   @default("")
  amountSought Int?     @map("amount_sought")
  currency     String   @default("USD")
  geography    String   @default("")
  traction     String   @default("") @db.Text
  useOfFunds   String   @default("") @map("use_of_funds") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, projectId])
  @@map("investor_hub_profiles")
}

model HubInvestor {
  id               String           @id @default(cuid())
  userId           String           @map("user_id")
  projectId        String           @map("project_id")
  name             String
  firm             String?
  type             HubInvestorType  @default(OTHER)
  website          String?
  /// Normalised host (no www) used for duplicate prevention.
  domain           String?
  email            String?
  /// Lowercased email used for duplicate prevention.
  emailKey         String?          @map("email_key")
  linkedinUrl      String?          @map("linkedin_url")
  focus            String?          @db.Text
  sectors          String[]
  stages           String[]
  geographies      String[]
  instruments      String[]
  ticketMin        Int?             @map("ticket_min")
  ticketMax        Int?             @map("ticket_max")
  portfolio        String[]
  sourceUrl        String?          @map("source_url")
  verified         Boolean          @default(false)
  lastVerifiedAt   DateTime?        @map("last_verified_at")
  /// Per-field provenance: { field: { sourceUrl, lastVerifiedAt, verified } }.
  fieldMeta        Json             @default("{}") @map("field_meta")
  pipelineStage    HubInvestorStage @default(DISCOVERED) @map("pipeline_stage")
  score            Int?
  scoreDetail      Json?            @map("score_detail")
  brief            String?          @db.Text
  briefSources     Json?            @map("brief_sources")
  briefAt          DateTime?        @map("brief_at")
  tags             String[]
  optedOut         Boolean          @default(false) @map("opted_out")
  sequenceActive   Boolean          @default(true) @map("sequence_active")
  nextFollowUpAt   DateTime?        @map("next_follow_up_at")
  fundingConfirmed Boolean          @default(false) @map("funding_confirmed")
  fundingAmount    Int?             @map("funding_amount")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  activities HubInvestorActivity[]
  outreach   HubInvestorOutreach[]
  replies    HubInvestorReply[]

  @@unique([projectId, domain])
  @@unique([projectId, emailKey])
  @@index([userId, projectId, pipelineStage])
  @@index([userId, projectId, nextFollowUpAt])
  @@map("hub_investors")
}

model HubInvestorActivity {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  projectId  String   @map("project_id")
  investorId String   @map("investor_id")
  type       String
  summary    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  investor HubInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId, createdAt])
  @@index([userId, projectId, createdAt])
  @@map("hub_investor_activities")
}

model HubInvestorOutreach {
  id         String            @id @default(cuid())
  userId     String            @map("user_id")
  projectId  String            @map("project_id")
  investorId String            @map("investor_id")
  kind       HubOutreachKind
  variant    Int               @default(1)
  subject    String?
  body       String            @db.Text
  status     HubOutreachStatus @default(DRAFT)
  approvedAt DateTime?         @map("approved_at")
  /// Always manual today: the founder copies the text and sends it themselves.
  sentAt     DateTime?         @map("sent_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  investor HubInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId, createdAt])
  @@index([userId, projectId, status, sentAt])
  @@map("hub_investor_outreach")
}

model HubInvestorReply {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  projectId      String   @map("project_id")
  investorId     String   @map("investor_id")
  text           String   @db.Text
  classification String
  createdAt      DateTime @default(now()) @map("created_at")

  investor HubInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId, createdAt])
  @@index([userId, projectId, createdAt])
  @@map("hub_investor_replies")
}

enum VideoJobMode {
  TEXT
  IMAGE
  VIDEO
}

enum VideoJobStatus {
  QUEUED
  SUBMITTED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum VideoProjectKind {
  STANDALONE
  SERIES
}

/// One AI video generation request sent to an external provider (e.g. Amazon
/// Nova Reel). Object keys are never exposed to clients; playback uses
/// short-lived presigned URLs minted after an owner check.
model VideoJob {
  id                 String         @id @default(cuid())
  userId             String         @map("user_id")
  projectId          String?        @map("project_id")
  providerId         String         @map("provider_id")
  model              String
  mode               VideoJobMode
  prompt             String         @db.Text
  inputImageKey      String?        @map("input_image_key")
  seconds            Int
  aspect             String         @default("16:9")
  status             VideoJobStatus @default(QUEUED)
  progress           Int            @default(0)
  externalId         String?        @map("external_id")
  attempts           Int            @default(0)
  nextAttemptAt      DateTime?      @map("next_attempt_at")
  error              String?        @db.Text
  outputKey          String?        @map("output_key")
  thumbnailKey       String?        @map("thumbnail_key")
  estimatedCostCents Int            @default(0) @map("estimated_cost_cents")
  actualCostCents    Int            @default(0) @map("actual_cost_cents")
  idempotencyKey     String         @unique @map("idempotency_key")
  submittedAt        DateTime?      @map("submitted_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  scenes VideoScene[]

  @@index([userId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([providerId, createdAt])
  @@map("video_jobs")
}

model VideoProject {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  title     String
  kind      VideoProjectKind @default(STANDALONE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  scenes VideoScene[]

  @@index([userId, updatedAt])
  @@map("video_projects")
}

model VideoScene {
  id                String   @id @default(cuid())
  videoProjectId    String   @map("video_project_id")
  order             Int
  prompt            String   @db.Text
  seconds           Int      @default(6)
  /// Optional reference image (S3 key, never sent to the client).
  referenceImageKey String?  @map("reference_image_key")
  jobId             String?  @map("job_id")
  season            Int?
  episode           Int?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  videoProject VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  job          VideoJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([videoProjectId, order])
  @@index([jobId])
  @@map("video_scenes")
}

/// Admin-managed switches and limits per video provider.
model VideoProviderConfig {
  id                 String   @id @default(cuid())
  providerId         String   @unique @map("provider_id")
  enabled            Boolean  @default(false)
  models             Json     @default("[]")
  maxSecondsPerJob   Int      @default(60) @map("max_seconds_per_job")
  dailyJobLimit      Int      @default(100) @map("daily_job_limit")
  monthlyBudgetCents Int      @default(10000) @map("monthly_budget_cents")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("video_provider_configs")
}

// -----------------------------------------------------------------------------
// Admin Application Observatory. Plain indexed projectId columns (no FKs) so the
// observatory never constrains Project deletion or other models.
// -----------------------------------------------------------------------------
enum AppFeatureStatus {
  PLANNED
  IMPLEMENTED
  TESTED
  DEPLOYED
  KNOWN_ISSUE
}

enum ProjectIssueStatus {
  OPEN
  ANALYSING
  FIX_PROPOSED
  APPROVED
  DEPLOYED
  VERIFIED
  CLOSED
}

/// Written every time an admin opens a project in the observatory.
model AdminAccessLog {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  adminEmail String?  @map("admin_email")
  projectId  String   @map("project_id")
  action     String
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@index([adminId, createdAt])
  @@map("admin_access_logs")
}

/// Version-aware feature ledger built only from real evidence.
model AppFeature {
  id         String           @id @default(cuid())
  projectId  String           @map("project_id")
  key        String
  name       String
  summary    String?          @db.Text
  status     AppFeatureStatus @default(PLANNED)
  /// Array of { type, ref, detail }
  evidence   Json             @default("[]")
  version    Int?
  verifiedAt DateTime?        @map("verified_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([projectId, key])
  @@index([projectId, status])
  @@map("app_features")
}

/// Result of an HTTP smoke check against the project's own published URL.
model SmokeCheck {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  url        String
  /// PASS | SUSPECTED | CONFIRMED_FAILURE
  outcome    String
  statusCode Int?     @map("status_code")
  title      String?
  version    Int?
  details    Json     @default("[]")
  checkedAt  DateTime @default(now()) @map("checked_at")

  @@index([projectId, checkedAt])
  @@index([outcome, checkedAt])
  @@map("smoke_checks")
}

/// A defect found via customer feedback, analysed into a plan the owner approves.
model ProjectIssue {
  id                String             @id @default(cuid())
  projectId         String             @map("project_id")
  reviewId          String?            @map("review_id")
  title             String
  severity          String             @default("medium")
  status            ProjectIssueStatus @default(OPEN)
  analysis          String?            @db.Text
  proposedPlan      String?            @map("proposed_plan") @db.Text
  evidence          Json               @default("[]")
  createdById       String?            @map("created_by_id")
  approvedById      String?            @map("approved_by_id")
  approvedAt        DateTime?          @map("approved_at")
  deployedAt        DateTime?          @map("deployed_at")
  verifiedAt        DateTime?          @map("verified_at")
  verifiedByCheckId String?            @map("verified_by_check_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([projectId, status])
  @@index([reviewId])
  @@map("project_issues")
}

// -----------------------------------------------------------------------------
// Investor Hub: call outcomes and consent-gated SMS. Plain indexed columns (no
// FKs) so the schema stays append-only; rows are removed with the investor or
// project by lib/projects/cleanup.ts.
// -----------------------------------------------------------------------------

/// Phone, time zone and the founder's recorded SMS consent for one investor.
model HubInvestorContact {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  projectId      String    @map("project_id")
  investorId     String    @unique @map("investor_id")
  /// E.164, e.g. +14155550123.
  phone          String?
  /// IANA zone used for quiet hours (08:00-20:00 investor-local).
  timezone       String?
  smsConsent     Boolean   @default(false) @map("sms_consent")
  smsConsentAt   DateTime? @map("sms_consent_at")
  /// How and when the investor agreed to be texted (required to enable SMS).
  smsConsentNote String?   @map("sms_consent_note")
  smsOptedOut    Boolean   @default(false) @map("sms_opted_out")
  smsOptedOutAt  DateTime? @map("sms_opted_out_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([phone])
  @@index([userId, projectId])
  @@map("hub_investor_contacts")
}

model HubInvestorCall {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  projectId  String   @map("project_id")
  investorId String   @map("investor_id")
  calledAt   DateTime @map("called_at")
  outcome    String
  notes      String?  @db.Text
  nextStep   String?  @map("next_step")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([investorId, calledAt])
  @@index([userId, projectId, calledAt])
  @@map("hub_investor_calls")
}

model HubInvestorSms {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  projectId  String   @map("project_id")
  investorId String   @map("investor_id")
  body       String   @db.Text
  /// SENT | DRY_RUN | FAILED
  status     String
  providerId String?  @map("provider_id")
  error      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([investorId, createdAt])
  @@index([userId, projectId, createdAt])
  @@map("hub_investor_sms")
}

// -----------------------------------------------------------------------------
// Video release scheduler: generated videos published to the owner's OWN
// connected accounts. Plain indexed columns (no FKs) so it never constrains
// VideoJob / VideoProject deletion.
// -----------------------------------------------------------------------------
enum VideoReleasePlatform {
  YOUTUBE
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  X
  TIKTOK
}

enum VideoReleaseStatus {
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  MANUAL
  CANCELLED
  PAUSED
}

model VideoRelease {
  id                String               @id @default(cuid())
  userId            String               @map("user_id")
  videoProjectId    String?              @map("video_project_id")
  sceneId           String?              @map("scene_id")
  jobId             String               @map("job_id")
  platform          VideoReleasePlatform
  language          String               @default("en")
  title             String
  caption           String               @default("") @db.Text
  hashtags          String[]
  thumbnailKey      String?              @map("thumbnail_key")
  /// UTC instant; the owner's wall-clock choice is converted with timeZone.
  scheduledAt       DateTime             @map("scheduled_at")
  timeZone          String               @default("UTC") @map("time_zone")
  status            VideoReleaseStatus   @default(SCHEDULED)
  approvedBy        String?              @map("approved_by")
  approvedAt        DateTime?            @map("approved_at")
  idempotencyKey    String               @unique @map("idempotency_key")
  externalId        String?              @map("external_id")
  postUrl           String?              @map("post_url")
  attempts          Int                  @default(0)
  nextAttemptAt     DateTime?            @map("next_attempt_at")
  error             String?              @db.Text
  /// Honest platform caveat shown to the owner (e.g. TikTok private-only posts).
  note              String?              @db.Text
  publishedAt       DateTime?            @map("published_at")
  season            Int?
  episode           Int?
  /// Groups the releases created by one series operation.
  seriesKey         String?              @map("series_key")
  /// Platform-returned metrics only (YouTube views); null when unavailable.
  metrics           Json?
  metricsAt         DateTime?            @map("metrics_at")
  reminderSentAt    DateTime?            @map("reminder_sent_at")
  outcomeNotifiedAt DateTime?            @map("outcome_notified_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@index([status, scheduledAt])
  @@index([userId, scheduledAt])
  @@index([userId, seriesKey])
  @@index([jobId])
  @@map("video_releases")
}

/// Append-only record of every credit balance change (charges, refunds, grants, admin adjustments).
model CreditLedger {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  /// Negative = spend, positive = grant/refund.
  delta          Int
  reason         String   @db.Text
  /// Pricing operation key (e.g. agent_run) or GRANT / REFUND / ADJUSTMENT.
  operation      String
  refType        String?  @map("ref_type")
  refId          String?  @map("ref_id")
  balanceAfter   Int      @map("balance_after")
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("credit_ledger")
}

/// Customer-acquisition CRM: one row per prospect of a published project (deduped by email).
model Lead {
  id               String    @id @default(cuid())
  projectId        String    @map("project_id")
  name             String
  email            String?
  phone            String?
  source           String    @default("manual")
  utm              Json?
  /// NEW | CONTACTED | QUALIFIED | DEMO_BOOKED | WON | LOST
  status           String    @default("NEW")
  score            Int?
  scoreReasons     Json?     @map("score_reasons")
  scoredAt         DateTime? @map("scored_at")
  notes            String    @default("") @db.Text
  consent          Boolean   @default(false)
  consentText      String?   @map("consent_text") @db.Text
  consentAt        DateTime? @map("consent_at")
  optedOut         Boolean   @default(false) @map("opted_out")
  formSubmissionId String?   @unique @map("form_submission_id")
  suggestedAction  String?   @map("suggested_action") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities LeadActivity[]
  followUps  LeadFollowUp[]
  drafts     LeadEmailDraft[]
  bookings   LeadBooking[]

  @@unique([projectId, email])
  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  type      String
  detail    String   @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

/// Owner reminder: surfaces in the daily digest until marked done.
model LeadFollowUp {
  id        String    @id @default(cuid())
  leadId    String    @map("lead_id")
  dueAt     DateTime  @map("due_at")
  note      String    @default("") @db.Text
  doneAt    DateTime? @map("done_at")
  createdAt DateTime  @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([doneAt, dueAt])
  @@index([leadId])
  @@map("lead_follow_ups")
}

/// AI-drafted follow-up email; only sent after explicit owner approval.
model LeadEmailDraft {
  id           String    @id @default(cuid())
  leadId       String    @map("lead_id")
  subject      String
  body         String    @db.Text
  /// DRAFT | SENT | CANCELLED
  status       String    @default("DRAFT")
  approvedById String?   @map("approved_by_id")
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, status])
  @@map("lead_email_drafts")
}

model LeadAvailabilitySlot {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  startsAt    DateTime @map("starts_at")
  durationMin Int      @default(30) @map("duration_min")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  booking LeadBooking?

  @@index([projectId, startsAt])
  @@map("lead_availability_slots")
}

model LeadBooking {
  id        String   @id @default(cuid())
  slotId    String   @unique @map("slot_id")
  leadId    String   @map("lead_id")
  createdAt DateTime @default(now()) @map("created_at")

  slot LeadAvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  lead Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_bookings")
}

/// Growth agent experiment. Executes only safe, existing, owner-approved actions; never spends money.
model GrowthExperiment {
  id                 String    @id @default(cuid())
  projectId          String    @map("project_id")
  hypothesis         String    @db.Text
  bottleneck         String    @db.Text
  /// { type, title, brief, citedMetrics[], metricKey, priority }
  proposedAction     Json      @map("proposed_action")
  /// Informational estimate only; nothing is ever charged automatically.
  estimatedCostCents Int?      @map("estimated_cost_cents")
  /// PROPOSED | APPROVED | RUNNING | MEASURED | REJECTED
  status             String    @default("PROPOSED")
  metricBefore       Json?     @map("metric_before")
  metricAfter        Json?     @map("metric_after")
  resultNote         String?   @map("result_note") @db.Text
  /// Ids/links of what the safe action created (campaign draft, issue, prompt).
  executionResult    Json?     @map("execution_result")
  windowDays         Int       @default(14) @map("window_days")
  approvedById       String?   @map("approved_by_id")
  startedAt          DateTime? @map("started_at")
  measuredAt         DateTime? @map("measured_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("growth_experiments")
}

// -----------------------------------------------------------------------------
// Investor Hub automation: per-campaign approval auto-send and the AI voice agent.
// Plain indexed columns for investor ids (no FK) so HubInvestor stays untouched.
// -----------------------------------------------------------------------------
enum InvestorCampaignStatus {
  DRAFT
  APPROVED
  RUNNING
  PAUSED
  STOPPED
  DONE
}

model InvestorCampaign {
  id              String                 @id @default(cuid())
  projectId       String                 @map("project_id")
  userId          String                 @map("user_id")
  name            String
  status          InvestorCampaignStatus @default(DRAFT)
  templateSubject String                 @default("") @map("template_subject")
  templateBody    String                 @default("") @map("template_body") @db.Text
  /// Extra first-email variants: [{ subject, body }]. Each target gets one deterministically.
  variants        Json                   @default("[]")
  followUpBody    String                 @default("") @map("follow_up_body") @db.Text
  dailyLimit      Int                    @default(20) @map("daily_limit")
  sendWindowStart Int                    @default(9) @map("send_window_start")
  sendWindowEnd   Int                    @default(17) @map("send_window_end")
  timezone        String                 @default("UTC")
  followUpDays    Int[]                  @map("follow_up_days")
  maxFollowUps    Int                    @default(2) @map("max_follow_ups")
  approvedAt      DateTime?              @map("approved_at")
  approvedBy      String?                @map("approved_by")
  acknowledgedAt  DateTime?              @map("acknowledged_at")
  pausedReason    String?                @map("paused_reason")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  targets InvestorCampaignTarget[]

  @@index([status, updatedAt])
  @@index([userId, projectId, createdAt])
  @@map("investor_campaigns")
}

model InvestorCampaignTarget {
  id         String    @id @default(cuid())
  campaignId String    @map("campaign_id")
  investorId String    @map("investor_id")
  email      String
  sourceUrl  String    @map("source_url")
  /// ACTIVE | COMPLETED | STOPPED_REPLY | STOPPED_BOUNCE | STOPPED_OPTOUT | STOPPED_MANUAL | SKIPPED
  status     String    @default("ACTIVE")
  stopReason String?   @map("stop_reason")
  stepsSent  Int       @default(0) @map("steps_sent")
  nextSendAt DateTime? @map("next_send_at")
  lastSentAt DateTime? @map("last_sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  campaign InvestorCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sends    InvestorCampaignSend[]

  @@unique([campaignId, investorId])
  @@index([email])
  @@index([campaignId, status, nextSendAt])
  @@map("investor_campaign_targets")
}

model InvestorCampaignSend {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  targetId   String   @map("target_id")
  /// 0 = first email, 1.. = follow-ups.
  step       Int
  /// SENDING (claimed) | SENT | BOUNCED
  status     String   @default("SENDING")
  subject    String
  body       String   @db.Text
  error      String?
  createdAt  DateTime @default(now()) @map("created_at")

  target InvestorCampaignTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  /// Idempotency: one email per target per step, ever.
  @@unique([targetId, step])
  @@index([campaignId, createdAt])
  @@map("investor_campaign_sends")
}

/// Recorded evidence that an investor agreed to an AI call (and optionally to recording).
model InvestorConsent {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  projectId  String    @map("project_id")
  investorId String    @map("investor_id")
  /// AI_CALL | CALL_RECORDING
  type       String
  evidence   String    @db.Text
  /// Phone the consent was given for; consent lapses if the number changes.
  phone      String?
  obtainedAt DateTime  @map("obtained_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([investorId, type, createdAt])
  @@index([userId, projectId])
  @@map("investor_consents")
}

model InvestorVoiceCall {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  projectId      String    @map("project_id")
  investorId     String    @map("investor_id")
  /// QUEUED | IN_PROGRESS | COMPLETED | NO_ANSWER | FAILED | CANCELLED
  status         String    @default("QUEUED")
  toNumber       String    @map("to_number")
  fromNumber     String    @map("from_number")
  transferNumber String?   @map("transfer_number")
  providerSid    String?   @map("provider_sid")
  recording      Boolean   @default(false)
  turns          Int       @default(0)
  /// [{ role: "ai" | "investor", text }]
  transcript     Json      @default("[]")
  summary        String?   @db.Text
  /// CALL_OUTCOMES value from the CRM call log.
  outcome        String?
  transferred    Boolean   @default(false)
  error          String?
  startedAt      DateTime? @map("started_at")
  endedAt        DateTime? @map("ended_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([investorId, createdAt])
  @@index([userId, projectId, createdAt])
  @@map("investor_voice_calls")
}

model InvestorMeetingRequest {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  projectId  String   @map("project_id")
  investorId String   @map("investor_id")
  callId     String?  @map("call_id")
  note       String   @db.Text
  /// OPEN | DONE
  status     String   @default("OPEN")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, projectId, status])
  @@index([investorId])
  @@map("investor_meeting_requests")
}

enum DeploymentEnvironment {
  STAGING
  PRODUCTION
}

/// A launch-readiness run for a project. `results` holds the per-check
/// PASS/WARN/FAIL/NOT_VERIFIED outcomes with evidence. Approval records the
/// owner's decision, including whether warnings were explicitly acknowledged.
model LaunchReport {
  id                   String                @id @default(cuid())
  projectId            String                @map("project_id")
  environment          DeploymentEnvironment @default(PRODUCTION)
  results              Json                  @default("[]")
  failCount            Int                   @default(0) @map("fail_count")
  warnCount            Int                   @default(0) @map("warn_count")
  deploymentVersion    Int?                  @map("deployment_version")
  approvedAt           DateTime?             @map("approved_at")
  approvedById         String?               @map("approved_by_id")
  acknowledgedWarnings Boolean               @default(false) @map("acknowledged_warnings")
  createdAt            DateTime              @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, environment, createdAt])
  @@map("launch_reports")
}

enum AgentScopeType {
  PLATFORM
  PROJECT
}

enum OrchestratorAgent {
  MARKETING_DIRECTOR
  CONTENT
  SOCIAL_MANAGER
  CUSTOMER_ENGAGEMENT
  INVESTOR
  VOICE_MESSAGING
  GROWTH_ANALYST
}

enum AgentMode {
  ASSIST
  APPROVAL
  AUTONOMOUS
}

enum AgentActivityStatus {
  PLANNED
  AWAITING_APPROVAL
  RUNNING
  DONE
  FAILED
  BLOCKED
}

/// Per-scope agent configuration. scopeId is "PLATFORM" for the platform scope, else the project id.
model AgentSetting {
  id               String            @id @default(cuid())
  scopeType        AgentScopeType    @map("scope_type")
  scopeId          String            @map("scope_id")
  agent            OrchestratorAgent
  mode             AgentMode         @default(ASSIST)
  enabled          Boolean           @default(false)
  paused           Boolean           @default(false)
  /// Categories allowed to run autonomously, e.g. ["social_post"].
  categories       Json              @default("[]")
  dailyActionLimit Int               @default(20) @map("daily_action_limit")
  dailyBudgetCents Int               @default(0) @map("daily_budget_cents")
  authorisedBy     String?           @map("authorised_by")
  authorisedAt     DateTime?         @map("authorised_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([scopeType, scopeId, agent])
  @@map("agent_settings")
}

/// Audit trail and approval queue for every agent action. Summaries are redacted before storage.
model AgentActivity {
  id             String              @id @default(cuid())
  scopeType      AgentScopeType      @map("scope_type")
  scopeId        String              @map("scope_id")
  agent          OrchestratorAgent
  action         String
  category       String              @default("general")
  risk           String              @default("LOW")
  status         AgentActivityStatus @default(PLANNED)
  sources        Json?
  tool           String?
  inputSummary   String?             @map("input_summary") @db.Text
  /// Redacted, non-secret data an executor needs to run the action after approval.
  payload        Json?
  resultSummary  String?             @map("result_summary") @db.Text
  decisionReason String?             @map("decision_reason")
  costCents      Int                 @default(0) @map("cost_cents")
  creditsCharged Int?                @map("credits_charged")
  error          String?             @db.Text
  retryOf        String?             @map("retry_of")
  idempotencyKey String?             @unique @map("idempotency_key")
  decidedBy      String?             @map("decided_by")
  decidedAt      DateTime?           @map("decided_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([scopeType, scopeId, createdAt])
  @@index([status, createdAt])
  @@index([agent, createdAt])
  @@map("agent_activities")
}

/// Kill switch rows: scope "GLOBAL" pauses every agent and automation, "PLATFORM" only platform automations.
model AgentKillSwitch {
  scope     String   @id
  paused    Boolean  @default(false)
  reason    String?
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("agent_kill_switches")
}

// ---------------------------------------------------------------------------
// Marketing credits (separate from build credits) and internal marketing cost
// ---------------------------------------------------------------------------

enum CampaignBilling {
  APPWEAVER_INTERNAL
  CUSTOMER_MARKETING
}

enum MarketingCreditSource {
  PURCHASED
  PROMO
  SUBSCRIPTION
  REFUND
}

enum MarketingLedgerKind {
  PURCHASE
  GRANT
  RESERVE
  SETTLE
  RELEASE
  REFUND
  EXPIRY
  ADJUSTMENT
}

enum MarketingReservationStatus {
  RESERVED
  SETTLED
  RELEASED
  REFUNDED
}

/// One wallet per billing owner (the workspace owner). `available` excludes `reserved`.
model MarketingWallet {
  userId                String    @id @map("user_id")
  available             Int       @default(0)
  reserved              Int       @default(0)
  /// Admin-configured facility: how far below zero `available` may go. 0 = never negative.
  overdraftLimit        Int       @default(0) @map("overdraft_limit")
  lowBalanceThreshold   Int?      @map("low_balance_threshold")
  lowBalanceAlertSentAt DateTime? @map("low_balance_alert_sent_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("marketing_wallets")
}

/// Tracks the unspent part of each grant so promo credits can expire.
model MarketingCreditLot {
  id        String                @id @default(cuid())
  userId    String                @map("user_id")
  source    MarketingCreditSource
  amount    Int
  remaining Int
  expiresAt DateTime?             @map("expires_at")
  refId     String?               @map("ref_id")
  createdAt DateTime              @default(now()) @map("created_at")

  @@index([userId, remaining, expiresAt])
  @@index([expiresAt])
  @@map("marketing_credit_lots")
}

/// Append-only (a database trigger rejects UPDATE and DELETE). `delta` changes the
/// total balance (available + reserved); `reservedDelta` moves credits into/out of reservation.
model MarketingLedger {
  id             String                 @id @default(cuid())
  userId         String                 @map("user_id")
  /// Organisation (workspace id, or `user:<id>` when no workspace applies) for reporting.
  orgId          String?                @map("org_id")
  projectId      String?                @map("project_id")
  kind           MarketingLedgerKind
  delta          Int
  reservedDelta  Int                    @default(0) @map("reserved_delta")
  operation      String?
  reservationId  String?                @map("reservation_id")
  refType        String?                @map("ref_type")
  refId          String?                @map("ref_id")
  source         MarketingCreditSource?
  costCents      Int?                   @map("cost_cents")
  balanceAfter   Int                    @map("balance_after")
  note           String?                @db.Text
  idempotencyKey String                 @unique @map("idempotency_key")
  createdAt      DateTime               @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([orgId, createdAt])
  @@index([projectId, createdAt])
  @@index([kind, createdAt])
  @@map("marketing_ledger")
}

model MarketingReservation {
  id             String                     @id @default(cuid())
  userId         String                     @map("user_id")
  orgId          String?                    @map("org_id")
  projectId      String?                    @map("project_id")
  operation      String
  billing        CampaignBilling            @default(CUSTOMER_MARKETING)
  maxCredits     Int                        @map("max_credits")
  settledCredits Int?                       @map("settled_credits")
  status         MarketingReservationStatus @default(RESERVED)
  idempotencyKey String                     @unique @map("idempotency_key")
  refType        String?                    @map("ref_type")
  refId          String?                    @map("ref_id")
  expiresAt      DateTime                   @map("expires_at")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  @@index([status, expiresAt])
  @@index([userId, status])
  @@index([projectId, createdAt])
  @@map("marketing_reservations")
}

/// What AppWeaver itself spends on its own marketing. Never touches customer wallets.
model InternalMarketingCost {
  id                 String          @id @default(cuid())
  billing            CampaignBilling @default(APPWEAVER_INTERNAL)
  operation          String
  provider           String
  estimatedCostCents Int             @map("estimated_cost_cents")
  actualCostCents    Int?            @map("actual_cost_cents")
  refType            String?         @map("ref_type")
  refId              String?         @map("ref_id")
  adminId            String?         @map("admin_id")
  createdAt          DateTime        @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([operation, createdAt])
  @@map("internal_marketing_costs")
}

/// Versioned, admin-managed price list. A change inserts a new version; old rows are preserved.
model MarketingPriceItem {
  id               String   @id @default(cuid())
  operation        String
  version          Int
  name             String
  description      String   @default("") @db.Text
  creditCost       Int      @map("credit_cost")
  /// e.g. {"type":"per_unit","unit":"second"} - creditCost is then the price per unit.
  rule             Json?
  provider         String?
  model            String?
  /// Estimated provider cost in cents per priced unit, when known (margin reporting).
  costCents        Float?   @map("cost_cents")
  /// Max charge = ceil(estimate * maxFactor); passthrough items use a factor above 1.
  maxFactor        Float    @default(1) @map("max_factor")
  planRestrictions String[] @map("plan_restrictions")
  billable         Boolean  @default(true)
  maxPerPeriod     Int?     @map("max_per_period")
  effectiveFrom    DateTime @default(now()) @map("effective_from")
  createdById      String?  @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([operation, version])
  @@index([operation, effectiveFrom])
  @@map("marketing_price_items")
}

model MarketingPackage {
  id         String   @id @default(cuid())
  name       String
  credits    Int
  priceCents Int      @map("price_cents")
  currency   String   @default("usd")
  active     Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("marketing_packages")
}

model MarketingPurchase {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  packageId       String?  @map("package_id")
  packageName     String   @map("package_name")
  credits         Int
  amountCents     Int      @map("amount_cents")
  currency        String
  stripeSessionId String   @unique @map("stripe_session_id")
  paymentIntentId String?  @unique @map("payment_intent_id")
  stripeEventId   String?  @map("stripe_event_id")
  receiptUrl      String?  @map("receipt_url")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("marketing_purchases")
}

/// Per-project spend limits for recurring/scheduled marketing jobs.
model MarketingProjectBudget {
  projectId    String    @id @map("project_id")
  dayLimit     Int?      @map("day_limit")
  weekLimit    Int?      @map("week_limit")
  monthLimit   Int?      @map("month_limit")
  pausedAt     DateTime? @map("paused_at")
  pausedReason String?   @map("paused_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("marketing_project_budgets")
}

/// Admin controls per organisation (workspace id, or `user:<id>`).
model MarketingOrgControl {
  orgId           String    @id @map("org_id")
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason")
  /// Max credits the org may consume per calendar month; null = unlimited.
  monthlyLimit    Int?      @map("monthly_limit")
  updatedById     String?   @map("updated_by_id")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("marketing_org_controls")
}

// -----------------------------------------------------------------------------
// Configurable daily content pipeline (platform house content + per-project)
// -----------------------------------------------------------------------------

enum ContentRunStatus {
  RUNNING
  WAITING
  SUCCEEDED
  PARTIAL
  FAILED
}

model ContentPipeline {
  id                    String         @id @default(cuid())
  scope                 AgentScopeType
  /// "PLATFORM" or the project id; unique so each scope has one pipeline.
  scopeKey              String         @unique @map("scope_key")
  projectId             String?        @map("project_id")
  /// User whose wallet/video quota is used; for PLATFORM it must be an admin (internal billing).
  ownerUserId           String         @map("owner_user_id")
  enabled               Boolean        @default(false)
  paused                Boolean        @default(false)
  /// Local wall-clock "HH:MM" in timeZone at which the daily run starts.
  timeOfDay             String         @default("09:00") @map("time_of_day")
  timeZone              String         @default("UTC") @map("time_zone")
  postsPerDay           Int            @default(1) @map("posts_per_day")
  platforms             String[]
  languages             String[]
  /// Subset of post, image, video.
  contentTypes          String[]       @map("content_types")
  /// Local "HH:MM" slots used to schedule the generated posts.
  preferredPostTimes    String[]       @map("preferred_post_times")
  /// Agent categories (e.g. social_post) allowed to be auto-approved by this pipeline.
  autoPublishCategories String[]       @map("auto_publish_categories")
  objective             String         @default("") @db.Text
  lastRunAt             DateTime?      @map("last_run_at")
  /// Daily spend ceiling in marketing credits (customer scope); 0 = no extra cap.
  maxDailyCredits       Int            @default(0) @map("max_daily_credits")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  runs ContentRun[]

  @@index([enabled, scope])
  @@map("content_pipelines")
}

model ContentRun {
  id          String           @id @default(cuid())
  pipelineId  String           @map("pipeline_id")
  /// Local calendar day (YYYY-MM-DD) in the pipeline time zone: one run per pipeline per day.
  runDate     String           @map("run_date")
  status      ContentRunStatus @default(RUNNING)
  /// Per-step state and results keyed by step name.
  steps       Json             @default("{}")
  errors      Json             @default("[]")
  lockedUntil DateTime?        @map("locked_until")
  trigger     String           @default("cron")
  startedAt   DateTime         @default(now()) @map("started_at")
  finishedAt  DateTime?        @map("finished_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  pipeline ContentPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, runDate])
  @@index([status, updatedAt])
  @@map("content_runs")
}

// ---------------------------------------------------------------------------
// Unified inbox (webchat, email, WhatsApp, SMS, Messenger, Instagram DMs)
// ---------------------------------------------------------------------------

enum MessageChannel {
  WEBCHAT
  EMAIL
  WHATSAPP
  SMS
  FACEBOOK
  INSTAGRAM
}

enum ConversationStatus {
  OPEN
  ESCALATED
  RESOLVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

/// One thread with one contact on one channel. Scope PLATFORM = AppWeaver itself, PROJECT = a customer project.
model Conversation {
  id               String             @id @default(cuid())
  scopeType        AgentScopeType     @map("scope_type")
  scopeId          String             @map("scope_id")
  channel          MessageChannel
  externalThreadId String             @map("external_thread_id")
  /// Channel address of the contact: E.164 phone, email, or page-scoped id. Treated as personal data.
  contactRef       String             @map("contact_ref")
  contactName      String?            @map("contact_name")
  leadId           String?            @map("lead_id")
  status           ConversationStatus @default(OPEN)
  assignedTo       String?            @map("assigned_to")
  /// When true the AI never answers this conversation.
  humanTakeover    Boolean            @default(false) @map("human_takeover")
  isReview         Boolean            @default(false) @map("is_review")
  language         String?
  category         String?
  summary          String?            @db.Text
  lastMessageAt    DateTime           @default(now()) @map("last_message_at")
  /// Last message from the contact; drives the 24h customer-service window on WhatsApp, Messenger and Instagram.
  lastInboundAt    DateTime?          @map("last_inbound_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  messages InboxMessage[]

  @@unique([scopeType, scopeId, channel, externalThreadId], map: "conversations_thread_key")
  @@index([scopeType, scopeId, status, lastMessageAt])
  @@map("conversations")
}

model InboxMessage {
  id                String                 @id @default(cuid())
  conversationId    String                 @map("conversation_id")
  channel           MessageChannel
  direction         MessageDirection
  body              String                 @db.Text
  attachments       Json?
  /// Provider id (wamid, Twilio SID, Meta mid, email Message-ID). Unique per channel so retried webhooks are no-ops.
  providerMessageId String?                @map("provider_message_id")
  deliveryStatus    MessageDeliveryStatus? @map("delivery_status")
  aiGenerated       Boolean                @default(false) @map("ai_generated")
  /// Unsent AI or human draft waiting in the inbox.
  isDraft           Boolean                @default(false) @map("is_draft")
  category          String?
  /// Knowledge entries the draft was built from.
  sources           Json?
  agentActivityId   String?                @map("agent_activity_id")
  error             String?
  createdAt         DateTime               @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([channel, providerMessageId])
  @@index([conversationId, createdAt])
  @@map("inbox_messages")
}

/// Credentials for one channel of one scope. `config` is AES-GCM encrypted JSON (lib/crypto/secret-box).
model ChannelConnection {
  id          String         @id @default(cuid())
  scopeType   AgentScopeType @map("scope_type")
  scopeId     String         @map("scope_id")
  channel     MessageChannel
  /// Non-secret provider account id used to route webhooks (phone number id, page id, Twilio number).
  accountId   String?        @map("account_id")
  config      String         @db.Text
  status      String         @default("ACTIVE")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([scopeType, scopeId, channel])
  @@index([channel, accountId])
  @@map("channel_connections")
}

/// Per contact+channel opt-in/opt-out; checked before every outbound message.
model ContactConsent {
  id        String         @id @default(cuid())
  scopeType AgentScopeType @map("scope_type")
  scopeId   String         @map("scope_id")
  channel   MessageChannel
  contact   String
  optIn     Boolean        @default(false) @map("opt_in")
  optOut    Boolean        @default(false) @map("opt_out")
  source    String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([scopeType, scopeId, channel, contact])
  @@map("contact_consents")
}

/// AppWeaver's own product facts for the platform-scope inbox; never mixed with ProjectKnowledge.
model PlatformKnowledge {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("platform_knowledge")
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaVisibility {
  PRIVATE
  PUBLIC
}

enum MediaAssetStatus {
  READY
  FAILED
}

/// An uploaded marketing image or video. Posts reference it as `media://<id>`; the URL is resolved (and re-signed) at publish time.
model MediaAsset {
  id           String           @id @default(cuid())
  /// "PLATFORM" or the project id; every object key is scoped by it.
  scopeKey     String           @map("scope_key")
  projectId    String?          @map("project_id")
  ownerUserId  String?          @map("owner_user_id")
  kind         MediaKind
  visibility   MediaVisibility  @default(PRIVATE)
  status       MediaAssetStatus @default(READY)
  key          String           @unique
  contentType  String           @map("content_type")
  sizeBytes    Int              @map("size_bytes")
  sha256       String
  error        String?          @db.Text
  contentRunId String?          @map("content_run_id")
  videoJobId   String?          @map("video_job_id")
  linkedType   String?          @map("linked_type")
  linkedId     String?          @map("linked_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([scopeKey, createdAt])
  @@index([contentRunId])
  @@index([videoJobId])
  @@index([linkedType, linkedId])
  @@map("media_assets")
}

/// Every provider delivery event processed once; the unique event id makes retried status webhooks no-ops.
model MessageStatusEvent {
  id                String         @id @default(cuid())
  channel           MessageChannel
  /// Provider event id, e.g. "<MessageSid>:delivered" (Twilio) or "<wamid>:read" (WhatsApp).
  eventId           String         @map("event_id")
  providerMessageId String         @map("provider_message_id")
  /// QUEUED | SENT | DELIVERED | READ | FAILED
  status            String
  errorCode         String?        @map("error_code")
  errorMessage      String?        @map("error_message")
  createdAt         DateTime       @default(now()) @map("created_at")

  @@unique([channel, eventId])
  @@index([channel, providerMessageId])
  @@map("message_status_events")
}

/// Suppression list: nothing is sent to a suppressed contact on that channel until they opt back in.
model MessagingSuppression {
  id        String         @id @default(cuid())
  scopeType AgentScopeType @map("scope_type")
  scopeId   String         @map("scope_id")
  channel   MessageChannel
  contact   String
  /// STOP | UNSUBSCRIBE | MANUAL ... (the keyword or reason that caused it)
  reason    String
  source    String
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([scopeType, scopeId, channel, contact])
  @@map("messaging_suppressions")
}

/// Evidence behind a marketing / lead opt-in: where, when and what the contact agreed to.
model ConsentProof {
  id         String         @id @default(cuid())
  scopeType  AgentScopeType @map("scope_type")
  scopeId    String         @map("scope_id")
  channel    MessageChannel
  contact    String
  source     String
  proof      String         @db.Text
  capturedAt DateTime       @map("captured_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([scopeType, scopeId, channel, contact])
  @@map("consent_proofs")
}

/// Result of the last live provider check; a channel is AVAILABLE only while this is VERIFIED for the current credentials.
model ChannelVerification {
  id          String         @id @default(cuid())
  scopeType   AgentScopeType @map("scope_type")
  scopeId     String         @map("scope_id")
  channel     MessageChannel
  /// VERIFIED | FAILED
  status      String
  /// Hash of the credentials that were checked, so changing them invalidates the verification.
  fingerprint String
  detail      String?
  errorCode   String?        @map("error_code")
  checkedAt   DateTime       @default(now()) @map("checked_at")

  @@unique([scopeType, scopeId, channel])
  @@map("channel_verifications")
}

// -----------------------------------------------------------------------------
// Calendar sync (Google Calendar / Microsoft Outlook). scopeKey is a projectId or "PLATFORM".
// Plain indexed columns (no relations) so Project / LeadBooking stay untouched.
// -----------------------------------------------------------------------------

/// One calendar connection per project (or the platform). Tokens are AES-GCM encrypted.
model CalendarConnection {
  id                   String    @id @default(cuid())
  scopeKey             String    @unique @map("scope_key")
  ownerId              String    @map("owner_id")
  /// GOOGLE | MICROSOFT
  provider             String
  /// PENDING | CONNECTED | NEEDS_RECONNECT
  status               String    @default("PENDING")
  refreshTokenEnc      String?   @map("refresh_token_enc") @db.Text
  accessTokenEnc       String?   @map("access_token_enc") @db.Text
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  scopes               String    @default("")
  accountLabel         String?   @map("account_label")
  calendarId           String    @default("primary") @map("calendar_id")
  /// Last successful live call against the provider; availability is UNAVAILABLE without it.
  verifiedAt           DateTime? @map("verified_at")
  lastError            String?   @map("last_error") @db.Text
  lastSyncAt           DateTime? @map("last_sync_at")
  /// { mon: [["09:00","17:00"]], ... } in timeZone.
  workingHours         Json?     @map("working_hours")
  bufferBeforeMin      Int       @default(0) @map("buffer_before_min")
  bufferAfterMin       Int       @default(0) @map("buffer_after_min")
  minNoticeMin         Int       @default(120) @map("min_notice_min")
  slotStepMin          Int       @default(30) @map("slot_step_min")
  durationMin          Int       @default(30) @map("duration_min")
  timeZone             String    @default("UTC") @map("time_zone")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("calendar_connections")
}

/// Short-lived OAuth state + PKCE verifier; consumed (deleted) by the callback.
model CalendarOAuthState {
  id              String   @id @default(cuid())
  stateHash       String   @unique @map("state_hash")
  scopeKey        String   @map("scope_key")
  userId          String   @map("user_id")
  provider        String
  codeVerifierEnc String   @map("code_verifier_enc") @db.Text
  returnTo        String   @default("") @map("return_to")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("calendar_oauth_states")
}

/// Calendar state of a LeadBooking. No booking is ever CONFIRMED without a real provider event.
model CalendarBookingSync {
  id              String    @id @default(cuid())
  bookingId       String    @unique @map("booking_id")
  scopeKey        String    @map("scope_key")
  provider        String?
  /// CONFIRMED | PENDING_MANUAL_CONFIRMATION | CANCELLED
  status          String    @default("PENDING_MANUAL_CONFIRMATION")
  externalEventId String?   @map("external_event_id")
  startsAt        DateTime  @map("starts_at")
  endsAt          DateTime  @map("ends_at")
  retryCreate     Boolean   @default(false) @map("retry_create")
  attempts        Int       @default(0)
  lastError       String?   @map("last_error") @db.Text
  lastSyncedAt    DateTime? @map("last_synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([scopeKey, status])
  @@index([retryCreate, status])
  @@map("calendar_booking_syncs")
}

// -----------------------------------------------------------------------------
// AI Meeting Scheduling and Coordination. scopeType PLATFORM | PROJECT, scopeId = "PLATFORM" or projectId.
// -----------------------------------------------------------------------------

/// Admin-configurable meeting template.
model MeetingType {
  id                   String   @id @default(cuid())
  scopeType            String   @default("PLATFORM") @map("scope_type")
  scopeId              String   @default("PLATFORM") @map("scope_id")
  key                  String
  name                 String
  /// USER | INVESTOR | CUSTOMER | BUSINESS | INTERNAL
  category             String   @default("CUSTOMER")
  durationMin          Int      @default(30) @map("duration_min")
  bufferBeforeMin      Int      @default(0) @map("buffer_before_min")
  bufferAfterMin       Int      @default(10) @map("buffer_after_min")
  /// GOOGLE_MEET | TEAMS | ZOOM | PHONE | IN_PERSON | MANUAL_LINK
  locationKind         String   @default("MANUAL_LINK") @map("location_kind")
  requiredParticipants Int      @default(1) @map("required_participants")
  workingHours         Json?    @map("working_hours")
  timeZone             String   @default("UTC") @map("time_zone")
  minNoticeMin         Int      @default(240) @map("min_notice_min")
  reminderOffsetsMin   Int[]    @map("reminder_offsets_min")
  requiresApproval     Boolean  @default(true) @map("requires_approval")
  /// Owner explicitly authorises the agent to book this routine type once the participant agreed.
  autonomousBooking    Boolean  @default(false) @map("autonomous_booking")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([scopeType, scopeId, key])
  @@map("meeting_types")
}

model Meeting {
  id               String    @id @default(cuid())
  scopeType        String    @default("PLATFORM") @map("scope_type")
  scopeId          String    @default("PLATFORM") @map("scope_id")
  typeId           String?   @map("type_id")
  title            String
  /// REQUESTED | PROPOSED | AWAITING_CONFIRMATION | CONFIRMED | RESCHEDULED | CANCELLED | COMPLETED | MISSED | FAILED
  status           String    @default("REQUESTED")
  category         String    @default("CUSTOMER")
  startsAt         DateTime? @map("starts_at")
  endsAt           DateTime? @map("ends_at")
  durationMin      Int       @default(30) @map("duration_min")
  timeZone         String    @default("UTC") @map("time_zone")
  hostUserId       String?   @map("host_user_id")
  assigneeId       String?   @map("assignee_id")
  /// [{ name, email, phone, timeZone, role, userId }]
  participants     Json      @default("[]")
  agenda           String    @default("") @db.Text
  /// LEAD | INVESTOR | SUPPORT_TICKET | PROJECT | USER_REQUEST | MANUAL
  sourceType       String    @default("MANUAL") @map("source_type")
  sourceId         String?   @map("source_id")
  requestedById    String?   @map("requested_by_id")
  requestedByAgent Boolean   @default(false) @map("requested_by_agent")
  locationKind     String    @default("MANUAL_LINK") @map("location_kind")
  locationText     String?   @map("location_text")
  conferenceProvider String? @map("conference_provider")
  conferenceUrl    String?   @map("conference_url") @db.Text
  conferenceId     String?   @map("conference_id")
  calendarProvider String?   @map("calendar_provider")
  externalEventId  String?   @map("external_event_id")
  idempotencyKey   String    @unique @map("idempotency_key")
  /// Private to staff with meetings:notes; never rendered to participants.
  internalNotes    String?   @map("internal_notes") @db.Text
  transcriptConsent Boolean  @default(false) @map("transcript_consent")
  transcript       String?   @db.Text
  outcome          String?   @db.Text
  nextSteps        Json?     @map("next_steps")
  summary          String?   @db.Text
  /// Bumped on every change so older signed links stop working.
  tokenVersion     Int       @default(1) @map("token_version")
  failureReason    String?   @map("failure_reason") @db.Text
  confirmedAt      DateTime? @map("confirmed_at")
  cancelledAt      DateTime? @map("cancelled_at")
  cancelReason     String?   @map("cancel_reason")
  notesPurgedAt    DateTime? @map("notes_purged_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([scopeType, scopeId, status, startsAt])
  @@index([sourceType, sourceId])
  @@index([startsAt])
  @@map("meetings")
}

model MeetingSlotProposal {
  id         String   @id @default(cuid())
  meetingId  String   @map("meeting_id")
  startsAt   DateTime @map("starts_at")
  endsAt     DateTime @map("ends_at")
  /// PROPOSED | ACCEPTED | DECLINED | EXPIRED
  status     String   @default("PROPOSED")
  proposedBy String   @default("system") @map("proposed_by")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([meetingId, startsAt])
  @@index([meetingId, status])
  @@map("meeting_slot_proposals")
}

/// Backstop against double booking: one row per active meeting, unique per host and start.
model MeetingSlotLock {
  id          String   @id @default(cuid())
  meetingId   String   @unique @map("meeting_id")
  resourceKey String   @map("resource_key")
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([resourceKey, startsAt])
  @@index([resourceKey, endsAt])
  @@map("meeting_slot_locks")
}

model MeetingReminder {
  id        String    @id @default(cuid())
  meetingId String    @map("meeting_id")
  offsetMin Int       @map("offset_min")
  /// EMAIL | WHATSAPP | SMS | IN_APP
  channel   String    @default("EMAIL")
  dueAt     DateTime  @map("due_at")
  /// PENDING | SENT | FAILED | SKIPPED
  status    String    @default("PENDING")
  attempts  Int       @default(0)
  lastError String?   @map("last_error") @db.Text
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([meetingId, offsetMin, channel])
  @@index([status, dueAt])
  @@map("meeting_reminders")
}

model MeetingAudit {
  id        String   @id @default(cuid())
  meetingId String   @map("meeting_id")
  actor     String
  action    String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([meetingId, createdAt])
  @@map("meeting_audits")
}

/// In-app notification for staff or a signed-in user.
model MeetingNotification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  meetingId String    @map("meeting_id")
  title     String
  body      String    @default("") @db.Text
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("meeting_notifications")
}

/// Manual availability when no calendar is connected: weekly hours plus blocked ranges. resourceKey = scope or "user:<id>".
model MeetingAvailabilityRule {
  id           String   @id @default(cuid())
  resourceKey  String   @unique @map("resource_key")
  timeZone     String   @default("UTC") @map("time_zone")
  workingHours Json?    @map("working_hours")
  /// [{ start, end }] ISO instants; reasons are never stored.
  blocked      Json     @default("[]")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("meeting_availability_rules")
}

/// Per-scope retention and conference-provider verification.
model MeetingSettings {
  id            String   @id @default(cuid())
  scopeKey      String   @unique @map("scope_key")
  /// Notes/transcripts older than this (after the meeting) are purged; null keeps them until deleted manually.
  retentionDays Int?     @map("retention_days")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("meeting_settings")
}

/// Live verification of a conference provider (ZOOM; MEET/TEAMS follow the calendar connection).
model MeetingProviderStatus {
  provider    String    @id
  verifiedAt  DateTime? @map("verified_at")
  fingerprint String    @default("")
  lastError   String?   @map("last_error") @db.Text
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("meeting_provider_status")
}
