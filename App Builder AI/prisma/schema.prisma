// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tables

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
  ANALYTICS_VIEWER
  SECURITY_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
  BANNED
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  /// Public handle shown in URLs, e.g. @username
  username      String?  @unique
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  subscriptionStatus   String? @map("subscription_status")
  subscriptionPlan     String  @default("free") @map("subscription_plan")

  /// Current Stripe billing period end (renewal/expiry date) for the active
  /// subscription, kept in sync from Stripe webhooks.
  subscriptionCurrentPeriodEnd DateTime? @map("subscription_current_period_end")

  /// Timestamps used to avoid re-sending the same billing alert email
  /// repeatedly. Cleared automatically once the underlying condition
  /// resolves (credits topped up / subscription renews into a new period).
  lowCreditsAlertSentAt     DateTime? @map("low_credits_alert_sent_at")
  renewalReminderSentForEnd DateTime? @map("renewal_reminder_sent_for_end")

  /// Admin Console: null means the user has no administrative access.
  adminRole AdminRole? @map("admin_role")

  accountStatus     AccountStatus @default(ACTIVE) @map("account_status")
  statusReason      String?       @map("status_reason") @db.Text
  statusChangedAt   DateTime?     @map("status_changed_at")
  statusChangedById String?       @map("status_changed_by_id")
  bannedAt          DateTime?     @map("banned_at")
  banExpiresAt      DateTime?     @map("ban_expires_at")

  /// AI usage credit balance available to the user (Admin Console: ADM-025).
  creditBalance Int @default(0) @map("credit_balance")

  accounts Account[]
  sessions Session[]

  ownedWorkspaces             Workspace[]             @relation("WorkspaceOwner")
  workspaceMemberships        WorkspaceMember[]
  createdProjects             Project[]               @relation("ProjectCreator")
  projectMemberships          ProjectMember[]
  projectPreferences          UserProjectPreference[]
  workspaceInvitesSent        WorkspaceInvitation[]   @relation("WorkspaceInviter")
  projectInvitesSent          ProjectInvitation[]     @relation("ProjectInviter")
  agentConversations          AgentConversation[]
  deploymentsCreated          Deployment[]            @relation("DeploymentCreator")
  projectCheckpointsCreated   ProjectCheckpoint[]     @relation("ProjectCheckpointCreator")
  projectGithubLinksConnected ProjectGithubLink[]     @relation("ProjectGithubLinkConnector")
  githubConnection            UserGithubConnection?
  settings                    UserSettings?

  aiUsageEvents          AiUsageEvent[]
  creditAdjustments      CreditAdjustment[] @relation("CreditAdjustmentTarget")
  flags                  UserFlag[]         @relation("FlaggedUser")
  ssoProvidersRegistered SsoProvider[]

  cliDeviceAuthorizations CliDeviceAuthorization[]
  cliTokens               CliToken[]
  savedSections           UserSavedSection[]
  brandKitDefault         UserBrandKit?
  savedPages              UserSavedPage[]
  templateFavorites       UserTemplateFavorite[]

  @@index([adminRole])
  @@index([accountStatus])
  @@map("users")
}

enum DefaultStartPage {
  HOME
  PROJECTS
}

model UserSettings {
  id                 String           @id @default(cuid())
  userId             String           @unique @map("user_id")
  emailNotifications Boolean          @default(true) @map("email_notifications")
  productUpdates     Boolean          @default(true) @map("product_updates")
  defaultStartPage   DefaultStartPage @default(HOME) @map("default_start_page")
  showShortcuts      Boolean          @default(true) @map("show_shortcuts")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Stores a user's personal-access-token connection to their own GitHub
/// account, used for the "Export to GitHub" feature (create/push a repo for
/// a project). The token is encrypted at rest with lib/crypto/secret-box.ts.
model UserGithubConnection {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  githubUsername       String   @map("github_username")
  encryptedAccessToken String   @map("encrypted_access_token") @db.Text
  scopes               String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_github_connections")
}

enum CliDeviceAuthorizationStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

/// OAuth-style device authorization grant (RFC 8628) used by the AppWeaverAI
/// CLI to sign in: the CLI requests a device_code/user_code pair here, the
/// user approves the user_code on the web, and the CLI then exchanges the
/// device_code for a CliToken. Rows are single-use once consumed/expired.
model CliDeviceAuthorization {
  id         String                       @id @default(cuid())
  deviceCode String                       @unique @map("device_code")
  userCode   String                       @unique @map("user_code")
  status     CliDeviceAuthorizationStatus @default(PENDING)
  userId     String?                      @map("user_id")
  clientName String?                      @map("client_name")
  interval   Int                          @default(5)
  expiresAt  DateTime                     @map("expires_at")
  createdAt  DateTime                     @default(now()) @map("created_at")
  updatedAt  DateTime                     @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("cli_device_authorizations")
}

/// Long-lived CLI access tokens. Only a salted hash of the token is ever
/// stored (see lib/crypto/token-hash.ts) since the CLI only needs equality
/// verification, not retrieval of the plaintext.
model CliToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  name       String?
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cli_tokens")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token") @db.Text
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model StripeEvent {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stripe_events")
}

/// Enterprise SSO/SAML connections, managed by the @better-auth/sso plugin
/// (see lib/auth.ts). Registration is gated to internal Admin Console staff
/// (see lib/admin/actions/sso.ts) rather than exposed for customer
/// self-service, since Enterprise SSO onboarding is handled through our
/// sales/support process.
model SsoProvider {
  id             String   @id @default(cuid())
  issuer         String
  oidcConfig     String?  @db.Text
  samlConfig     String?  @db.Text
  userId         String?  @map("user_id")
  providerId     String   @unique @map("provider_id")
  organizationId String?  @map("organization_id")
  domain         String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([domain])
  @@map("sso_providers")
}

enum AuthReminderKind {
  SIGNUP
  PASSWORD_RESET
}

/// Tracks an in-progress signup (email verification) or password-reset
/// attempt so we can nudge the user with a reminder email if they never
/// finish within 30 minutes. Resolved automatically once the user
/// verifies their email / resets their password / signs in successfully.
model PendingAuthReminder {
  id             String           @id @default(cuid())
  email          String
  kind           AuthReminderKind
  createdAt      DateTime         @default(now()) @map("created_at")
  /// When the reminder email should go out (createdAt + 30 minutes),
  /// refreshed each time the user re-requests a code for the same flow.
  remindAfter    DateTime         @map("remind_after")
  reminderSentAt DateTime?        @map("reminder_sent_at")
  resolvedAt     DateTime?        @map("resolved_at")

  @@index([kind, remindAfter, reminderSentAt, resolvedAt])
  @@index([email, kind])
  @@map("pending_auth_reminders")
}

// -----------------------------------------------------------------------------
// Workspaces — personal (solo) or team (shared access to all projects)
// -----------------------------------------------------------------------------

enum WorkspaceType {
  PERSONAL
  TEAM
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  GUEST
  VIEWER
}

model Workspace {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  type      WorkspaceType @default(PERSONAL)
  /// Owner of a personal workspace; billing admin for team workspaces.
  ownerId   String        @map("owner_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  projects    Project[]

  @@index([ownerId])
  @@index([type])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  invitedById String        @map("invited_by_id")
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@map("workspace_invitations")
}

// -----------------------------------------------------------------------------
// Projects — container for code, data, artifacts, and shared resources
// -----------------------------------------------------------------------------

enum ProjectAdminStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Project {
  id                     String                   @id @default(cuid())
  reviews                ProjectReview[]
  scanRuns               ScanRun[]
  integrationConnections IntegrationConnection[]
  integrationApiLogs     IntegrationApiLog[]
  inboundWebhooks        InboundWebhookEndpoint[]
  webhookSubscriptions   WebhookSubscription[]
  scanSchedule           ScanSchedule?
  changeApprovals        ChangeApproval[]
  bugDiagnoses           BugDiagnosis[]
  reviewSettings         ProjectReviewSettings?
  knowledgeDocs          ProjectKnowledge[]
  supportTickets         ProjectSupportTicket[]
  workspaceId            String                   @map("workspace_id")
  name                   String
  slug                   String
  description            String?                  @db.Text
  iconUrl                String?                  @map("icon_url")
  createdById            String                   @map("created_by_id")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  deletedAt              DateTime?                @map("deleted_at")

  /// Admin Console lifecycle controls (ADM-073, ADM-074).
  adminStatus     ProjectAdminStatus @default(ACTIVE) @map("admin_status")
  suspendedReason String?            @map("suspended_reason") @db.Text
  suspendedAt     DateTime?          @map("suspended_at")
  suspendedById   String?            @map("suspended_by_id")
  archivedAt      DateTime?          @map("archived_at")

  /// Set when this project was created via the "Remix" action from a
  /// publicly-published project. Used to show remix counts in the gallery
  /// (Replit/Lovable-style community discovery).
  remixedFromProjectId String? @map("remixed_from_project_id")

  /// SEO metadata surfaced for the published site: <title>/<meta
  /// description>, the Open Graph/Twitter share image, and a custom
  /// favicon. All optional — falls back to the project name when unset.
  seoTitle          String? @map("seo_title")
  seoDescription    String? @map("seo_description") @db.Text
  seoImageUrl       String? @map("seo_image_url")
  faviconUrl        String? @map("favicon_url")
  /// Where form-submission emails go; falls back to the project owner.
  notificationEmail String? @map("notification_email")

  workspace         Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy         User                      @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members           ProjectMember[]
  invitations       ProjectInvitation[]
  preferences       UserProjectPreference[]
  artifacts         Artifact[]
  files             ProjectFile[]
  databases         ProjectDatabase[]
  storage           ProjectStorage?
  githubLink        ProjectGithubLink?
  githubSyncedFiles ProjectGithubSyncedFile[]
  customDomain      ProjectCustomDomain?
  secrets           ProjectSecret[]
  deployments       Deployment[]
  launchReports     LaunchReport[]
  checkpoints       ProjectCheckpoint[]
  conversations     AgentConversation[]
  agentToolCalls    AgentToolCall[]
  aiUsageEvents     AiUsageEvent[]
  flags             ProjectFlag[]
  pageViews         ProjectPageView[]
  brandKit          ProjectBrandKit?
  formSubmissions   ProjectFormSubmission[]
  leads             Lead[]
  leadSlots         LeadAvailabilitySlot[]
  growthExperiments GrowthExperiment[]
  memories          ProjectMemory[]
  codeMapEntries    ProjectCodeMapEntry[]
  memoryInjections  ProjectMemoryInjection[]
  remixedFrom       Project?                  @relation("ProjectRemixes", fields: [remixedFromProjectId], references: [id], onDelete: SetNull)
  remixes           Project[]                 @relation("ProjectRemixes")

  @@unique([workspaceId, slug])
  @@index([remixedFromProjectId])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, deletedAt])
  @@index([createdById])
  @@index([adminStatus])
  @@map("projects")
}

enum ProjectRole {
  OWNER
  PUBLISHER
  EDITOR
  VIEWER
}

/// Project-level access for guests and explicit grants (common in personal workspaces).
model ProjectMember {
  id        String      @id @default(cuid())
  projectId String      @map("project_id")
  userId    String      @map("user_id")
  role      ProjectRole @default(EDITOR)
  joinedAt  DateTime    @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectInvitation {
  id          String      @id @default(cuid())
  projectId   String      @map("project_id")
  email       String
  role        ProjectRole @default(EDITOR)
  token       String      @unique
  invitedById String      @map("invited_by_id")
  expiresAt   DateTime    @map("expires_at")
  acceptedAt  DateTime?   @map("accepted_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("ProjectInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([projectId, email])
  @@map("project_invitations")
}

/// Per-user project UI state: pins and recency ("last opened by you").
model UserProjectPreference {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  projectId            String    @map("project_id")
  isPinned             Boolean   @default(false) @map("is_pinned")
  lastOpenedAt         DateTime? @map("last_opened_at")
  /// Last artifact tab the user had open in the project editor.
  lastActiveArtifactId String?   @map("last_active_artifact_id")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId, lastOpenedAt])
  @@index([userId, isPinned])
  @@map("user_project_preferences")
}

// -----------------------------------------------------------------------------
// Artifacts — publishable outputs inside a project (max 7 per project in app logic)
// -----------------------------------------------------------------------------

enum ArtifactType {
  WEB_APP
  MOBILE_APP
  DATA_VIZ
  SLIDES
  ANIMATION
  GAME_3D
  DESIGN
  AGENT_AUTOMATION
}

enum ArtifactStatus {
  DRAFT
  READY
}

model Artifact {
  id              String         @id @default(cuid())
  projectId       String         @map("project_id")
  type            ArtifactType
  name            String
  slug            String
  status          ArtifactStatus @default(DRAFT)
  previewImageUrl String?        @map("preview_image_url")
  /// Live URL after the project is published (artifacts share one deployment).
  publishedUrl    String?        @map("published_url")
  sortOrder       Int            @default(0) @map("sort_order")
  /// When set, this artifact is a plain-code program in this language
  /// (e.g. "python", "java", "go") run via a sandboxed Docker container
  /// instead of the browser iframe preview used for web stacks. See
  /// lib/code-run/languages.ts for the supported id list.
  codingLanguage  String?        @map("coding_language")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files   ProjectFile[]

  @@unique([projectId, slug])
  @@index([projectId, sortOrder])
  @@map("artifacts")
}

// -----------------------------------------------------------------------------
// Project resources — shared by all artifacts in a project
// -----------------------------------------------------------------------------

enum ResourceEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum DatabaseProvider {
  NEON
  POSTGRES
}

/// Metadata for the managed Postgres database attached to a project.
/// Connection secrets are stored in ProjectSecret, not in plain text here.
model ProjectDatabase {
  id           String              @id @default(cuid())
  projectId    String              @map("project_id")
  environment  ResourceEnvironment @default(DEVELOPMENT)
  provider     DatabaseProvider    @default(NEON)
  databaseName String              @map("database_name")
  host         String?
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, environment])
  @@map("project_databases")
}

enum StorageProvider {
  S3
  R2
  GCS
}

/// Object storage bucket for unstructured files (images, uploads, exports).
model ProjectStorage {
  id         String          @id @default(cuid())
  projectId  String          @unique @map("project_id")
  provider   StorageProvider @default(R2)
  bucketName String          @map("bucket_name")
  region     String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_storages")
}

/// Tracks a project's linked GitHub repository for export/sync (ADM-parity with
/// Lovable/Replit "Export to GitHub"). One project links to at most one repo.
model ProjectGithubLink {
  id                  String    @id @default(cuid())
  projectId           String    @unique @map("project_id")
  repoOwner           String    @map("repo_owner")
  repoName            String    @map("repo_name")
  repoFullName        String    @map("repo_full_name")
  defaultBranch       String    @default("main") @map("default_branch")
  htmlUrl             String    @map("html_url")
  private             Boolean   @default(true)
  connectedById       String    @map("connected_by_id")
  /// Git commit SHA of the last successful import or push, used to detect
  /// whether the remote branch has moved since (fast-forward safety check).
  lastSyncedCommitSha String?   @map("last_synced_commit_sha")
  lastSyncedAt        DateTime? @map("last_synced_at")
  lastSyncedById      String?   @map("last_synced_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectedBy User    @relation("ProjectGithubLinkConnector", fields: [connectedById], references: [id], onDelete: Restrict)

  @@map("project_github_links")
}

/// Tracks the git blob SHA of each file as of the last successful GitHub
/// import/push, so the next push can diff current project files against
/// this snapshot and commit only what actually changed (incremental sync)
/// instead of force-overwriting the whole branch.
model ProjectGithubSyncedFile {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  path      String
  blobSha   String   @map("blob_sha")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@map("project_github_synced_files")
}

/// A verified custom domain pointing at a project's published deployment.
/// Verified via a DNS TXT record; once verified, requests to `domain` are
/// rewritten (see middleware.ts) to the project's published path.
model ProjectCustomDomain {
  id                String    @id @default(cuid())
  projectId         String    @unique @map("project_id")
  domain            String    @unique
  verificationToken String    @map("verification_token")
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_custom_domains")
}

/// Editor and deployment secrets (API keys, DATABASE_URL for user apps, etc.).
model ProjectSecret {
  id          String              @id @default(cuid())
  projectId   String              @map("project_id")
  key         String
  /// Encrypted at the application layer before persistence.
  value       String              @db.Text
  environment ResourceEnvironment @default(DEVELOPMENT)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, environment, key])
  @@map("project_secrets")
}

/// Source file metadata. File bytes live in object storage (ProjectStorage).
model ProjectFile {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  artifactId String?  @map("artifact_id")
  path       String
  storageKey String   @map("storage_key")
  mimeType   String?  @map("mime_type")
  sizeBytes  Int      @default(0) @map("size_bytes")
  checksum   String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifact Artifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@unique([projectId, path])
  @@index([projectId, updatedAt])
  @@index([artifactId])
  @@map("project_files")
}

// -----------------------------------------------------------------------------
// Version history — lightweight file snapshots so agent-driven changes can be
// rolled back (an automatic checkpoint is taken after every agent turn that
// writes files, plus users can save a named checkpoint manually).
// -----------------------------------------------------------------------------

model ProjectCheckpoint {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  label       String
  description String?  @db.Text
  /// false for user-triggered "Save checkpoint" — these are never
  /// auto-pruned, unlike automatic post-turn snapshots.
  isAutomatic Boolean  @default(true) @map("is_automatic")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project   Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?                   @relation("ProjectCheckpointCreator", fields: [createdById], references: [id], onDelete: SetNull)
  files     ProjectCheckpointFile[]

  @@index([projectId, createdAt])
  @@index([projectId, isAutomatic, createdAt])
  @@map("project_checkpoints")
}

/// Records which files (and sizes) existed at snapshot time. The actual
/// bytes are copied on disk under project-workspace/{projectId}/.checkpoints/{id}/.
model ProjectCheckpointFile {
  id           String  @id @default(cuid())
  checkpointId String  @map("checkpoint_id")
  path         String
  mimeType     String? @map("mime_type")
  sizeBytes    Int     @default(0) @map("size_bytes")

  checkpoint ProjectCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@unique([checkpointId, path])
  @@index([checkpointId])
  @@map("project_checkpoint_files")
}

// -----------------------------------------------------------------------------
// Website template & section library — curated starting points users can
// launch a new project from (full templates) or insert into an existing
// artifact (sections). Content is stored as text in the DB and copied onto
// disk (same layout the AI agent writes to) when used.
// -----------------------------------------------------------------------------

enum TemplateKind {
  /// A full starter website (index.html + styles.css + script.js).
  FULL_TEMPLATE
  /// A single reusable block (hero, pricing, testimonials, footer, etc.)
  /// meant to be inserted into an existing artifact.
  SECTION
}

enum TemplateMarket {
  FREELANCER
  SMALL_BUSINESS
  AGENCY
  SAAS
  GENERAL
}

model WebsiteTemplate {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  description     String?        @db.Text
  kind            TemplateKind
  market          TemplateMarket @default(GENERAL)
  previewImageUrl String?        @map("preview_image_url")
  sortOrder       Int            @default(0) @map("sort_order")
  isPublished     Boolean        @default(true) @map("is_published")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  files     WebsiteTemplateFile[]
  favorites UserTemplateFavorite[]

  @@index([kind, market, sortOrder])
  @@index([isPublished])
  @@map("website_templates")
}

/// Relative paths mirror the artifact file layout (index.html, styles.css,
/// script.js). For SECTION templates, path is a fixed virtual name
/// ("section.html") since sections are inserted rather than copied wholesale.
model WebsiteTemplateFile {
  id         String @id @default(cuid())
  templateId String @map("template_id")
  path       String
  content    String @db.Text

  template WebsiteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, path])
  @@map("website_template_files")
}

/// Account-level brand kit: new websites start with these values.
model UserBrandKit {
  userId         String   @id @map("user_id")
  logoUrl        String?  @map("logo_url")
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  accentColor    String?  @map("accent_color")
  fontFamily     String?  @map("font_family")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_brand_kits")
}

/// A section a user saved from one of their websites ("Save as Template",
/// Flow 5). `html` is the section's self-contained outerHTML.
model UserSavedSection {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  html      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_saved_sections")
}

/// A whole page (index.html + assets) saved as a personal template.
/// `files` is an array of { path, content } text files.
model UserSavedPage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  files     Json
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_saved_pages")
}

/// Starred built-in templates/sections for quick access.
model UserTemplateFavorite {
  userId     String   @map("user_id")
  templateId String   @map("template_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template WebsiteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([userId, templateId])
  @@map("user_template_favorites")
}

// -----------------------------------------------------------------------------
// Brand kit — logo/colors/font saved per project. Applied to the live site as
// a block of CSS custom properties written into the main artifact's
// stylesheet, so it has an immediate, visible effect without requiring the
// user (or agent) to manually restyle every element.
// -----------------------------------------------------------------------------

model ProjectBrandKit {
  id             String   @id @default(cuid())
  projectId      String   @unique @map("project_id")
  logoUrl        String?  @map("logo_url")
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  accentColor    String?  @map("accent_color")
  fontFamily     String?  @map("font_family")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_brand_kits")
}

// -----------------------------------------------------------------------------
// Form submissions — lets static-HTML contact/lead forms (e.g. the seeded
// "Contact Form" section) actually deliver messages somewhere. The preview
// runtime posts submissions to a public API route; the project owner reads
// them from the editor's Forms panel.
// -----------------------------------------------------------------------------

model ProjectFormSubmission {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  formName  String   @map("form_name")
  data      Json
  visitorId String?  @map("visitor_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_form_submissions")
}

// -----------------------------------------------------------------------------
// Deployments — publishing is project-wide; all artifacts go live together
// -----------------------------------------------------------------------------

enum DeploymentType {
  AUTOSCALE
  RESERVED_VM
  STATIC
  SCHEDULED
}

enum DeploymentVisibility {
  PUBLIC
  WORKSPACE_ONLY
  PRIVATE
}

enum DeploymentStatus {
  PENDING
  PROVISIONING
  BUILDING
  BUNDLING
  PROMOTING
  LIVE
  FAILED
  SUPERSEDED
}

model Deployment {
  id                  String                @id @default(cuid())
  projectId           String                @map("project_id")
  version             Int
  status              DeploymentStatus      @default(PENDING)
  deploymentType      DeploymentType        @default(AUTOSCALE) @map("deployment_type")
  visibility          DeploymentVisibility  @default(PUBLIC)
  /// Default subdomain, e.g. my-app.appweaverai.app
  domain              String
  customDomain        String?               @map("custom_domain")
  /// `isCurrent` marks the live PRODUCTION deployment only (staging rows never
  /// set it, so existing production queries stay correct). The live STAGING
  /// deployment is the one STAGING row with status LIVE; the migration enforces
  /// at most one current row per environment with partial unique indexes.
  isCurrent           Boolean               @default(false) @map("is_current")
  environment         DeploymentEnvironment @default(PRODUCTION)
  /// Random share token gating a STAGING deployment (null = open link).
  accessToken         String?               @map("access_token")
  /// Set on a PRODUCTION deployment created by promoting a staging version.
  promotedFromVersion Int?                  @map("promoted_from_version")
  createdById         String                @map("created_by_id")
  publishedAt         DateTime?             @map("published_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("DeploymentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, version])
  @@index([projectId, isCurrent])
  @@index([projectId, environment, status])
  @@index([domain])
  @@map("deployments")
}

/// One row per anonymous visit to a published project's public URL
/// (app/p/[workspaceSlug]/[projectSlug]). Powers the owner-facing public
/// analytics dashboard (page views, unique visitors, referrers, top paths).
/// `visitorId` is a daily-rotating hash (never the raw IP/UA), so it's only
/// good for a rough "unique visitors today/this week" count, not persistent
/// cross-session tracking.
model ProjectPageView {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  path      String
  referrer  String?
  /// UTM parameters of the landing URL (source/medium/campaign/content), when present.
  utm       Json?
  visitorId String   @map("visitor_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_page_views")
}

// -----------------------------------------------------------------------------
// Agent — conversations tied to a project (AppWeaver AI Agent)
// -----------------------------------------------------------------------------

enum AgentMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AgentConversation {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AgentMessage[]
  toolCalls AgentToolCall[]

  @@index([projectId, updatedAt])
  @@index([userId])
  @@map("agent_conversations")
}

enum AgentToolRiskLevel {
  /// Read-only or purely informational; always auto-executed.
  SAFE
  /// Mutates project files but is easily reversible via checkpoints;
  /// auto-executed and logged.
  REVIEW
  /// Destructive or hard-to-reverse (deletes, running commands, force
  /// pushes, etc.); requires explicit user approval before executing.
  DESTRUCTIVE
}

enum AgentToolCallStatus {
  /// Awaiting the user's approve/deny decision (DESTRUCTIVE tools only).
  PENDING
  APPROVED
  DENIED
  /// Ran successfully (immediately, for SAFE/REVIEW tools, or after approval).
  EXECUTED
  FAILED
}

/// Persisted audit trail + approval gate for every tool call the coding
/// agent makes. DESTRUCTIVE tool calls are created with status PENDING and
/// the agent loop blocks on them until a human decides via the
/// /api/agent/tool-calls/[id]/decision route; SAFE/REVIEW tool calls are
/// recorded for audit purposes immediately after they execute.
model AgentToolCall {
  id             String              @id @default(cuid())
  conversationId String              @map("conversation_id")
  projectId      String              @map("project_id")
  toolName       String              @map("tool_name")
  input          Json
  riskLevel      AgentToolRiskLevel  @map("risk_level")
  status         AgentToolCallStatus @default(PENDING)
  result         String?             @db.Text
  decidedById    String?             @map("decided_by_id")
  decidedAt      DateTime?           @map("decided_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([projectId])
  @@map("agent_tool_calls")
}

model AgentMessage {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  role           AgentMessageRole
  content        String           @db.Text
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

// -----------------------------------------------------------------------------
// Admin Console — audit, security, AI cost telemetry, and governance
// docs/ADMIN_CONSOLE_BACKLOG.md (EPIC 1, 7, 10, 12)
// -----------------------------------------------------------------------------

enum AuditResult {
  SUCCESS
  FAILURE
}

/// Immutable record of every privileged admin action (ADM-005). Never updated
/// or deleted through normal admin APIs.
model AdminAuditLog {
  id            String      @id @default(cuid())
  adminId       String?     @map("admin_id")
  adminEmail    String?     @map("admin_email")
  action        String
  targetType    String      @map("target_type")
  targetId      String?     @map("target_id")
  before        Json?
  after         Json?
  result        AuditResult @default(SUCCESS)
  reason        String?     @db.Text
  correlationId String      @map("correlation_id")
  ipAddress     String?     @map("ip_address")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}

enum SecurityEventType {
  LOGIN_FAILURE
  LOGIN_SUCCESS
  LOGOUT
  EMAIL_VERIFIED
  BRUTE_FORCE_SUSPECTED
  UNUSUAL_ACCESS
  RATE_LIMIT_VIOLATION
  ACCOUNT_BANNED
  ACCOUNT_SUSPENDED
  PAYMENT_ANOMALY
  ABUSE_SIGNAL
  OTHER
}

enum SecurityEventSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

/// Common security event model (ADM-091) for authentication, abuse, and
/// payment-related signals.
model SecurityEvent {
  id          String                @id @default(cuid())
  type        SecurityEventType
  severity    SecurityEventSeverity @default(INFO)
  subjectType String                @map("subject_type")
  subjectId   String?               @map("subject_id")
  message     String                @db.Text
  metadata    Json?
  ipAddress   String?               @map("ip_address")
  createdAt   DateTime              @default(now()) @map("created_at")

  @@index([severity, createdAt])
  @@index([type, createdAt])
  @@index([subjectType, subjectId])
  @@map("security_events")
}

enum FeedbackStatus {
  NEW
  READ
  RESOLVED
}

/// Star-rating product review left by a signed-in customer after using the
/// app (no admin FK relation, mirroring AdminAuditLog/SecurityEvent — kept
/// intentionally decoupled from User so a deleted account never blocks
/// reading historical feedback).
model ProductReview {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  userEmail String?  @map("user_email")
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@map("product_reviews")
}

/// Free-form message sent to the company from inside the app (e.g. a
/// "Send feedback" widget). Reviewed by admins in the Admin Console, who
/// may reply — the response is shown back to the user in the same widget.
model FeedbackMessage {
  id                 String         @id @default(cuid())
  userId             String?        @map("user_id")
  userEmail          String?        @map("user_email")
  message            String         @db.Text
  status             FeedbackStatus @default(NEW)
  response           String?        @db.Text
  respondedAt        DateTime?      @map("responded_at")
  respondedBy        String?        @map("responded_by")
  /// Human-readable name of the detected language of `message` (e.g. "Spanish").
  /// Null/omitted when the message is already in English.
  language           String?        @map("language")
  /// Auto-translated English version of `message`, shown to admins when
  /// `language` isn't English.
  translatedMessage  String?        @map("translated_message") @db.Text
  /// Auto-translated version of `response` in the user's original
  /// `language`, shown/emailed back to the user instead of the English reply.
  translatedResponse String?        @map("translated_response") @db.Text
  createdAt          DateTime       @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@map("feedback_messages")
}

enum AiUsageStatus {
  SUCCESS
  FAILURE
}

/// Per-request AI telemetry (ADM-060). Prompt content is intentionally not
/// stored here.
model AiUsageEvent {
  id                 String        @id @default(cuid())
  userId             String?       @map("user_id")
  projectId          String?       @map("project_id")
  provider           String
  model              String
  inputTokens        Int           @default(0) @map("input_tokens")
  outputTokens       Int           @default(0) @map("output_tokens")
  estimatedCostCents Int           @default(0) @map("estimated_cost_cents")
  latencyMs          Int?          @map("latency_ms")
  status             AiUsageStatus @default(SUCCESS)
  errorCategory      String?       @map("error_category")
  createdAt          DateTime      @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([provider, model, createdAt])
  @@map("ai_usage_events")
}

/// Manual credit grants/resets by support staff (ADM-025).
model CreditAdjustment {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  amount    Int
  reason    String   @db.Text
  adminId   String   @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation("CreditAdjustmentTarget", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_adjustments")
}

enum FlagStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum FlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Internal review flag on a user account (ADM-027).
model UserFlag {
  id           String       @id @default(cuid())
  userId       String       @map("user_id")
  reason       String       @db.Text
  severity     FlagSeverity @default(MEDIUM)
  status       FlagStatus   @default(OPEN)
  createdById  String       @map("created_by_id")
  reviewerNote String?      @map("reviewer_note") @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user User @relation("FlaggedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("user_flags")
}

/// Internal review flag on a project (ADM-075).
model ProjectFlag {
  id           String       @id @default(cuid())
  projectId    String       @map("project_id")
  reason       String       @db.Text
  severity     FlagSeverity @default(MEDIUM)
  status       FlagStatus   @default(OPEN)
  createdById  String       @map("created_by_id")
  reviewerNote String?      @map("reviewer_note") @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("project_flags")
}

/// Centralized, typed admin settings (ADM-110). Values are validated at the
/// application layer before being written here.
model AdminSetting {
  key         String   @id
  value       Json
  description String?  @db.Text
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("admin_settings")
}

// -----------------------------------------------------------------------------
// Social media — queue of marketing posts published daily by a cron job
// -----------------------------------------------------------------------------

enum SocialPostStatus {
  /// Awaiting human approval; never published until approved (-> PENDING).
  DRAFT
  PENDING
  POSTED
  FAILED
}

model SocialPost {
  id           String           @id @default(cuid())
  title        String
  /// Core marketing message; per-platform captions are derived from it.
  message      String
  /// Publicly reachable video URL (https, mp4). Optional for text-only posts.
  videoUrl     String?          @map("video_url")
  /// Subset of FACEBOOK, X, LINKEDIN. Empty means every configured platform.
  platforms    String[]
  status       SocialPostStatus @default(PENDING)
  scheduledFor DateTime         @default(now()) @map("scheduled_for")
  postedAt     DateTime?        @map("posted_at")
  attempts     Int              @default(0)
  /// Per-platform outcome: { FACEBOOK: { ok, id?, error? }, ... }
  results      Json?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([status, scheduledFor])
  @@map("social_posts")
}

// -----------------------------------------------------------------------------
// Social media — inbound comments/mentions/DMs from users and investors that the
// system classifies and answers (users auto-sent, investors held for approval)
// -----------------------------------------------------------------------------

enum SocialInteractionStatus {
  /// Ingested, waiting for the cron to classify and draft a reply.
  RECEIVED
  /// Claimed by a worker (drafting or sending); prevents double handling.
  PROCESSING
  /// Draft reply waiting for a human to approve, edit or reject it.
  PENDING_APPROVAL
  SENT
  SKIPPED
  FAILED
}

enum SocialAudience {
  USER
  INVESTOR
  /// Spam, abuse, bots or messages that need no reply.
  IGNORE
}

model SocialInteraction {
  id           String                  @id @default(cuid())
  /// X, LINKEDIN, FACEBOOK, INSTAGRAM, REDDIT, YOUTUBE or OTHER (generic webhook).
  platform     String
  /// Platform's own id for the message; unique per platform so retries are idempotent.
  externalId   String                  @map("external_id")
  /// Where to reply (parent post/comment/thread id), when the platform needs it.
  replyToId    String?                 @map("reply_to_id")
  authorHandle String                  @map("author_handle")
  authorName   String?                 @map("author_name")
  text         String
  status       SocialInteractionStatus @default(RECEIVED)
  audience     SocialAudience?
  /// Model's confidence (0-1) that the draft is correct and complete.
  confidence   Float?
  escalate     Boolean                 @default(false)
  reply        String?
  /// Why it was held, skipped or failed.
  note         String?
  attempts     Int                     @default(0)
  /// Outcome of the send: { ok, id?, error?, stubbed? }
  result       Json?
  repliedAt    DateTime?               @map("replied_at")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  @@unique([platform, externalId])
  @@index([status, createdAt])
  @@map("social_interactions")
}

// -----------------------------------------------------------------------------
// Investor outreach — leads found via web search, personalised email drafts that
// a human approves before sending, and a do-not-contact (suppression) list
// -----------------------------------------------------------------------------

enum InvestorLeadStatus {
  /// Found; no email draft yet, or no public email (usable as a call/manual list).
  DISCOVERED
  /// Email drafted; never sent until a human approves it.
  PENDING_APPROVAL
  /// Claimed by a sender; prevents double sends.
  SENDING
  SENT
  REJECTED
  DO_NOT_CONTACT
}

model InvestorLead {
  id            String             @id @default(cuid())
  name          String
  firm          String?
  /// Investment focus as stated on the source page.
  focus         String?
  sourceUrl     String             @map("source_url")
  /// Only addresses/numbers literally published on the source page are stored.
  email         String?            @unique
  phone         String?
  status        InvestorLeadStatus @default(DISCOVERED)
  subject       String?
  body          String?
  /// Short bullet points for a human to use on a call.
  talkingPoints String?            @map("talking_points")
  note          String?
  sentAt        DateTime?          @map("sent_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@unique([sourceUrl, name])
  @@index([status, createdAt])
  @@map("investor_leads")
}

model OutreachSuppression {
  /// Lowercased address that must never be emailed again.
  email     String   @id
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("outreach_suppressions")
}

// -----------------------------------------------------------------------------
// Paid advertising (Meta) — AI-written creatives, launched and optimised
// automatically, with sign-up / paid conversions attributed per creative
// -----------------------------------------------------------------------------
enum AdCreativeStatus {
  DRAFT
  ACTIVE
  PAUSED
  FAILED
}

model AdCreative {
  id          String           @id @default(cuid())
  headline    String
  primaryText String           @map("primary_text") @db.Text
  imagePrompt String           @map("image_prompt") @db.Text
  status      AdCreativeStatus @default(DRAFT)
  metaAdId    String?          @map("meta_ad_id")
  note        String?          @db.Text
  spendCents  Int              @default(0) @map("spend_cents")
  impressions Int              @default(0)
  clicks      Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@map("ad_creatives")
}

/// First-touch attribution captured from the aw_attr cookie at sign-up.
model AdAttribution {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  source    String?
  medium    String?
  campaign  String?
  /// utm_content: the AdCreative id for paid ads.
  content   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([content])
  @@map("ad_attributions")
}

/// Small key/value store, e.g. the Meta campaign and ad set ids.
model AdState {
  key   String @id
  value String

  @@map("ad_state")
}

/// Saved output of the Studio one-prompt launch (brand kit, ad pack, plan).
model LaunchKit {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  brief       String   @db.Text
  brand       String   @db.Text
  adPack      String   @map("ad_pack") @db.Text
  plan        String   @db.Text
  buildPrompt String   @map("build_prompt") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("launch_kits")
}

// -----------------------------------------------------------------------------
// Customer-run Meta ads — a customer connects their own Facebook account and
// launches AI-written ads, spending their own money under a per-user cap
// -----------------------------------------------------------------------------
model MetaAdConnection {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  /// Encrypted long-lived user access token.
  accessTokenEnc String    @map("access_token_enc") @db.Text
  tokenExpiresAt DateTime? @map("token_expires_at")
  adAccountId    String?   @map("ad_account_id")
  adAccountName  String?   @map("ad_account_name")
  currency       String?
  pageId         String?   @map("page_id")
  pageName       String?   @map("page_name")
  /// Max total daily budget across the user's running ads, in minor currency units (cents).
  dailyCapCents  Int       @default(500) @map("daily_cap_cents")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("meta_ad_connections")
}

model CustomerAd {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  headline     String
  primaryText  String   @map("primary_text") @db.Text
  link         String
  dailyCents   Int      @map("daily_cents")
  startsAt     DateTime @default(now()) @map("starts_at")
  endsAt       DateTime @map("ends_at")
  status       String   @default("ACTIVE")
  metaAdId     String?  @map("meta_ad_id")
  metaCampaign String?  @map("meta_campaign_id")
  spendCents   Int      @default(0) @map("spend_cents")
  clicks       Int      @default(0)
  impressions  Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("customer_ads")
}

// -----------------------------------------------------------------------------
// Customer-app reviews + support assistant (for customers' own published apps;
// AppWeaver's own platform AI never replies to reviews).
// -----------------------------------------------------------------------------

model ProjectReview {
  id            String    @id @default(cuid())
  projectId     String    @map("project_id")
  rating        Int
  authorName    String    @map("author_name")
  authorEmail   String?   @map("author_email")
  body          String    @db.Text
  topic         String?
  sentiment     String?
  urgency       String?
  status        String    @default("PENDING")
  aiDraft       String?   @map("ai_draft") @db.Text
  reply         String?   @db.Text
  replyStatus   String    @default("NONE") @map("reply_status")
  createdAt     DateTime  @default(now()) @map("created_at")
  /// Observatory: READY_FOR_REVIEW | NEEDS_INVESTIGATION | ESCALATION_REQUIRED | APPROVED_FOR_AUTOMATION
  responseState String    @default("READY_FOR_REVIEW") @map("response_state")
  /// Evidence bundle used for the draft (redacted; never contains secrets).
  evidence      Json?
  /// Original AI draft kept so owner corrections can be recorded.
  draftOriginal String?   @map("draft_original") @db.Text
  approvedById  String?   @map("approved_by_id")
  approvedAt    DateTime? @map("approved_at")
  repliedAt     DateTime? @map("replied_at")
  corrections   Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, createdAt])
  @@map("project_reviews")
}

model ProjectReviewSettings {
  id                String   @id @default(cuid())
  projectId         String   @unique @map("project_id")
  enabled           Boolean  @default(false)
  autoReplyPositive Boolean  @default(false) @map("auto_reply_positive")
  businessInfo      String   @default("") @map("business_info") @db.Text
  tone              String   @default("friendly")
  notifyEmail       String?  @map("notify_email")
  /// Optional owner-configured read-only status endpoint; only a reference id is sent.
  statusWebhookUrl  String?  @map("status_webhook_url")
  updatedAt         DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_review_settings")
}

model ProjectKnowledge {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_knowledge")
}

model ProjectSupportTicket {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  question   String   @db.Text
  contact    String?
  transcript Json?
  status     String   @default("OPEN")
  createdAt  DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, createdAt])
  @@map("project_support_tickets")
}

// -----------------------------------------------------------------------------
// Per-project marketing: campaigns and posts published to the customer's OWN
// social accounts. userId/projectId are plain indexed columns (no relations) so
// this feature does not touch the User/Project models.
// -----------------------------------------------------------------------------

enum MarketingPlatform {
  X
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

enum ProjectCampaignStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum ProjectPostStatus {
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  MANUAL
}

/// OAuth connection to a customer's own social account. Tokens are encrypted.
model SocialConnection {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  platform        MarketingPlatform
  accessTokenEnc  String            @map("access_token_enc")
  refreshTokenEnc String?           @map("refresh_token_enc")
  expiresAt       DateTime?         @map("expires_at")
  accountName     String?           @map("account_name")
  accountId       String?           @map("account_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@unique([userId, platform])
  @@map("social_connections")
}

model ProjectCampaign {
  id        String                @id @default(cuid())
  projectId String                @map("project_id")
  userId    String                @map("user_id")
  name      String
  brief     String                @default("") @db.Text
  status    ProjectCampaignStatus @default(DRAFT)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  posts ProjectPost[]

  @@index([projectId, createdAt])
  @@index([userId])
  @@map("project_campaigns")
}

model ProjectPost {
  id          String            @id @default(cuid())
  campaignId  String            @map("campaign_id")
  platform    MarketingPlatform
  text        String            @db.Text
  imageUrl    String?           @map("image_url")
  hashtags    String[]
  /// UTC instant; the owner's wall-clock choice is converted with timeZone.
  scheduledAt DateTime?         @map("scheduled_at")
  timeZone    String            @default("UTC") @map("time_zone")
  status      ProjectPostStatus @default(DRAFT)
  externalId  String?           @map("external_id")
  error       String?           @db.Text
  publishedAt DateTime?         @map("published_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  campaign ProjectCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([campaignId])
  @@map("project_posts")
}

/// Managed subdomain `<subdomain>.<APP_ROOT_DOMAIN>` served from a project's
/// published deployment. No FK relation so the schema stays append-only; a row
/// whose project no longer exists is treated as free (see subdomain-store.ts).
model ProjectSubdomain {
  id        String   @id @default(cuid())
  projectId String   @unique @map("project_id")
  subdomain String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_subdomains")
}

/// Result of a real health check against a project's live deployment.
model ProjectHealthCheck {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  ok         Boolean
  statusCode Int?     @map("status_code")
  latencyMs  Int?     @map("latency_ms")
  detail     String   @db.Text
  checkedAt  DateTime @default(now()) @map("checked_at")

  @@index([projectId, checkedAt])
  @@map("project_health_checks")
}

// -----------------------------------------------------------------------------
// Investor Hub (customer-facing fundraising CRM). Every row is scoped by userId
// AND projectId; no FK to User/Project so the schema stays append-only.
// -----------------------------------------------------------------------------
enum HubInvestorType {
  VC
  ANGEL
  FAMILY_OFFICE
  GRANT
  ACCELERATOR
  LENDER
  OTHER
}

enum HubInvestorStage {
  DISCOVERED
  RESEARCHED
  QUALIFIED
  OUTREACH_DRAFTED
  CONTACTED
  REPLIED
  MEETING_SCHEDULED
  PITCH_DELIVERED
  DUE_DILIGENCE
  NEGOTIATION
  FUNDING_SECURED
  DECLINED
}

enum HubOutreachKind {
  EMAIL
  FOLLOW_UP
  LINKEDIN
  CALL_SCRIPT
  MEETING_REQUEST
}

enum HubOutreachStatus {
  DRAFT
  APPROVED
  SENT
  CANCELLED
}

/// Only facts the founder typed in; these are the sole facts AI may use.
model InvestorHubProfile {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  projectId    String   @map("project_id")
  companyName  String   @default("") @map("company_name")
  website      String   @default("")
  description  String   @default("") @db.Text
  sector       String   @default("")
  stage        String   @default("")
  amountSought Int?     @map("amount_sought")
  currency     String   @default("USD")
  geography    String   @default("")
  traction     String   @default("") @db.Text
  useOfFunds   String   @default("") @map("use_of_funds") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, projectId])
  @@map("investor_hub_profiles")
}

model HubInvestor {
  id               String           @id @default(cuid())
  userId           String           @map("user_id")
  projectId        String           @map("project_id")
  name             String
  firm             String?
  type             HubInvestorType  @default(OTHER)
  website          String?
  /// Normalised host (no www) used for duplicate prevention.
  domain           String?
  email            String?
  /// Lowercased email used for duplicate prevention.
  emailKey         String?          @map("email_key")
  linkedinUrl      String?          @map("linkedin_url")
  focus            String?          @db.Text
  sectors          String[]
  stages           String[]
  geographies      String[]
  instruments      String[]
  ticketMin        Int?             @map("ticket_min")
  ticketMax        Int?             @map("ticket_max")
  portfolio        String[]
  sourceUrl        String?          @map("source_url")
  verified         Boolean          @default(false)
  lastVerifiedAt   DateTime?        @map("last_verified_at")
  /// Per-field provenance: { field: { sourceUrl, lastVerifiedAt, verified } }.
  fieldMeta        Json             @default("{}") @map("field_meta")
  pipelineStage    HubInvestorStage @default(DISCOVERED) @map("pipeline_stage")
  score            Int?
  scoreDetail      Json?            @map("score_detail")
  brief            String?          @db.Text
  briefSources     Json?            @map("brief_sources")
  briefAt          DateTime?        @map("brief_at")
  tags             String[]
  optedOut         Boolean          @default(false) @map("opted_out")
  sequenceActive   Boolean          @default(true) @map("sequence_active")
  nextFollowUpAt   DateTime?        @map("next_follow_up_at")
  fundingConfirmed Boolean          @default(false) @map("funding_confirmed")
  fundingAmount    Int?             @map("funding_amount")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  activities HubInvestorActivity[]
  outreach   HubInvestorOutreach[]
  replies    HubInvestorReply[]

  @@unique([projectId, domain])
  @@unique([projectId, emailKey])
  @@index([userId, projectId, pipelineStage])
  @@index([userId, projectId, nextFollowUpAt])
  @@map("hub_investors")
}

model HubInvestorActivity {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  projectId  String   @map("project_id")
  investorId String   @map("investor_id")
  type       String
  summary    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  investor HubInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId, createdAt])
  @@index([userId, projectId, createdAt])
  @@map("hub_investor_activities")
}

model HubInvestorOutreach {
  id         String            @id @default(cuid())
  userId     String            @map("user_id")
  projectId  String            @map("project_id")
  investorId String            @map("investor_id")
  kind       HubOutreachKind
  variant    Int               @default(1)
  subject    String?
  body       String            @db.Text
  status     HubOutreachStatus @default(DRAFT)
  approvedAt DateTime?         @map("approved_at")
  /// Always manual today: the founder copies the text and sends it themselves.
  sentAt     DateTime?         @map("sent_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  investor HubInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId, createdAt])
  @@index([userId, projectId, status, sentAt])
  @@map("hub_investor_outreach")
}

model HubInvestorReply {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  projectId      String   @map("project_id")
  investorId     String   @map("investor_id")
  text           String   @db.Text
  classification String
  createdAt      DateTime @default(now()) @map("created_at")

  investor HubInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId, createdAt])
  @@index([userId, projectId, createdAt])
  @@map("hub_investor_replies")
}

enum VideoJobMode {
  TEXT
  IMAGE
  VIDEO
}

enum VideoJobStatus {
  QUEUED
  SUBMITTED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum VideoProjectKind {
  STANDALONE
  SERIES
}

/// One AI video generation request sent to an external provider (e.g. Amazon
/// Nova Reel). Object keys are never exposed to clients; playback uses
/// short-lived presigned URLs minted after an owner check.
model VideoJob {
  id                 String         @id @default(cuid())
  userId             String         @map("user_id")
  projectId          String?        @map("project_id")
  providerId         String         @map("provider_id")
  model              String
  mode               VideoJobMode
  prompt             String         @db.Text
  inputImageKey      String?        @map("input_image_key")
  seconds            Int
  aspect             String         @default("16:9")
  status             VideoJobStatus @default(QUEUED)
  progress           Int            @default(0)
  externalId         String?        @map("external_id")
  attempts           Int            @default(0)
  nextAttemptAt      DateTime?      @map("next_attempt_at")
  error              String?        @db.Text
  outputKey          String?        @map("output_key")
  thumbnailKey       String?        @map("thumbnail_key")
  estimatedCostCents Int            @default(0) @map("estimated_cost_cents")
  actualCostCents    Int            @default(0) @map("actual_cost_cents")
  idempotencyKey     String         @unique @map("idempotency_key")
  submittedAt        DateTime?      @map("submitted_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  scenes VideoScene[]

  @@index([userId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([providerId, createdAt])
  @@map("video_jobs")
}

model VideoProject {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  title     String
  kind      VideoProjectKind @default(STANDALONE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  scenes VideoScene[]

  @@index([userId, updatedAt])
  @@map("video_projects")
}

model VideoScene {
  id                String   @id @default(cuid())
  videoProjectId    String   @map("video_project_id")
  order             Int
  prompt            String   @db.Text
  seconds           Int      @default(6)
  /// Optional reference image (S3 key, never sent to the client).
  referenceImageKey String?  @map("reference_image_key")
  jobId             String?  @map("job_id")
  season            Int?
  episode           Int?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  videoProject VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  job          VideoJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([videoProjectId, order])
  @@index([jobId])
  @@map("video_scenes")
}

/// Admin-managed switches and limits per video provider.
model VideoProviderConfig {
  id                 String   @id @default(cuid())
  providerId         String   @unique @map("provider_id")
  enabled            Boolean  @default(false)
  models             Json     @default("[]")
  maxSecondsPerJob   Int      @default(60) @map("max_seconds_per_job")
  dailyJobLimit      Int      @default(100) @map("daily_job_limit")
  monthlyBudgetCents Int      @default(10000) @map("monthly_budget_cents")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("video_provider_configs")
}

// -----------------------------------------------------------------------------
// Admin Application Observatory. Plain indexed projectId columns (no FKs) so the
// observatory never constrains Project deletion or other models.
// -----------------------------------------------------------------------------
enum AppFeatureStatus {
  PLANNED
  IMPLEMENTED
  TESTED
  DEPLOYED
  KNOWN_ISSUE
}

enum ProjectIssueStatus {
  OPEN
  ANALYSING
  FIX_PROPOSED
  APPROVED
  DEPLOYED
  VERIFIED
  CLOSED
}

/// Written every time an admin opens a project in the observatory.
model AdminAccessLog {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  adminEmail String?  @map("admin_email")
  projectId  String   @map("project_id")
  action     String
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@index([adminId, createdAt])
  @@map("admin_access_logs")
}

/// Version-aware feature ledger built only from real evidence.
model AppFeature {
  id         String           @id @default(cuid())
  projectId  String           @map("project_id")
  key        String
  name       String
  summary    String?          @db.Text
  status     AppFeatureStatus @default(PLANNED)
  /// Array of { type, ref, detail }
  evidence   Json             @default("[]")
  version    Int?
  verifiedAt DateTime?        @map("verified_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([projectId, key])
  @@index([projectId, status])
  @@map("app_features")
}

/// Result of an HTTP smoke check against the project's own published URL.
model SmokeCheck {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  url        String
  /// PASS | SUSPECTED | CONFIRMED_FAILURE
  outcome    String
  statusCode Int?     @map("status_code")
  title      String?
  version    Int?
  details    Json     @default("[]")
  checkedAt  DateTime @default(now()) @map("checked_at")

  @@index([projectId, checkedAt])
  @@index([outcome, checkedAt])
  @@map("smoke_checks")
}

/// A defect found via customer feedback, analysed into a plan the owner approves.
model ProjectIssue {
  id                String             @id @default(cuid())
  projectId         String             @map("project_id")
  reviewId          String?            @map("review_id")
  title             String
  severity          String             @default("medium")
  status            ProjectIssueStatus @default(OPEN)
  analysis          String?            @db.Text
  proposedPlan      String?            @map("proposed_plan") @db.Text
  evidence          Json               @default("[]")
  createdById       String?            @map("created_by_id")
  approvedById      String?            @map("approved_by_id")
  approvedAt        DateTime?          @map("approved_at")
  deployedAt        DateTime?          @map("deployed_at")
  verifiedAt        DateTime?          @map("verified_at")
  verifiedByCheckId String?            @map("verified_by_check_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([projectId, status])
  @@index([reviewId])
  @@map("project_issues")
}

// -----------------------------------------------------------------------------
// Investor Hub: call outcomes and consent-gated SMS. Plain indexed columns (no
// FKs) so the schema stays append-only; rows are removed with the investor or
// project by lib/projects/cleanup.ts.
// -----------------------------------------------------------------------------

/// Phone, time zone and the founder's recorded SMS consent for one investor.
model HubInvestorContact {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  projectId      String    @map("project_id")
  investorId     String    @unique @map("investor_id")
  /// E.164, e.g. +14155550123.
  phone          String?
  /// IANA zone used for quiet hours (08:00-20:00 investor-local).
  timezone       String?
  smsConsent     Boolean   @default(false) @map("sms_consent")
  smsConsentAt   DateTime? @map("sms_consent_at")
  /// How and when the investor agreed to be texted (required to enable SMS).
  smsConsentNote String?   @map("sms_consent_note")
  smsOptedOut    Boolean   @default(false) @map("sms_opted_out")
  smsOptedOutAt  DateTime? @map("sms_opted_out_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([phone])
  @@index([userId, projectId])
  @@map("hub_investor_contacts")
}

model HubInvestorCall {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  projectId  String   @map("project_id")
  investorId String   @map("investor_id")
  calledAt   DateTime @map("called_at")
  outcome    String
  notes      String?  @db.Text
  nextStep   String?  @map("next_step")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([investorId, calledAt])
  @@index([userId, projectId, calledAt])
  @@map("hub_investor_calls")
}

model HubInvestorSms {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  projectId  String   @map("project_id")
  investorId String   @map("investor_id")
  body       String   @db.Text
  /// SENT | DRY_RUN | FAILED
  status     String
  providerId String?  @map("provider_id")
  error      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([investorId, createdAt])
  @@index([userId, projectId, createdAt])
  @@map("hub_investor_sms")
}

// -----------------------------------------------------------------------------
// Video release scheduler: generated videos published to the owner's OWN
// connected accounts. Plain indexed columns (no FKs) so it never constrains
// VideoJob / VideoProject deletion.
// -----------------------------------------------------------------------------
enum VideoReleasePlatform {
  YOUTUBE
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  X
  TIKTOK
}

enum VideoReleaseStatus {
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  MANUAL
  CANCELLED
  PAUSED
}

model VideoRelease {
  id                String               @id @default(cuid())
  userId            String               @map("user_id")
  videoProjectId    String?              @map("video_project_id")
  sceneId           String?              @map("scene_id")
  jobId             String               @map("job_id")
  platform          VideoReleasePlatform
  language          String               @default("en")
  title             String
  caption           String               @default("") @db.Text
  hashtags          String[]
  thumbnailKey      String?              @map("thumbnail_key")
  /// UTC instant; the owner's wall-clock choice is converted with timeZone.
  scheduledAt       DateTime             @map("scheduled_at")
  timeZone          String               @default("UTC") @map("time_zone")
  status            VideoReleaseStatus   @default(SCHEDULED)
  approvedBy        String?              @map("approved_by")
  approvedAt        DateTime?            @map("approved_at")
  idempotencyKey    String               @unique @map("idempotency_key")
  externalId        String?              @map("external_id")
  postUrl           String?              @map("post_url")
  attempts          Int                  @default(0)
  nextAttemptAt     DateTime?            @map("next_attempt_at")
  error             String?              @db.Text
  /// Honest platform caveat shown to the owner (e.g. TikTok private-only posts).
  note              String?              @db.Text
  publishedAt       DateTime?            @map("published_at")
  season            Int?
  episode           Int?
  /// Groups the releases created by one series operation.
  seriesKey         String?              @map("series_key")
  /// Platform-returned metrics only (YouTube views); null when unavailable.
  metrics           Json?
  metricsAt         DateTime?            @map("metrics_at")
  reminderSentAt    DateTime?            @map("reminder_sent_at")
  outcomeNotifiedAt DateTime?            @map("outcome_notified_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@index([status, scheduledAt])
  @@index([userId, scheduledAt])
  @@index([userId, seriesKey])
  @@index([jobId])
  @@map("video_releases")
}

/// Append-only record of every credit balance change (charges, refunds, grants, admin adjustments).
model CreditLedger {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  /// Negative = spend, positive = grant/refund.
  delta          Int
  reason         String   @db.Text
  /// Pricing operation key (e.g. agent_run) or GRANT / REFUND / ADJUSTMENT.
  operation      String
  refType        String?  @map("ref_type")
  refId          String?  @map("ref_id")
  balanceAfter   Int      @map("balance_after")
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")
  /// PURCHASED | PROMOTIONAL | SUBSCRIPTION | ADJUSTMENT for credits added; null for spend/legacy rows.
  source         String?
  /// Workspace the spend is attributed to (workspace spending limits).
  workspaceId    String?  @map("workspace_id")

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("credit_ledger")
}

/// Customer-acquisition CRM: one row per prospect of a published project (deduped by email).
model Lead {
  id               String    @id @default(cuid())
  projectId        String    @map("project_id")
  name             String
  email            String?
  phone            String?
  source           String    @default("manual")
  utm              Json?
  /// NEW | CONTACTED | QUALIFIED | DEMO_BOOKED | WON | LOST
  status           String    @default("NEW")
  score            Int?
  scoreReasons     Json?     @map("score_reasons")
  scoredAt         DateTime? @map("scored_at")
  notes            String    @default("") @db.Text
  consent          Boolean   @default(false)
  consentText      String?   @map("consent_text") @db.Text
  consentAt        DateTime? @map("consent_at")
  optedOut         Boolean   @default(false) @map("opted_out")
  formSubmissionId String?   @unique @map("form_submission_id")
  suggestedAction  String?   @map("suggested_action") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities LeadActivity[]
  followUps  LeadFollowUp[]
  drafts     LeadEmailDraft[]
  bookings   LeadBooking[]

  @@unique([projectId, email])
  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  type      String
  detail    String   @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

/// Owner reminder: surfaces in the daily digest until marked done.
model LeadFollowUp {
  id        String    @id @default(cuid())
  leadId    String    @map("lead_id")
  dueAt     DateTime  @map("due_at")
  note      String    @default("") @db.Text
  doneAt    DateTime? @map("done_at")
  createdAt DateTime  @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([doneAt, dueAt])
  @@index([leadId])
  @@map("lead_follow_ups")
}

/// AI-drafted follow-up email; only sent after explicit owner approval.
model LeadEmailDraft {
  id           String    @id @default(cuid())
  leadId       String    @map("lead_id")
  subject      String
  body         String    @db.Text
  /// DRAFT | SENT | CANCELLED
  status       String    @default("DRAFT")
  approvedById String?   @map("approved_by_id")
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, status])
  @@map("lead_email_drafts")
}

model LeadAvailabilitySlot {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  startsAt    DateTime @map("starts_at")
  durationMin Int      @default(30) @map("duration_min")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  booking LeadBooking?

  @@index([projectId, startsAt])
  @@map("lead_availability_slots")
}

model LeadBooking {
  id        String   @id @default(cuid())
  slotId    String   @unique @map("slot_id")
  leadId    String   @map("lead_id")
  createdAt DateTime @default(now()) @map("created_at")

  slot LeadAvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  lead Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_bookings")
}

/// Growth agent experiment. Executes only safe, existing, owner-approved actions; never spends money.
model GrowthExperiment {
  id                 String    @id @default(cuid())
  projectId          String    @map("project_id")
  hypothesis         String    @db.Text
  bottleneck         String    @db.Text
  /// { type, title, brief, citedMetrics[], metricKey, priority }
  proposedAction     Json      @map("proposed_action")
  /// Informational estimate only; nothing is ever charged automatically.
  estimatedCostCents Int?      @map("estimated_cost_cents")
  /// PROPOSED | APPROVED | RUNNING | MEASURED | REJECTED
  status             String    @default("PROPOSED")
  metricBefore       Json?     @map("metric_before")
  metricAfter        Json?     @map("metric_after")
  resultNote         String?   @map("result_note") @db.Text
  /// Ids/links of what the safe action created (campaign draft, issue, prompt).
  executionResult    Json?     @map("execution_result")
  windowDays         Int       @default(14) @map("window_days")
  approvedById       String?   @map("approved_by_id")
  startedAt          DateTime? @map("started_at")
  measuredAt         DateTime? @map("measured_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("growth_experiments")
}

// -----------------------------------------------------------------------------
// Investor Hub automation: per-campaign approval auto-send and the AI voice agent.
// Plain indexed columns for investor ids (no FK) so HubInvestor stays untouched.
// -----------------------------------------------------------------------------
enum InvestorCampaignStatus {
  DRAFT
  APPROVED
  RUNNING
  PAUSED
  STOPPED
  DONE
}

model InvestorCampaign {
  id              String                 @id @default(cuid())
  projectId       String                 @map("project_id")
  userId          String                 @map("user_id")
  name            String
  status          InvestorCampaignStatus @default(DRAFT)
  templateSubject String                 @default("") @map("template_subject")
  templateBody    String                 @default("") @map("template_body") @db.Text
  /// Extra first-email variants: [{ subject, body }]. Each target gets one deterministically.
  variants        Json                   @default("[]")
  followUpBody    String                 @default("") @map("follow_up_body") @db.Text
  dailyLimit      Int                    @default(20) @map("daily_limit")
  sendWindowStart Int                    @default(9) @map("send_window_start")
  sendWindowEnd   Int                    @default(17) @map("send_window_end")
  timezone        String                 @default("UTC")
  followUpDays    Int[]                  @map("follow_up_days")
  maxFollowUps    Int                    @default(2) @map("max_follow_ups")
  approvedAt      DateTime?              @map("approved_at")
  approvedBy      String?                @map("approved_by")
  acknowledgedAt  DateTime?              @map("acknowledged_at")
  pausedReason    String?                @map("paused_reason")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  targets InvestorCampaignTarget[]

  @@index([status, updatedAt])
  @@index([userId, projectId, createdAt])
  @@map("investor_campaigns")
}

model InvestorCampaignTarget {
  id         String    @id @default(cuid())
  campaignId String    @map("campaign_id")
  investorId String    @map("investor_id")
  email      String
  sourceUrl  String    @map("source_url")
  /// ACTIVE | COMPLETED | STOPPED_REPLY | STOPPED_BOUNCE | STOPPED_OPTOUT | STOPPED_MANUAL | SKIPPED
  status     String    @default("ACTIVE")
  stopReason String?   @map("stop_reason")
  stepsSent  Int       @default(0) @map("steps_sent")
  nextSendAt DateTime? @map("next_send_at")
  lastSentAt DateTime? @map("last_sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  campaign InvestorCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sends    InvestorCampaignSend[]

  @@unique([campaignId, investorId])
  @@index([email])
  @@index([campaignId, status, nextSendAt])
  @@map("investor_campaign_targets")
}

model InvestorCampaignSend {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  targetId   String   @map("target_id")
  /// 0 = first email, 1.. = follow-ups.
  step       Int
  /// SENDING (claimed) | SENT | BOUNCED
  status     String   @default("SENDING")
  subject    String
  body       String   @db.Text
  error      String?
  createdAt  DateTime @default(now()) @map("created_at")

  target InvestorCampaignTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  /// Idempotency: one email per target per step, ever.
  @@unique([targetId, step])
  @@index([campaignId, createdAt])
  @@map("investor_campaign_sends")
}

/// Recorded evidence that an investor agreed to an AI call (and optionally to recording).
model InvestorConsent {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  projectId  String    @map("project_id")
  investorId String    @map("investor_id")
  /// AI_CALL | CALL_RECORDING
  type       String
  evidence   String    @db.Text
  /// Phone the consent was given for; consent lapses if the number changes.
  phone      String?
  obtainedAt DateTime  @map("obtained_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([investorId, type, createdAt])
  @@index([userId, projectId])
  @@map("investor_consents")
}

model InvestorVoiceCall {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  projectId      String    @map("project_id")
  investorId     String    @map("investor_id")
  /// QUEUED | IN_PROGRESS | COMPLETED | NO_ANSWER | FAILED | CANCELLED
  status         String    @default("QUEUED")
  toNumber       String    @map("to_number")
  fromNumber     String    @map("from_number")
  transferNumber String?   @map("transfer_number")
  providerSid    String?   @map("provider_sid")
  recording      Boolean   @default(false)
  turns          Int       @default(0)
  /// [{ role: "ai" | "investor", text }]
  transcript     Json      @default("[]")
  summary        String?   @db.Text
  /// CALL_OUTCOMES value from the CRM call log.
  outcome        String?
  transferred    Boolean   @default(false)
  error          String?
  startedAt      DateTime? @map("started_at")
  endedAt        DateTime? @map("ended_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([investorId, createdAt])
  @@index([userId, projectId, createdAt])
  @@map("investor_voice_calls")
}

model InvestorMeetingRequest {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  projectId  String   @map("project_id")
  investorId String   @map("investor_id")
  callId     String?  @map("call_id")
  note       String   @db.Text
  /// OPEN | DONE
  status     String   @default("OPEN")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, projectId, status])
  @@index([investorId])
  @@map("investor_meeting_requests")
}

enum DeploymentEnvironment {
  STAGING
  PRODUCTION
}

/// A launch-readiness run for a project. `results` holds the per-check
/// PASS/WARN/FAIL/NOT_VERIFIED outcomes with evidence. Approval records the
/// owner's decision, including whether warnings were explicitly acknowledged.
model LaunchReport {
  id                   String                @id @default(cuid())
  projectId            String                @map("project_id")
  environment          DeploymentEnvironment @default(PRODUCTION)
  results              Json                  @default("[]")
  failCount            Int                   @default(0) @map("fail_count")
  warnCount            Int                   @default(0) @map("warn_count")
  deploymentVersion    Int?                  @map("deployment_version")
  approvedAt           DateTime?             @map("approved_at")
  approvedById         String?               @map("approved_by_id")
  acknowledgedWarnings Boolean               @default(false) @map("acknowledged_warnings")
  createdAt            DateTime              @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, environment, createdAt])
  @@map("launch_reports")
}

enum AgentScopeType {
  PLATFORM
  PROJECT
}

enum OrchestratorAgent {
  MARKETING_DIRECTOR
  CONTENT
  SOCIAL_MANAGER
  CUSTOMER_ENGAGEMENT
  INVESTOR
  VOICE_MESSAGING
  GROWTH_ANALYST
}

enum AgentMode {
  ASSIST
  APPROVAL
  AUTONOMOUS
}

enum AgentActivityStatus {
  PLANNED
  AWAITING_APPROVAL
  RUNNING
  DONE
  FAILED
  BLOCKED
}

/// Per-scope agent configuration. scopeId is "PLATFORM" for the platform scope, else the project id.
model AgentSetting {
  id               String            @id @default(cuid())
  scopeType        AgentScopeType    @map("scope_type")
  scopeId          String            @map("scope_id")
  agent            OrchestratorAgent
  mode             AgentMode         @default(ASSIST)
  enabled          Boolean           @default(false)
  paused           Boolean           @default(false)
  /// Categories allowed to run autonomously, e.g. ["social_post"].
  categories       Json              @default("[]")
  dailyActionLimit Int               @default(20) @map("daily_action_limit")
  dailyBudgetCents Int               @default(0) @map("daily_budget_cents")
  authorisedBy     String?           @map("authorised_by")
  authorisedAt     DateTime?         @map("authorised_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([scopeType, scopeId, agent])
  @@map("agent_settings")
}

/// Audit trail and approval queue for every agent action. Summaries are redacted before storage.
model AgentActivity {
  id             String              @id @default(cuid())
  scopeType      AgentScopeType      @map("scope_type")
  scopeId        String              @map("scope_id")
  agent          OrchestratorAgent
  action         String
  category       String              @default("general")
  risk           String              @default("LOW")
  status         AgentActivityStatus @default(PLANNED)
  sources        Json?
  tool           String?
  inputSummary   String?             @map("input_summary") @db.Text
  /// Redacted, non-secret data an executor needs to run the action after approval.
  payload        Json?
  resultSummary  String?             @map("result_summary") @db.Text
  decisionReason String?             @map("decision_reason")
  costCents      Int                 @default(0) @map("cost_cents")
  creditsCharged Int?                @map("credits_charged")
  error          String?             @db.Text
  retryOf        String?             @map("retry_of")
  idempotencyKey String?             @unique @map("idempotency_key")
  decidedBy      String?             @map("decided_by")
  decidedAt      DateTime?           @map("decided_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([scopeType, scopeId, createdAt])
  @@index([status, createdAt])
  @@index([agent, createdAt])
  @@map("agent_activities")
}

/// Kill switch rows: scope "GLOBAL" pauses every agent and automation, "PLATFORM" only platform automations.
model AgentKillSwitch {
  scope     String   @id
  paused    Boolean  @default(false)
  reason    String?
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("agent_kill_switches")
}

// ---------------------------------------------------------------------------
// Marketing credits (separate from build credits) and internal marketing cost
// ---------------------------------------------------------------------------

enum CampaignBilling {
  APPWEAVER_INTERNAL
  CUSTOMER_MARKETING
}

enum MarketingCreditSource {
  PURCHASED
  PROMO
  SUBSCRIPTION
  REFUND
}

enum MarketingLedgerKind {
  PURCHASE
  GRANT
  RESERVE
  SETTLE
  RELEASE
  REFUND
  EXPIRY
  ADJUSTMENT
}

enum MarketingReservationStatus {
  RESERVED
  SETTLED
  RELEASED
  REFUNDED
}

/// One wallet per billing owner (the workspace owner). `available` excludes `reserved`.
model MarketingWallet {
  userId                String    @id @map("user_id")
  available             Int       @default(0)
  reserved              Int       @default(0)
  /// Admin-configured facility: how far below zero `available` may go. 0 = never negative.
  overdraftLimit        Int       @default(0) @map("overdraft_limit")
  lowBalanceThreshold   Int?      @map("low_balance_threshold")
  lowBalanceAlertSentAt DateTime? @map("low_balance_alert_sent_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("marketing_wallets")
}

/// Tracks the unspent part of each grant so promo credits can expire.
model MarketingCreditLot {
  id        String                @id @default(cuid())
  userId    String                @map("user_id")
  source    MarketingCreditSource
  amount    Int
  remaining Int
  expiresAt DateTime?             @map("expires_at")
  refId     String?               @map("ref_id")
  createdAt DateTime              @default(now()) @map("created_at")

  @@index([userId, remaining, expiresAt])
  @@index([expiresAt])
  @@map("marketing_credit_lots")
}

/// Append-only (a database trigger rejects UPDATE and DELETE). `delta` changes the
/// total balance (available + reserved); `reservedDelta` moves credits into/out of reservation.
model MarketingLedger {
  id             String                 @id @default(cuid())
  userId         String                 @map("user_id")
  /// Organisation (workspace id, or `user:<id>` when no workspace applies) for reporting.
  orgId          String?                @map("org_id")
  projectId      String?                @map("project_id")
  kind           MarketingLedgerKind
  delta          Int
  reservedDelta  Int                    @default(0) @map("reserved_delta")
  operation      String?
  reservationId  String?                @map("reservation_id")
  refType        String?                @map("ref_type")
  refId          String?                @map("ref_id")
  source         MarketingCreditSource?
  costCents      Int?                   @map("cost_cents")
  balanceAfter   Int                    @map("balance_after")
  note           String?                @db.Text
  idempotencyKey String                 @unique @map("idempotency_key")
  createdAt      DateTime               @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([orgId, createdAt])
  @@index([projectId, createdAt])
  @@index([kind, createdAt])
  @@map("marketing_ledger")
}

model MarketingReservation {
  id             String                     @id @default(cuid())
  userId         String                     @map("user_id")
  orgId          String?                    @map("org_id")
  projectId      String?                    @map("project_id")
  operation      String
  billing        CampaignBilling            @default(CUSTOMER_MARKETING)
  maxCredits     Int                        @map("max_credits")
  settledCredits Int?                       @map("settled_credits")
  status         MarketingReservationStatus @default(RESERVED)
  idempotencyKey String                     @unique @map("idempotency_key")
  refType        String?                    @map("ref_type")
  refId          String?                    @map("ref_id")
  expiresAt      DateTime                   @map("expires_at")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  @@index([status, expiresAt])
  @@index([userId, status])
  @@index([projectId, createdAt])
  @@map("marketing_reservations")
}

/// What AppWeaver itself spends on its own marketing. Never touches customer wallets.
model InternalMarketingCost {
  id                 String          @id @default(cuid())
  billing            CampaignBilling @default(APPWEAVER_INTERNAL)
  operation          String
  provider           String
  estimatedCostCents Int             @map("estimated_cost_cents")
  actualCostCents    Int?            @map("actual_cost_cents")
  refType            String?         @map("ref_type")
  refId              String?         @map("ref_id")
  adminId            String?         @map("admin_id")
  createdAt          DateTime        @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([operation, createdAt])
  @@map("internal_marketing_costs")
}

/// Versioned, admin-managed price list. A change inserts a new version; old rows are preserved.
model MarketingPriceItem {
  id               String   @id @default(cuid())
  operation        String
  version          Int
  name             String
  description      String   @default("") @db.Text
  creditCost       Int      @map("credit_cost")
  /// e.g. {"type":"per_unit","unit":"second"} - creditCost is then the price per unit.
  rule             Json?
  provider         String?
  model            String?
  /// Estimated provider cost in cents per priced unit, when known (margin reporting).
  costCents        Float?   @map("cost_cents")
  /// Max charge = ceil(estimate * maxFactor); passthrough items use a factor above 1.
  maxFactor        Float    @default(1) @map("max_factor")
  planRestrictions String[] @map("plan_restrictions")
  billable         Boolean  @default(true)
  maxPerPeriod     Int?     @map("max_per_period")
  effectiveFrom    DateTime @default(now()) @map("effective_from")
  createdById      String?  @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([operation, version])
  @@index([operation, effectiveFrom])
  @@map("marketing_price_items")
}

model MarketingPackage {
  id         String   @id @default(cuid())
  name       String
  credits    Int
  priceCents Int      @map("price_cents")
  currency   String   @default("usd")
  active     Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("marketing_packages")
}

model MarketingPurchase {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  packageId       String?  @map("package_id")
  packageName     String   @map("package_name")
  credits         Int
  amountCents     Int      @map("amount_cents")
  currency        String
  stripeSessionId String   @unique @map("stripe_session_id")
  paymentIntentId String?  @unique @map("payment_intent_id")
  stripeEventId   String?  @map("stripe_event_id")
  receiptUrl      String?  @map("receipt_url")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("marketing_purchases")
}

/// Per-project spend limits for recurring/scheduled marketing jobs.
model MarketingProjectBudget {
  projectId    String    @id @map("project_id")
  dayLimit     Int?      @map("day_limit")
  weekLimit    Int?      @map("week_limit")
  monthLimit   Int?      @map("month_limit")
  pausedAt     DateTime? @map("paused_at")
  pausedReason String?   @map("paused_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("marketing_project_budgets")
}

/// Admin controls per organisation (workspace id, or `user:<id>`).
model MarketingOrgControl {
  orgId           String    @id @map("org_id")
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason")
  /// Max credits the org may consume per calendar month; null = unlimited.
  monthlyLimit    Int?      @map("monthly_limit")
  updatedById     String?   @map("updated_by_id")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("marketing_org_controls")
}

// -----------------------------------------------------------------------------
// Configurable daily content pipeline (platform house content + per-project)
// -----------------------------------------------------------------------------

enum ContentRunStatus {
  RUNNING
  WAITING
  SUCCEEDED
  PARTIAL
  FAILED
}

model ContentPipeline {
  id                    String         @id @default(cuid())
  scope                 AgentScopeType
  /// "PLATFORM" or the project id; unique so each scope has one pipeline.
  scopeKey              String         @unique @map("scope_key")
  projectId             String?        @map("project_id")
  /// User whose wallet/video quota is used; for PLATFORM it must be an admin (internal billing).
  ownerUserId           String         @map("owner_user_id")
  enabled               Boolean        @default(false)
  paused                Boolean        @default(false)
  /// Local wall-clock "HH:MM" in timeZone at which the daily run starts.
  timeOfDay             String         @default("09:00") @map("time_of_day")
  timeZone              String         @default("UTC") @map("time_zone")
  postsPerDay           Int            @default(1) @map("posts_per_day")
  platforms             String[]
  languages             String[]
  /// Subset of post, image, video.
  contentTypes          String[]       @map("content_types")
  /// Local "HH:MM" slots used to schedule the generated posts.
  preferredPostTimes    String[]       @map("preferred_post_times")
  /// Agent categories (e.g. social_post) allowed to be auto-approved by this pipeline.
  autoPublishCategories String[]       @map("auto_publish_categories")
  objective             String         @default("") @db.Text
  lastRunAt             DateTime?      @map("last_run_at")
  /// Daily spend ceiling in marketing credits (customer scope); 0 = no extra cap.
  maxDailyCredits       Int            @default(0) @map("max_daily_credits")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  runs ContentRun[]

  @@index([enabled, scope])
  @@map("content_pipelines")
}

model ContentRun {
  id          String           @id @default(cuid())
  pipelineId  String           @map("pipeline_id")
  /// Local calendar day (YYYY-MM-DD) in the pipeline time zone: one run per pipeline per day.
  runDate     String           @map("run_date")
  status      ContentRunStatus @default(RUNNING)
  /// Per-step state and results keyed by step name.
  steps       Json             @default("{}")
  errors      Json             @default("[]")
  lockedUntil DateTime?        @map("locked_until")
  trigger     String           @default("cron")
  startedAt   DateTime         @default(now()) @map("started_at")
  finishedAt  DateTime?        @map("finished_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  pipeline ContentPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, runDate])
  @@index([status, updatedAt])
  @@map("content_runs")
}

// ---------------------------------------------------------------------------
// Unified inbox (webchat, email, WhatsApp, SMS, Messenger, Instagram DMs)
// ---------------------------------------------------------------------------

enum MessageChannel {
  WEBCHAT
  EMAIL
  WHATSAPP
  SMS
  FACEBOOK
  INSTAGRAM
}

enum ConversationStatus {
  OPEN
  ESCALATED
  RESOLVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

/// One thread with one contact on one channel. Scope PLATFORM = AppWeaver itself, PROJECT = a customer project.
model Conversation {
  id               String             @id @default(cuid())
  scopeType        AgentScopeType     @map("scope_type")
  scopeId          String             @map("scope_id")
  channel          MessageChannel
  externalThreadId String             @map("external_thread_id")
  /// Channel address of the contact: E.164 phone, email, or page-scoped id. Treated as personal data.
  contactRef       String             @map("contact_ref")
  contactName      String?            @map("contact_name")
  leadId           String?            @map("lead_id")
  status           ConversationStatus @default(OPEN)
  assignedTo       String?            @map("assigned_to")
  /// When true the AI never answers this conversation.
  humanTakeover    Boolean            @default(false) @map("human_takeover")
  isReview         Boolean            @default(false) @map("is_review")
  language         String?
  category         String?
  summary          String?            @db.Text
  lastMessageAt    DateTime           @default(now()) @map("last_message_at")
  /// Last message from the contact; drives the 24h customer-service window on WhatsApp, Messenger and Instagram.
  lastInboundAt    DateTime?          @map("last_inbound_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  messages InboxMessage[]

  @@unique([scopeType, scopeId, channel, externalThreadId], map: "conversations_thread_key")
  @@index([scopeType, scopeId, status, lastMessageAt])
  @@map("conversations")
}

model InboxMessage {
  id                String                 @id @default(cuid())
  conversationId    String                 @map("conversation_id")
  channel           MessageChannel
  direction         MessageDirection
  body              String                 @db.Text
  attachments       Json?
  /// Provider id (wamid, Twilio SID, Meta mid, email Message-ID). Unique per channel so retried webhooks are no-ops.
  providerMessageId String?                @map("provider_message_id")
  deliveryStatus    MessageDeliveryStatus? @map("delivery_status")
  aiGenerated       Boolean                @default(false) @map("ai_generated")
  /// Unsent AI or human draft waiting in the inbox.
  isDraft           Boolean                @default(false) @map("is_draft")
  category          String?
  /// Knowledge entries the draft was built from.
  sources           Json?
  agentActivityId   String?                @map("agent_activity_id")
  error             String?
  createdAt         DateTime               @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([channel, providerMessageId])
  @@index([conversationId, createdAt])
  @@map("inbox_messages")
}

/// Credentials for one channel of one scope. `config` is AES-GCM encrypted JSON (lib/crypto/secret-box).
model ChannelConnection {
  id        String         @id @default(cuid())
  scopeType AgentScopeType @map("scope_type")
  scopeId   String         @map("scope_id")
  channel   MessageChannel
  /// Non-secret provider account id used to route webhooks (phone number id, page id, Twilio number).
  accountId String?        @map("account_id")
  config    String         @db.Text
  status    String         @default("ACTIVE")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([scopeType, scopeId, channel])
  @@index([channel, accountId])
  @@map("channel_connections")
}

/// Per contact+channel opt-in/opt-out; checked before every outbound message.
model ContactConsent {
  id        String         @id @default(cuid())
  scopeType AgentScopeType @map("scope_type")
  scopeId   String         @map("scope_id")
  channel   MessageChannel
  contact   String
  optIn     Boolean        @default(false) @map("opt_in")
  optOut    Boolean        @default(false) @map("opt_out")
  source    String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([scopeType, scopeId, channel, contact])
  @@map("contact_consents")
}

/// AppWeaver's own product facts for the platform-scope inbox; never mixed with ProjectKnowledge.
model PlatformKnowledge {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("platform_knowledge")
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaVisibility {
  PRIVATE
  PUBLIC
}

enum MediaAssetStatus {
  READY
  FAILED
}

/// An uploaded marketing image or video. Posts reference it as `media://<id>`; the URL is resolved (and re-signed) at publish time.
model MediaAsset {
  id           String           @id @default(cuid())
  /// "PLATFORM" or the project id; every object key is scoped by it.
  scopeKey     String           @map("scope_key")
  projectId    String?          @map("project_id")
  ownerUserId  String?          @map("owner_user_id")
  kind         MediaKind
  visibility   MediaVisibility  @default(PRIVATE)
  status       MediaAssetStatus @default(READY)
  key          String           @unique
  contentType  String           @map("content_type")
  sizeBytes    Int              @map("size_bytes")
  sha256       String
  error        String?          @db.Text
  contentRunId String?          @map("content_run_id")
  videoJobId   String?          @map("video_job_id")
  linkedType   String?          @map("linked_type")
  linkedId     String?          @map("linked_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([scopeKey, createdAt])
  @@index([contentRunId])
  @@index([videoJobId])
  @@index([linkedType, linkedId])
  @@map("media_assets")
}

/// Every provider delivery event processed once; the unique event id makes retried status webhooks no-ops.
model MessageStatusEvent {
  id                String         @id @default(cuid())
  channel           MessageChannel
  /// Provider event id, e.g. "<MessageSid>:delivered" (Twilio) or "<wamid>:read" (WhatsApp).
  eventId           String         @map("event_id")
  providerMessageId String         @map("provider_message_id")
  /// QUEUED | SENT | DELIVERED | READ | FAILED
  status            String
  errorCode         String?        @map("error_code")
  errorMessage      String?        @map("error_message")
  createdAt         DateTime       @default(now()) @map("created_at")

  @@unique([channel, eventId])
  @@index([channel, providerMessageId])
  @@map("message_status_events")
}

/// Suppression list: nothing is sent to a suppressed contact on that channel until they opt back in.
model MessagingSuppression {
  id        String         @id @default(cuid())
  scopeType AgentScopeType @map("scope_type")
  scopeId   String         @map("scope_id")
  channel   MessageChannel
  contact   String
  /// STOP | UNSUBSCRIBE | MANUAL ... (the keyword or reason that caused it)
  reason    String
  source    String
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([scopeType, scopeId, channel, contact])
  @@map("messaging_suppressions")
}

/// Evidence behind a marketing / lead opt-in: where, when and what the contact agreed to.
model ConsentProof {
  id         String         @id @default(cuid())
  scopeType  AgentScopeType @map("scope_type")
  scopeId    String         @map("scope_id")
  channel    MessageChannel
  contact    String
  source     String
  proof      String         @db.Text
  capturedAt DateTime       @map("captured_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([scopeType, scopeId, channel, contact])
  @@map("consent_proofs")
}

/// Result of the last live provider check; a channel is AVAILABLE only while this is VERIFIED for the current credentials.
model ChannelVerification {
  id          String         @id @default(cuid())
  scopeType   AgentScopeType @map("scope_type")
  scopeId     String         @map("scope_id")
  channel     MessageChannel
  /// VERIFIED | FAILED
  status      String
  /// Hash of the credentials that were checked, so changing them invalidates the verification.
  fingerprint String
  detail      String?
  errorCode   String?        @map("error_code")
  checkedAt   DateTime       @default(now()) @map("checked_at")

  @@unique([scopeType, scopeId, channel])
  @@map("channel_verifications")
}

// -----------------------------------------------------------------------------
// Calendar sync (Google Calendar / Microsoft Outlook). scopeKey is a projectId or "PLATFORM".
// Plain indexed columns (no relations) so Project / LeadBooking stay untouched.
// -----------------------------------------------------------------------------

/// One calendar connection per project (or the platform). Tokens are AES-GCM encrypted.
model CalendarConnection {
  id                   String    @id @default(cuid())
  scopeKey             String    @unique @map("scope_key")
  ownerId              String    @map("owner_id")
  /// GOOGLE | MICROSOFT
  provider             String
  /// PENDING | CONNECTED | NEEDS_RECONNECT
  status               String    @default("PENDING")
  refreshTokenEnc      String?   @map("refresh_token_enc") @db.Text
  accessTokenEnc       String?   @map("access_token_enc") @db.Text
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  scopes               String    @default("")
  accountLabel         String?   @map("account_label")
  calendarId           String    @default("primary") @map("calendar_id")
  /// Last successful live call against the provider; availability is UNAVAILABLE without it.
  verifiedAt           DateTime? @map("verified_at")
  lastError            String?   @map("last_error") @db.Text
  lastSyncAt           DateTime? @map("last_sync_at")
  /// { mon: [["09:00","17:00"]], ... } in timeZone.
  workingHours         Json?     @map("working_hours")
  bufferBeforeMin      Int       @default(0) @map("buffer_before_min")
  bufferAfterMin       Int       @default(0) @map("buffer_after_min")
  minNoticeMin         Int       @default(120) @map("min_notice_min")
  slotStepMin          Int       @default(30) @map("slot_step_min")
  durationMin          Int       @default(30) @map("duration_min")
  timeZone             String    @default("UTC") @map("time_zone")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("calendar_connections")
}

/// Short-lived OAuth state + PKCE verifier; consumed (deleted) by the callback.
model CalendarOAuthState {
  id              String   @id @default(cuid())
  stateHash       String   @unique @map("state_hash")
  scopeKey        String   @map("scope_key")
  userId          String   @map("user_id")
  provider        String
  codeVerifierEnc String   @map("code_verifier_enc") @db.Text
  returnTo        String   @default("") @map("return_to")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("calendar_oauth_states")
}

/// Calendar state of a LeadBooking. No booking is ever CONFIRMED without a real provider event.
model CalendarBookingSync {
  id              String    @id @default(cuid())
  bookingId       String    @unique @map("booking_id")
  scopeKey        String    @map("scope_key")
  provider        String?
  /// CONFIRMED | PENDING_MANUAL_CONFIRMATION | CANCELLED
  status          String    @default("PENDING_MANUAL_CONFIRMATION")
  externalEventId String?   @map("external_event_id")
  startsAt        DateTime  @map("starts_at")
  endsAt          DateTime  @map("ends_at")
  retryCreate     Boolean   @default(false) @map("retry_create")
  attempts        Int       @default(0)
  lastError       String?   @map("last_error") @db.Text
  lastSyncedAt    DateTime? @map("last_synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([scopeKey, status])
  @@index([retryCreate, status])
  @@map("calendar_booking_syncs")
}

// -----------------------------------------------------------------------------
// AI Meeting Scheduling and Coordination. scopeType PLATFORM | PROJECT, scopeId = "PLATFORM" or projectId.
// -----------------------------------------------------------------------------

/// Admin-configurable meeting template.
model MeetingType {
  id                   String   @id @default(cuid())
  scopeType            String   @default("PLATFORM") @map("scope_type")
  scopeId              String   @default("PLATFORM") @map("scope_id")
  key                  String
  name                 String
  /// USER | INVESTOR | CUSTOMER | BUSINESS | INTERNAL
  category             String   @default("CUSTOMER")
  durationMin          Int      @default(30) @map("duration_min")
  bufferBeforeMin      Int      @default(0) @map("buffer_before_min")
  bufferAfterMin       Int      @default(10) @map("buffer_after_min")
  /// GOOGLE_MEET | TEAMS | ZOOM | PHONE | IN_PERSON | MANUAL_LINK
  locationKind         String   @default("MANUAL_LINK") @map("location_kind")
  requiredParticipants Int      @default(1) @map("required_participants")
  workingHours         Json?    @map("working_hours")
  timeZone             String   @default("UTC") @map("time_zone")
  minNoticeMin         Int      @default(240) @map("min_notice_min")
  reminderOffsetsMin   Int[]    @map("reminder_offsets_min")
  requiresApproval     Boolean  @default(true) @map("requires_approval")
  /// Owner explicitly authorises the agent to book this routine type once the participant agreed.
  autonomousBooking    Boolean  @default(false) @map("autonomous_booking")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([scopeType, scopeId, key])
  @@map("meeting_types")
}

model Meeting {
  id                 String    @id @default(cuid())
  scopeType          String    @default("PLATFORM") @map("scope_type")
  scopeId            String    @default("PLATFORM") @map("scope_id")
  typeId             String?   @map("type_id")
  title              String
  /// REQUESTED | PROPOSED | AWAITING_CONFIRMATION | CONFIRMED | RESCHEDULED | CANCELLED | COMPLETED | MISSED | FAILED
  status             String    @default("REQUESTED")
  category           String    @default("CUSTOMER")
  startsAt           DateTime? @map("starts_at")
  endsAt             DateTime? @map("ends_at")
  durationMin        Int       @default(30) @map("duration_min")
  timeZone           String    @default("UTC") @map("time_zone")
  hostUserId         String?   @map("host_user_id")
  assigneeId         String?   @map("assignee_id")
  /// [{ name, email, phone, timeZone, role, userId }]
  participants       Json      @default("[]")
  agenda             String    @default("") @db.Text
  /// LEAD | INVESTOR | SUPPORT_TICKET | PROJECT | USER_REQUEST | MANUAL
  sourceType         String    @default("MANUAL") @map("source_type")
  sourceId           String?   @map("source_id")
  requestedById      String?   @map("requested_by_id")
  requestedByAgent   Boolean   @default(false) @map("requested_by_agent")
  locationKind       String    @default("MANUAL_LINK") @map("location_kind")
  locationText       String?   @map("location_text")
  conferenceProvider String?   @map("conference_provider")
  conferenceUrl      String?   @map("conference_url") @db.Text
  conferenceId       String?   @map("conference_id")
  calendarProvider   String?   @map("calendar_provider")
  externalEventId    String?   @map("external_event_id")
  idempotencyKey     String    @unique @map("idempotency_key")
  /// Private to staff with meetings:notes; never rendered to participants.
  internalNotes      String?   @map("internal_notes") @db.Text
  transcriptConsent  Boolean   @default(false) @map("transcript_consent")
  transcript         String?   @db.Text
  outcome            String?   @db.Text
  nextSteps          Json?     @map("next_steps")
  summary            String?   @db.Text
  /// Bumped on every change so older signed links stop working.
  tokenVersion       Int       @default(1) @map("token_version")
  failureReason      String?   @map("failure_reason") @db.Text
  confirmedAt        DateTime? @map("confirmed_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelReason       String?   @map("cancel_reason")
  notesPurgedAt      DateTime? @map("notes_purged_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([scopeType, scopeId, status, startsAt])
  @@index([sourceType, sourceId])
  @@index([startsAt])
  @@map("meetings")
}

model MeetingSlotProposal {
  id         String   @id @default(cuid())
  meetingId  String   @map("meeting_id")
  startsAt   DateTime @map("starts_at")
  endsAt     DateTime @map("ends_at")
  /// PROPOSED | ACCEPTED | DECLINED | EXPIRED
  status     String   @default("PROPOSED")
  proposedBy String   @default("system") @map("proposed_by")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([meetingId, startsAt])
  @@index([meetingId, status])
  @@map("meeting_slot_proposals")
}

/// Backstop against double booking: one row per active meeting, unique per host and start.
model MeetingSlotLock {
  id          String   @id @default(cuid())
  meetingId   String   @unique @map("meeting_id")
  resourceKey String   @map("resource_key")
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([resourceKey, startsAt])
  @@index([resourceKey, endsAt])
  @@map("meeting_slot_locks")
}

model MeetingReminder {
  id        String    @id @default(cuid())
  meetingId String    @map("meeting_id")
  offsetMin Int       @map("offset_min")
  /// EMAIL | WHATSAPP | SMS | IN_APP
  channel   String    @default("EMAIL")
  dueAt     DateTime  @map("due_at")
  /// PENDING | SENT | FAILED | SKIPPED
  status    String    @default("PENDING")
  attempts  Int       @default(0)
  lastError String?   @map("last_error") @db.Text
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([meetingId, offsetMin, channel])
  @@index([status, dueAt])
  @@map("meeting_reminders")
}

model MeetingAudit {
  id        String   @id @default(cuid())
  meetingId String   @map("meeting_id")
  actor     String
  action    String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([meetingId, createdAt])
  @@map("meeting_audits")
}

/// In-app notification for staff or a signed-in user.
model MeetingNotification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  meetingId String    @map("meeting_id")
  title     String
  body      String    @default("") @db.Text
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("meeting_notifications")
}

/// Manual availability when no calendar is connected: weekly hours plus blocked ranges. resourceKey = scope or "user:<id>".
model MeetingAvailabilityRule {
  id           String   @id @default(cuid())
  resourceKey  String   @unique @map("resource_key")
  timeZone     String   @default("UTC") @map("time_zone")
  workingHours Json?    @map("working_hours")
  /// [{ start, end }] ISO instants; reasons are never stored.
  blocked      Json     @default("[]")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("meeting_availability_rules")
}

/// Per-scope retention and conference-provider verification.
model MeetingSettings {
  id            String   @id @default(cuid())
  scopeKey      String   @unique @map("scope_key")
  /// Notes/transcripts older than this (after the meeting) are purged; null keeps them until deleted manually.
  retentionDays Int?     @map("retention_days")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("meeting_settings")
}

/// Live verification of a conference provider (ZOOM; MEET/TEAMS follow the calendar connection).
model MeetingProviderStatus {
  provider    String    @id
  verifiedAt  DateTime? @map("verified_at")
  fingerprint String    @default("")
  lastError   String?   @map("last_error") @db.Text
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("meeting_provider_status")
}

/// One database backup or restore drill, reported by the backup workflow (see docs/runbooks/backup-restore.md).
model BackupRun {
  id               String   @id @default(cuid())
  /// BACKUP | RESTORE_DRILL
  kind             String   @default("BACKUP")
  /// SUCCESS | FAILED
  status           String
  /// SCHEDULE | MANUAL
  trigger          String   @default("SCHEDULE")
  /// Object-storage URI of the dump (s3://bucket/key).
  location         String?
  sizeBytes        BigInt?  @map("size_bytes")
  checksumSha256   String?  @map("checksum_sha256")
  /// Server-side encryption was requested for the uploaded object.
  encrypted        Boolean  @default(false)
  retentionDeleted Int      @default(0) @map("retention_deleted")
  /// table -> row count, from the backup (BACKUP) or the restored database (RESTORE_DRILL).
  rowCounts        Json?    @map("row_counts")
  error            String?  @db.Text
  startedAt        DateTime @map("started_at")
  finishedAt       DateTime @map("finished_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([kind, status, finishedAt])
  @@map("backup_runs")
}

/// One security/quality scan of a project's files (lib/code-scan). The latest completed run is authoritative for the publish gate.
model ScanRun {
  id                String   @id @default(cuid())
  projectId         String   @map("project_id")
  triggeredById     String?  @map("triggered_by_id")
  /// MANUAL | PUBLISH | READINESS | ADMIN | SCHEDULED | REGRESSION
  trigger           String   @default("MANUAL")
  /// SCAN (security/quality scan) | REGRESSION (sandboxed tests/build check)
  kind              String   @default("SCAN")
  /// REGRESSION only: PASSED | FAILED | NOT_RUN. NOT_RUN never means passed.
  regressionStatus  String?  @map("regression_status")
  regressionCommand String?  @map("regression_command")
  /// Redacted, truncated command output (or the reason it could not run).
  regressionOutput  String?  @map("regression_output") @db.Text
  /// WORKING | STAGING | PRODUCTION
  source            String   @default("WORKING")
  filesScanned      Int      @default(0) @map("files_scanned")
  criticalCount     Int      @default(0) @map("critical_count")
  highCount         Int      @default(0) @map("high_count")
  mediumCount       Int      @default(0) @map("medium_count")
  lowCount          Int      @default(0) @map("low_count")
  /// OK | UNAVAILABLE | SKIPPED (no package.json). UNAVAILABLE never means "clean".
  depStatus         String   @default("SKIPPED") @map("dep_status")
  depDetail         String?  @map("dep_detail") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings ScanFinding[]

  @@index([projectId, createdAt])
  @@index([projectId, kind, createdAt])
  @@index([createdAt])
  @@map("scan_runs")
}

model ScanFinding {
  id            String    @id @default(cuid())
  runId         String    @map("run_id")
  projectId     String    @map("project_id")
  /// Stable across runs (rule + file + normalised evidence) so acknowledgements carry over.
  fingerprint   String
  rule          String
  /// SECRET | CODE | DEPENDENCY | ACCESSIBILITY | PERFORMANCE
  category      String
  /// CRITICAL | HIGH | MEDIUM | LOW | INFO
  severity      String
  file          String
  line          Int?
  title         String
  message       String    @db.Text
  /// Redacted excerpt; never contains a full secret.
  snippet       String?   @db.Text
  /// OPEN | ACKNOWLEDGED | FIXED
  status        String    @default("OPEN")
  ackReason     String?   @map("ack_reason") @db.Text
  ackById       String?   @map("ack_by_id")
  ackAt         DateTime? @map("ack_at")
  /// AI-proposed fix text. Never applied automatically.
  fixProposal   String?   @map("fix_proposal") @db.Text
  fixProposedAt DateTime? @map("fix_proposed_at")
  /// When this fingerprint was first reported; carried across runs so "open findings by age" is meaningful.
  firstSeenAt   DateTime? @map("first_seen_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  run ScanRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, severity])
  @@index([projectId, fingerprint])
  @@index([projectId, status])
  @@map("scan_findings")
}

// ---------------------------------------------------------------------------
// Privacy / data-subject rights (GDPR + POPIA). See docs/privacy/data-map.md.
// ---------------------------------------------------------------------------

/// Asynchronous account data export. The zip lives in object storage (storageKey) or, when no bucket is configured, in `data`.
model PrivacyExportJob {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  /// QUEUED | RUNNING | READY | FAILED | EXPIRED
  status        String    @default("QUEUED")
  createdAt     DateTime  @default(now()) @map("created_at")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  expiresAt     DateTime? @map("expires_at")
  storageKey    String?   @map("storage_key")
  data          Bytes?
  sizeBytes     Int?      @map("size_bytes")
  error         String?   @db.Text
  downloadCount Int       @default(0) @map("download_count")

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("privacy_export_jobs")
}

/// One row per user: account deletion with a grace period. The user row itself is anonymised (not removed) to keep billing records intact.
model PrivacyDeletionRequest {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  /// SCHEDULED | CANCELLED | PROCESSING | COMPLETED | FAILED
  status       String    @default("SCHEDULED")
  requestedAt  DateTime  @default(now()) @map("requested_at")
  scheduledFor DateTime  @map("scheduled_for")
  cancelledAt  DateTime? @map("cancelled_at")
  completedAt  DateTime? @map("completed_at")
  attempts     Int       @default(0)
  error        String?   @db.Text
  /// "user" | "admin" | "dsar"
  source       String    @default("user")

  @@index([status, scheduledFor])
  @@map("privacy_deletion_requests")
}

/// Data-subject request from a third party (lead, investor, messaging contact, meeting participant).
model PrivacyRequest {
  id              String    @id @default(cuid())
  /// ACCESS | ERASURE | RECTIFICATION | OBJECTION | OTHER
  type            String
  /// PENDING_VERIFICATION | OPEN | IN_PROGRESS | COMPLETED | REJECTED
  status          String    @default("PENDING_VERIFICATION")
  requesterName   String?   @map("requester_name")
  email           String?
  emailHash       String?   @map("email_hash")
  phone           String?
  phoneHash       String?   @map("phone_hash")
  details         String?   @db.Text
  verifyTokenHash String?   @unique @map("verify_token_hash")
  verifyExpiresAt DateTime? @map("verify_expires_at")
  verifiedAt      DateTime? @map("verified_at")
  receivedAt      DateTime  @default(now()) @map("received_at")
  /// 30 days from verified receipt.
  dueAt           DateTime? @map("due_at")
  completedAt     DateTime? @map("completed_at")
  /// FULFILLED | PARTIALLY_FULFILLED | NO_DATA_FOUND | REFUSED
  outcome         String?
  outcomeNote     String?   @map("outcome_note") @db.Text
  handledById     String?   @map("handled_by_id")
  ipHash          String?   @map("ip_hash")

  events PrivacyRequestEvent[]

  @@index([status, dueAt])
  @@index([emailHash])
  @@map("privacy_requests")
}

model PrivacyRequestEvent {
  id        String   @id @default(cuid())
  requestId String   @map("request_id")
  actorId   String?  @map("actor_id")
  action    String
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  request PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("privacy_request_events")
}

/// Configurable retention. A policy only purges when enabled; `dryRun` (default on) counts without deleting.
model PrivacyRetentionPolicy {
  key           String    @id
  retentionDays Int       @map("retention_days")
  enabled       Boolean   @default(false)
  dryRun        Boolean   @default(true) @map("dry_run")
  lastRunAt     DateTime? @map("last_run_at")
  lastRunCount  Int?      @map("last_run_count")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedById   String?   @map("updated_by_id")

  @@map("privacy_retention_policies")
}

/// Per-project scheduled re-scan (lib/code-scan/schedule). Deterministic scanning only, so it never spends credits.
model ScanSchedule {
  id          String    @id @default(cuid())
  projectId   String    @unique @map("project_id")
  enabled     Boolean   @default(true)
  /// DAILY | WEEKLY
  frequency   String    @default("WEEKLY")
  lastRunAt   DateTime? @map("last_run_at")
  nextRunAt   DateTime  @map("next_run_at")
  /// Why the last tick skipped or failed (for example the plan no longer includes scheduled scans).
  lastError   String?   @map("last_error")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
  @@map("scan_schedules")
}

/// Explicit owner approval for a risky production change (lib/code-scan/approvals). Mirrors the agent approval flow:
/// PENDING until a human decides, decided atomically once, always with a reason.
model ChangeApproval {
  id             String    @id @default(cuid())
  projectId      String    @map("project_id")
  /// PRODUCTION_PUBLISH
  kind           String    @default("PRODUCTION_PUBLISH")
  /// Stable hash of the risk set at request time; approval only covers that exact set.
  digest         String
  /// JSON array of { kind, summary } risks shown to the approver.
  risks          Json
  /// PENDING | APPROVED | REJECTED | CONSUMED | EXPIRED
  status         String    @default("PENDING")
  requestedById  String    @map("requested_by_id")
  decidedById    String?   @map("decided_by_id")
  decisionReason String?   @map("decision_reason") @db.Text
  decidedAt      DateTime? @map("decided_at")
  consumedAt     DateTime? @map("consumed_at")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, createdAt])
  @@map("change_approvals")
}

/// Monthly development-credit spending cap for a user or a workspace. Marketing wallets are separate and unaffected.
model CreditSpendLimit {
  id           String   @id @default(cuid())
  /// USER | WORKSPACE
  scope        String
  scopeId      String   @map("scope_id")
  monthlyLimit Int      @map("monthly_limit")
  setById      String?  @map("set_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([scope, scopeId])
  @@map("credit_spend_limits")
}

/// One row per (scope, month, threshold): the unique key makes 80%/100% alerts idempotent.
model CreditUsageAlert {
  id        String    @id @default(cuid())
  /// USER | WORKSPACE | ALLOWANCE
  scope     String
  scopeId   String    @map("scope_id")
  /// Who is notified (the limit owner / workspace owner).
  userId    String    @map("user_id")
  /// UTC calendar month, YYYY-MM.
  period    String
  threshold Int
  spent     Int
  cap       Int
  emailedAt DateTime? @map("emailed_at")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([scope, scopeId, period, threshold])
  @@index([userId, readAt, createdAt])
  @@map("credit_usage_alerts")
}

/// Compensating record for an admin refund/reversal of one ledger entry (the ledger itself is append-only).
model LedgerReversal {
  id             String   @id @default(cuid())
  /// DEV | MARKETING
  ledger         String
  entryId        String   @map("entry_id")
  userId         String   @map("user_id")
  credits        Int
  reason         String   @db.Text
  adminId        String   @map("admin_id")
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([ledger, entryId])
  @@index([userId, createdAt])
  @@map("ledger_reversals")
}

/// Invoice mirror synced from Stripe webhooks / API. Never created locally.
model StripeInvoice {
  id                   String    @id
  userId               String?   @map("user_id")
  customerId           String    @map("customer_id")
  subscriptionId       String?   @map("subscription_id")
  number               String?
  status               String
  currency             String
  amountDueCents       Int       @map("amount_due_cents")
  amountPaidCents      Int       @map("amount_paid_cents")
  amountRemainingCents Int       @map("amount_remaining_cents")
  hostedInvoiceUrl     String?   @map("hosted_invoice_url") @db.Text
  invoicePdfUrl        String?   @map("invoice_pdf_url") @db.Text
  billingReason        String?   @map("billing_reason")
  description          String?   @db.Text
  planId               String?   @map("plan_id")
  periodStart          DateTime? @map("period_start")
  periodEnd            DateTime? @map("period_end")
  attemptCount         Int       @default(0) @map("attempt_count")
  nextPaymentAttemptAt DateTime? @map("next_payment_attempt_at")
  paidAt               DateTime? @map("paid_at")
  stripeCreatedAt      DateTime  @map("stripe_created_at")
  lastEventAt          DateTime  @map("last_event_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([userId, stripeCreatedAt])
  @@index([status, stripeCreatedAt])
  @@index([customerId])
  @@map("stripe_invoices")
}

/// Current state of each Stripe subscription (webhook-synced); MRR is the list price normalised to one month.
model StripeSubscription {
  id                String    @id
  userId            String?   @map("user_id")
  customerId        String    @map("customer_id")
  status            String
  planId            String?   @map("plan_id")
  interval          String
  intervalCount     Int       @default(1) @map("interval_count")
  unitAmountCents   Int       @map("unit_amount_cents")
  quantity          Int       @default(1)
  currency          String
  /// 0 whenever the subscription is not active, trialing or past_due.
  mrrCents          Int       @map("mrr_cents")
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  currentPeriodEnd  DateTime? @map("current_period_end")
  startedAt         DateTime  @map("started_at")
  endedAt           DateTime? @map("ended_at")
  lastEventAt       DateTime  @map("last_event_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([userId])
  @@index([currentPeriodEnd])
  @@map("stripe_subscriptions")
}

/// Append-only MRR history per subscription: powers the trend line, churn and net revenue retention.
model StripeSubscriptionMrrChange {
  id             String   @id @default(cuid())
  subscriptionId String   @map("subscription_id")
  userId         String?  @map("user_id")
  planId         String?  @map("plan_id")
  currency       String
  mrrCents       Int      @map("mrr_cents")
  effectiveAt    DateTime @map("effective_at")
  stripeEventId  String   @map("stripe_event_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([subscriptionId, stripeEventId])
  @@index([subscriptionId, effectiveAt])
  @@index([effectiveAt])
  @@map("stripe_subscription_mrr_changes")
}

/// Latest refunded total per Stripe charge (from charge.refunded); used for net revenue.
model StripeChargeRefund {
  chargeId            String   @id @map("charge_id")
  paymentIntentId     String?  @map("payment_intent_id")
  invoiceId           String?  @map("invoice_id")
  customerId          String?  @map("customer_id")
  userId              String?  @map("user_id")
  amountRefundedCents Int      @map("amount_refunded_cents")
  currency            String
  lastEventAt         DateTime @map("last_event_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("stripe_charge_refunds")
}

/// Per-customer billing state driven by webhooks (dunning banner, invoice cache freshness).
model BillingCustomerState {
  userId                 String    @id @map("user_id")
  paymentFailedAt        DateTime? @map("payment_failed_at")
  paymentFailedInvoiceId String?   @map("payment_failed_invoice_id")
  paymentFailedEventAt   DateTime? @map("payment_failed_event_at")
  paymentFailedAttempts  Int       @default(0) @map("payment_failed_attempts")
  invoicesSyncedAt       DateTime? @map("invoices_synced_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("billing_customer_states")
}

/// AI diagnosis of a failed build/deploy/regression. Input is redacted before storage; the fix is text only, never applied.
model BugDiagnosis {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  /// REGRESSION | BUILD | DEPLOY
  source      String
  /// Redacted, truncated log excerpt that was sent to the model.
  input       String   @db.Text
  diagnosis   String   @db.Text
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("bug_diagnoses")
}

// ---------------------------------------------------------------------------
// Integrations marketplace (lib/integrations)
// ---------------------------------------------------------------------------

/// One connected third-party service per project and catalogue entry. Credentials live only in `secretEnc`
/// (AES-GCM secret box) and in the project's server-side env vars; they are never sent back to the client.
model IntegrationConnection {
  id                String    @id @default(cuid())
  projectId         String    @map("project_id")
  /// Catalogue id (lib/integrations/catalogue).
  integrationId     String    @map("integration_id")
  /// Non-secret configuration (hosts, allowed methods/paths, timeouts).
  config            Json      @default("{}")
  /// Encrypted JSON of the credential fields.
  secretEnc         String    @map("secret_enc") @db.Text
  /// Masked hint per secret field, e.g. {"apiKey":"…a1b2"}.
  maskedHints       Json      @default("{}") @map("masked_hints")
  /// CONNECTED | ERROR
  status            String    @default("CONNECTED")
  /// UNKNOWN | HEALTHY | DEGRADED | DOWN
  healthStatus      String    @default("UNKNOWN") @map("health_status")
  lastTestAt        DateTime? @map("last_test_at")
  lastTestOk        Boolean?  @map("last_test_ok")
  lastTestLatencyMs Int?      @map("last_test_latency_ms")
  lastTestError     String?   @map("last_test_error")
  lastUsedAt        DateTime? @map("last_used_at")
  usageCount        Int       @default(0) @map("usage_count")
  /// Estimated spend in thousandths of a cent (we only meter what we proxy).
  estCostMicros     Int       @default(0) @map("est_cost_micros")
  createdById       String?   @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  project Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checks  IntegrationHealthCheck[]
  logs    IntegrationApiLog[]

  @@unique([projectId, integrationId])
  @@index([integrationId, healthStatus])
  @@map("integration_connections")
}

model IntegrationHealthCheck {
  id            String   @id @default(cuid())
  connectionId  String   @map("connection_id")
  projectId     String   @map("project_id")
  integrationId String   @map("integration_id")
  ok            Boolean
  latencyMs     Int      @map("latency_ms")
  error         String?
  createdAt     DateTime @default(now()) @map("created_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@index([createdAt])
  @@map("integration_health_checks")
}

/// Admin kill-switch for a catalogue entry (new connections and proxy calls are refused while disabled).
model IntegrationCatalogueOverride {
  integrationId String   @id @map("integration_id")
  disabled      Boolean  @default(false)
  reason        String?
  updatedById   String?  @map("updated_by_id")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("integration_catalogue_overrides")
}

/// Request log for the server-side API proxy. Never contains headers, bodies or query strings.
model IntegrationApiLog {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  connectionId  String   @map("connection_id")
  method        String
  host          String
  path          String
  status        Int?
  durationMs    Int      @map("duration_ms")
  responseBytes Int      @default(0) @map("response_bytes")
  error         String?
  createdAt     DateTime @default(now()) @map("created_at")

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([connectionId, createdAt])
  @@map("integration_api_logs")
}

/// Inbound webhook receiver for a generated app: HMAC-SHA256 over `${timestamp}.${body}`, replay window, idempotent by event id.
model InboundWebhookEndpoint {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  /// Public path token (not a secret on its own).
  publicId  String   @unique @map("public_id")
  secretEnc String   @map("secret_enc") @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  project Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  InboundWebhookEvent[]

  @@index([projectId])
  @@map("inbound_webhook_endpoints")
}

model InboundWebhookEvent {
  id         String   @id @default(cuid())
  endpointId String   @map("endpoint_id")
  /// Sender-supplied idempotency key (X-Webhook-Id).
  eventId    String   @map("event_id")
  payload    String   @db.Text
  receivedAt DateTime @default(now()) @map("received_at")

  endpoint InboundWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([endpointId, receivedAt])
  @@map("inbound_webhook_events")
}

/// Outbound subscription: we POST signed events from the generated app to `url`.
model WebhookSubscription {
  id                  String   @id @default(cuid())
  projectId           String   @map("project_id")
  url                 String
  secretEnc           String   @map("secret_enc") @db.Text
  /// Event names, or ["*"].
  events              String[]
  active              Boolean  @default(true)
  consecutiveFailures Int      @default(0) @map("consecutive_failures")
  createdAt           DateTime @default(now()) @map("created_at")

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([projectId])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String    @id @default(cuid())
  subscriptionId String    @map("subscription_id")
  projectId      String    @map("project_id")
  event          String
  payload        String    @db.Text
  /// PENDING | SUCCESS | FAILED
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime? @map("next_attempt_at")
  lastStatusCode Int?      @map("last_status_code")
  lastError      String?   @map("last_error")
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([projectId, createdAt])
  @@map("webhook_deliveries")
}

// -----------------------------------------------------------------------------
// Persistent AI project memory (lib/project-memory)
// -----------------------------------------------------------------------------

enum ProjectMemoryType {
  ARCHITECTURE
  DECISION
  BUSINESS_RULE
  CONVENTION
  KNOWN_BUG
  FIXED_BUG
  FEATURE_STATUS
  INTEGRATION
  DESIGN
}

enum ProjectMemorySource {
  AGENT
  USER
  SYSTEM
}

enum ProjectMemoryStatus {
  ACTIVE
  SUPERSEDED
  REJECTED
}

/// A durable fact about a project that the build agent reads before changing it. Text only; secrets are rejected on write.
model ProjectMemory {
  id              String              @id @default(cuid())
  projectId       String              @map("project_id")
  type            ProjectMemoryType
  title           String
  normalizedTitle String              @map("normalized_title")
  body            String              @db.Text
  source          ProjectMemorySource @default(AGENT)
  /// { files?: string[], checkpointId?: string, messageId?: string }
  evidence        Json?
  confidence      Float               @default(0.7)
  status          ProjectMemoryStatus @default(ACTIVE)
  pinned          Boolean             @default(false)
  /// FEATURE_STATUS only: COMPLETED or PROTECTED. Protected features trigger the regression guard.
  featureState    String?             @map("feature_state")
  /// Project-relative files that belong to the feature (used by the regression guard).
  files           String[]
  supersededById  String?             @map("superseded_by_id")
  createdById     String?             @map("created_by_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, type])
  @@index([projectId, normalizedTitle])
  @@index([projectId, pinned])
  @@map("project_memories")
}

/// Per-file summary refreshed incrementally when the content hash changes.
model ProjectCodeMapEntry {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  path          String
  contentHash   String   @map("content_hash")
  purpose       String   @db.Text
  exports       String[]
  routes        String[]
  dependencies  String[]
  /// STATIC (deterministic extraction) or LLM (model-written purpose).
  summarySource String   @default("STATIC") @map("summary_source")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId, updatedAt])
  @@map("project_code_map_entries")
}

/// What was injected into an agent run, kept for transparency. Only the most recent rows per project are retained.
model ProjectMemoryInjection {
  id             String   @id @default(cuid())
  projectId      String   @map("project_id")
  conversationId String?  @map("conversation_id")
  request        String   @db.Text
  brief          String   @db.Text
  memoryIds      String[] @map("memory_ids")
  tokenEstimate  Int      @map("token_estimate")
  protectedFiles String[] @map("protected_files")
  /// Protected features whose files were edited without being acknowledged in the run summary.
  unacknowledged String[]
  createdAt      DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_memory_injections")
}

// -----------------------------------------------------------------------------
// Team collaboration (lib/team): fine-grained roles, invitations, task board,
// approvals, notifications, per-member marketing spend. Ids that point at
// User / Workspace / Project are plain strings: tenant scoping is enforced in lib/team.
// -----------------------------------------------------------------------------

enum TeamRole {
  OWNER
  ADMIN
  DEVELOPER
  DESIGNER
  MARKETER
  BUSINESS_PARTNER
  VIEWER
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum BoardTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BoardLinkKind {
  CHAT_PROMPT
  CHECKPOINT
  CAMPAIGN
  DEPLOYMENT
}

enum TeamApprovalKind {
  PUBLISH
  MARKETING_CAMPAIGN
  SPEND
  OTHER
}

enum TeamApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Refines the legacy WorkspaceRole / ProjectRole membership with a team role. `scopeKey` is `ws` for the whole
/// workspace or `p:<projectId>` for one project, so (user, workspace, scope) is unique.
model TeamRoleAssignment {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  projectId    String?  @map("project_id")
  scopeKey     String   @map("scope_key")
  userId       String   @map("user_id")
  role         TeamRole
  assignedById String?  @map("assigned_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, scopeKey, userId])
  @@index([userId])
  @@index([projectId])
  @@map("team_role_assignments")
}

/// Signed, expiring email invitation. `tokenVersion` is bumped on resend so older links stop working.
model TeamInvitation {
  id           String               @id @default(cuid())
  workspaceId  String               @map("workspace_id")
  projectId    String?              @map("project_id")
  email        String
  role         TeamRole
  status       TeamInvitationStatus @default(PENDING)
  tokenVersion Int                  @default(1) @map("token_version")
  invitedById  String               @map("invited_by_id")
  expiresAt    DateTime             @map("expires_at")
  acceptedById String?              @map("accepted_by_id")
  acceptedAt   DateTime?            @map("accepted_at")
  revokedAt    DateTime?            @map("revoked_at")
  lastSentAt   DateTime?            @map("last_sent_at")
  createdAt    DateTime             @default(now()) @map("created_at")

  @@index([workspaceId, status])
  @@index([projectId, status])
  @@index([email])
  @@map("team_invitations")
}

model BoardColumn {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  position  Int
  /// Tasks in a done column count as finished.
  isDone    Boolean  @default(false) @map("is_done")
  createdAt DateTime @default(now()) @map("created_at")

  tasks BoardTask[]

  @@index([projectId, position])
  @@map("board_columns")
}

model BoardTask {
  id          String            @id @default(cuid())
  projectId   String            @map("project_id")
  columnId    String            @map("column_id")
  title       String
  description String?           @db.Text
  assigneeId  String?           @map("assignee_id")
  labels      String[]
  priority    BoardTaskPriority @default(MEDIUM)
  dueDate     DateTime?         @map("due_date")
  sprint      String?
  /// Fractional order inside the column; rebalanced when gaps get too small.
  position    Float
  /// Bumped on every change; clients send the version they saw to detect conflicting edits.
  version     Int               @default(1)
  createdById String            @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  column    BoardColumn           @relation(fields: [columnId], references: [id], onDelete: Cascade)
  comments  BoardTaskComment[]
  links     BoardTaskLink[]
  approvals TeamApprovalRequest[]

  @@index([projectId, columnId, position])
  @@index([projectId, assigneeId])
  @@map("board_tasks")
}

model BoardTaskComment {
  id        String    @id @default(cuid())
  projectId String    @map("project_id")
  taskId    String    @map("task_id")
  authorId  String    @map("author_id")
  body      String    @db.Text
  /// User ids resolved from @mentions (only project members).
  mentions  String[]
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  task BoardTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([projectId])
  @@map("board_task_comments")
}

model BoardTaskLink {
  id        String        @id @default(cuid())
  projectId String        @map("project_id")
  taskId    String        @map("task_id")
  kind      BoardLinkKind
  refId     String        @map("ref_id")
  label     String
  createdAt DateTime      @default(now()) @map("created_at")

  task BoardTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, kind, refId])
  @@index([projectId])
  @@map("board_task_links")
}

/// Human sign-off for publishing, a marketing campaign or spend. Decided exactly once, always with a reason on rejection.
model TeamApprovalRequest {
  id             String             @id @default(cuid())
  projectId      String             @map("project_id")
  taskId         String?            @map("task_id")
  kind           TeamApprovalKind
  title          String
  details        String?            @db.Text
  amountCredits  Int?               @map("amount_credits")
  status         TeamApprovalStatus @default(PENDING)
  requestedById  String             @map("requested_by_id")
  decidedById    String?            @map("decided_by_id")
  decisionReason String?            @map("decision_reason") @db.Text
  decidedAt      DateTime?          @map("decided_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  task BoardTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@map("team_approval_requests")
}

model UserNotification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  projectId String?   @map("project_id")
  /// MENTION | ASSIGNMENT | APPROVAL_REQUESTED | APPROVAL_DECIDED | INVITATION
  kind      String
  title     String
  body      String?   @db.Text
  href      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("user_notifications")
}

model NotificationPreference {
  id     String  @id @default(cuid())
  userId String  @map("user_id")
  kind   String
  inApp  Boolean @default(true) @map("in_app")
  email  Boolean @default(true)

  @@unique([userId, kind])
  @@map("notification_preferences")
}

/// Monthly marketing-credit cap for one workspace member, spent from the shared (owner) wallet.
model MemberSpendLimit {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  userId       String   @map("user_id")
  monthlyLimit Int      @map("monthly_limit")
  setById      String?  @map("set_by_id")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@map("member_spend_limits")
}

/// Who spent shared marketing credits. `ledgerKey` is the MarketingReservation / MarketingLedger idempotency key.
model WorkspaceUsageEvent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  projectId   String?  @map("project_id")
  operation   String
  credits     Int
  ledgerKey   String   @unique @map("ledger_key")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([workspaceId, userId, createdAt])
  @@map("workspace_usage_events")
}

// -----------------------------------------------------------------------------
// Business intelligence & growth attribution (lib/growth-bi). No raw IPs or
// user-agents are stored; visitor ids are random values from a signed,
// consent-gated first-party cookie.
// -----------------------------------------------------------------------------

/// One consented landing on AppWeaver's own marketing site (first-party, no third-party trackers).
model GrowthVisit {
  id           String   @id @default(cuid())
  visitorId    String   @map("visitor_id")
  channel      String
  source       String?
  medium       String?
  campaign     String?
  content      String?
  term         String?
  referrerHost String?  @map("referrer_host")
  landingPath  String   @map("landing_path")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([channel, createdAt])
  @@index([visitorId])
  @@map("growth_visits")
}

/// First- and last-touch attribution captured once at sign-up from the signed cookie.
model GrowthAttribution {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  visitorId          String?  @map("visitor_id")
  firstChannel       String   @map("first_channel")
  firstSource        String?  @map("first_source")
  firstMedium        String?  @map("first_medium")
  firstCampaign      String?  @map("first_campaign")
  firstContent       String?  @map("first_content")
  firstReferrerHost  String?  @map("first_referrer_host")
  firstLandingPath   String?  @map("first_landing_path")
  firstAt            DateTime @map("first_at")
  lastChannel        String   @map("last_channel")
  lastSource         String?  @map("last_source")
  lastMedium         String?  @map("last_medium")
  lastCampaign       String?  @map("last_campaign")
  lastContent        String?  @map("last_content")
  lastReferrerHost   String?  @map("last_referrer_host")
  lastLandingPath    String?  @map("last_landing_path")
  lastAt             DateTime @map("last_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([firstChannel])
  @@index([lastChannel])
  @@index([createdAt])
  @@map("growth_attributions")
}

/// Typed product-feature usage event (closed registry in lib/growth-bi/events.ts). One row per user, feature, project and day.
model GrowthFeatureEvent {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String
  projectKey String   @default("") @map("project_key")
  day        String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, name, projectKey, day])
  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@map("growth_feature_events")
}

/// UTM links generated by admins (house ads, social posts, investor outreach, other), so campaigns resolve to a kind.
model GrowthLink {
  id          String   @id @default(cuid())
  createdById String   @map("created_by_id")
  label       String
  kind        String
  refId       String?  @map("ref_id")
  baseUrl     String   @map("base_url")
  source      String
  medium      String
  campaign    String
  content     String?
  term        String?
  url         String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([campaign])
  @@map("growth_links")
}

/// Small admin-editable settings (e.g. the activation definition).
model GrowthConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("growth_config")
}

/// Nightly aggregates. Idempotent: the natural key is unique and every run upserts.
model GrowthRollup {
  id        String   @id @default(cuid())
  scopeType String   @map("scope_type")
  scopeId   String   @map("scope_id")
  day       DateTime @db.Date
  dimension String
  dimKey    String   @default("") @map("dim_key")
  metric    String
  value     Float
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([scopeType, scopeId, day, dimension, dimKey, metric])
  @@index([scopeType, scopeId, day])
  @@map("growth_rollups")
}

/// Anomaly (sudden drop/spike) found by the nightly job. One per scope, metric and day.
model GrowthAlert {
  id         String    @id @default(cuid())
  scopeType  String    @map("scope_type")
  scopeId    String    @map("scope_id")
  metric     String
  day        DateTime  @db.Date
  kind       String
  observed   Float
  expected   Float
  message    String
  notifiedAt DateTime? @map("notified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([scopeType, scopeId, metric, day])
  @@index([scopeType, scopeId, createdAt])
  @@map("growth_alerts")
}

/// AI recommendation grounded in computed metrics. `evidence` is computed by us from `metricIds`, never by the model.
model GrowthRecommendation {
  id               String   @id @default(cuid())
  scopeType        String   @map("scope_type")
  scopeId          String   @map("scope_id")
  title            String
  rationale        String   @db.Text
  metricIds        String[] @map("metric_ids")
  evidence         Json
  proposedAction   Json     @map("proposed_action")
  status           String   @default("PROPOSED")
  agentActivityId  String?  @map("agent_activity_id")
  createdById      String?  @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([scopeType, scopeId, createdAt])
  @@map("growth_recommendations")
}

// ---------------------------------------------------------------------------
// Template & component marketplace. User/project ids are plain strings (no FK) like the growth models, so the
// shared User/Project models stay untouched; every query is scoped in lib/marketplace.
// ---------------------------------------------------------------------------

enum MarketplaceAssetType {
  TEMPLATE
  COMPONENT
  INTEGRATION
  WORKFLOW
  STARTER_KIT
}

enum MarketplaceAssetStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  REMOVED
}

enum MarketplacePayoutStatus {
  NOT_CONFIGURED
  ONBOARDING
  ENABLED
  SUSPENDED
}

enum MarketplaceOrderStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum MarketplaceLedgerKind {
  EARNING
  REFUND_REVERSAL
  PAYOUT
  ADJUSTMENT
}

enum MarketplaceReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

/// A user's creator profile. Payouts stay NOT_CONFIGURED until Stripe Connect is set up by the owner.
model MarketplaceCreator {
  id                     String                  @id @default(cuid())
  userId                 String                  @unique @map("user_id")
  slug                   String                  @unique
  displayName            String                  @map("display_name")
  bio                    String?
  payoutStatus           MarketplacePayoutStatus @default(NOT_CONFIGURED) @map("payout_status")
  stripeConnectAccountId String?                 @map("stripe_connect_account_id")
  termsAcceptedAt        DateTime                @map("terms_accepted_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  assets MarketplaceAsset[]
  ledger MarketplacePayoutLedger[]

  @@map("marketplace_creators")
}

model MarketplaceAsset {
  id                String                 @id @default(cuid())
  creatorId         String?                @map("creator_id")
  isFirstParty      Boolean                @default(false) @map("is_first_party")
  type              MarketplaceAssetType
  slug              String                 @unique
  title             String
  summary           String
  description       String                 @db.Text
  tags              String[]
  status            MarketplaceAssetStatus @default(DRAFT)
  priceCents        Int                    @default(0) @map("price_cents")
  currency          String                 @default("usd")
  license           String
  publishedVersion  Int?                   @map("published_version")
  statusReason      String?                @map("status_reason")
  reviewedById      String?                @map("reviewed_by_id")
  reviewedAt        DateTime?              @map("reviewed_at")
  publishedAt       DateTime?              @map("published_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  creator  MarketplaceCreator?       @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  versions MarketplaceAssetVersion[]
  installs MarketplaceInstall[]
  reviews  MarketplaceReview[]
  orders   MarketplaceOrder[]
  reports  MarketplaceReport[]

  @@index([status, type, publishedAt])
  @@index([creatorId, status])
  @@map("marketplace_assets")
}

/// Immutable once written: the bundle and checksum are protected by a database trigger (see the migration).
model MarketplaceAssetVersion {
  id           String                 @id @default(cuid())
  assetId      String                 @map("asset_id")
  version      Int
  changelog    String?
  bundle       Json
  checksum     String
  sizeBytes    Int                    @map("size_bytes")
  fileCount    Int                    @map("file_count")
  status       MarketplaceAssetStatus @default(PENDING_REVIEW)
  scanVerdict  String                 @map("scan_verdict")
  scanFindings Json                   @map("scan_findings")
  reviewNotes  String?                @map("review_notes")
  createdAt    DateTime               @default(now()) @map("created_at")

  asset    MarketplaceAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  installs MarketplaceInstall[]
  orders   MarketplaceOrder[]

  @@unique([assetId, version])
  @@map("marketplace_asset_versions")
}

model MarketplaceInstall {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  projectId      String   @map("project_id")
  assetId        String   @map("asset_id")
  versionId      String   @map("version_id")
  version        Int
  artifactSlug   String   @map("artifact_slug")
  targetDir      String   @map("target_dir")
  filesWritten   String[]  @map("files_written")
  createdAt      DateTime @default(now()) @map("created_at")

  asset        MarketplaceAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetVersion MarketplaceAssetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([projectId, assetId, versionId])
  @@index([userId, createdAt])
  @@index([assetId])
  @@map("marketplace_installs")
}

/// One review per user per asset. Only people who installed or bought the asset may write one (enforced in lib/marketplace/reviews.ts).
model MarketplaceReview {
  id        String   @id @default(cuid())
  assetId   String   @map("asset_id")
  userId    String   @map("user_id")
  rating    Int
  body      String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  asset MarketplaceAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, userId])
  @@map("marketplace_reviews")
}

/// One-time purchase. The fee split is frozen on the row at payment time (basis points; 100 bps = 1%).
model MarketplaceOrder {
  id               String                 @id @default(cuid())
  userId           String                 @map("user_id")
  assetId          String                 @map("asset_id")
  versionId        String                 @map("version_id")
  status           MarketplaceOrderStatus @default(PENDING)
  amountCents      Int                    @map("amount_cents")
  currency         String
  platformFeeBps   Int?                   @map("platform_fee_bps")
  platformFeeCents Int                    @default(0) @map("platform_fee_cents")
  creatorShareCents Int                   @default(0) @map("creator_share_cents")
  refundedCents    Int                    @default(0) @map("refunded_cents")
  stripeSessionId  String                 @unique @map("stripe_session_id")
  paymentIntentId  String?                @unique @map("payment_intent_id")
  stripeEventId    String?                @map("stripe_event_id")
  paidAt           DateTime?              @map("paid_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  asset        MarketplaceAsset          @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assetVersion MarketplaceAssetVersion   @relation(fields: [versionId], references: [id], onDelete: Restrict)
  ledger       MarketplacePayoutLedger[]

  @@index([userId, assetId, status])
  @@map("marketplace_orders")
}

/// Append-only creator earnings. Positive = owed to the creator, negative = reversal or payout. No payout row is written until Stripe Connect transfers are implemented.
model MarketplacePayoutLedger {
  id             String                @id @default(cuid())
  creatorId      String                @map("creator_id")
  orderId        String?               @map("order_id")
  kind           MarketplaceLedgerKind
  amountCents    Int                   @map("amount_cents")
  currency       String
  idempotencyKey String                @unique @map("idempotency_key")
  note           String?
  createdAt      DateTime              @default(now()) @map("created_at")

  creator MarketplaceCreator @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  order   MarketplaceOrder?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([creatorId, createdAt])
  @@map("marketplace_payout_ledger")
}

model MarketplaceReport {
  id           String                  @id @default(cuid())
  assetId      String                  @map("asset_id")
  reporterId   String                  @map("reporter_id")
  reason       String
  details      String
  status       MarketplaceReportStatus @default(OPEN)
  resolvedById String?                 @map("resolved_by_id")
  resolvedAt   DateTime?               @map("resolved_at")
  createdAt    DateTime                @default(now()) @map("created_at")

  asset MarketplaceAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, reporterId])
  @@index([status, createdAt])
  @@map("marketplace_reports")
}

// -----------------------------------------------------------------------------
// Mobile application delivery. Rows reference projects by plain id (no FK, so no
// back-relation on Project); lib/projects/cleanup.ts removes them with the project.
// -----------------------------------------------------------------------------

enum MobilePlatform {
  ANDROID
  IOS
  PWA
}

enum MobileBuildStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  /// A native build that cannot run here: no runner, missing credentials or missing platform tooling. Never a success.
  BLOCKED
}

enum MobileStore {
  GOOGLE_PLAY
  APP_STORE_CONNECT
}

/// One delivery attempt. Only PWA bundles and Capacitor project bundles are produced here; native binaries need an external runner.
model MobileBuild {
  id             String            @id @default(cuid())
  projectId      String            @map("project_id")
  artifactSlug   String            @map("artifact_slug")
  platform       MobilePlatform
  status         MobileBuildStatus
  /// PWA_BUNDLE | CAPACITOR_PROJECT | NATIVE_BINARY
  artifactKind   String            @map("artifact_kind")
  versionName    String            @map("version_name")
  buildNumber    Int               @map("build_number")
  statusReason   String?           @map("status_reason") @db.Text
  logs           String            @default("") @db.Text
  readinessScore Int?              @map("readiness_score")
  artifactName   String?           @map("artifact_name")
  artifactSize   Int?              @map("artifact_size")
  artifactSha256 String?           @map("artifact_sha256")
  /// Zip bytes for generated bundles (size capped in lib/mobile). Never selected in list queries.
  artifactData   Bytes?            @map("artifact_data")
  /// Job id at the external runner, when one accepted the build.
  externalJobId  String?           @map("external_job_id")
  createdById    String            @map("created_by_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  finishedAt     DateTime?         @map("finished_at")

  @@unique([projectId, platform, buildNumber])
  @@index([projectId, createdAt])
  @@map("mobile_builds")
}

/// Encrypted store account credentials. `encryptedPayload` (secret-box) is never returned to the client; `hint` is a non-secret label.
model MobileStoreCredential {
  id               String      @id @default(cuid())
  projectId        String      @map("project_id")
  store            MobileStore
  encryptedPayload String      @map("encrypted_payload") @db.Text
  hint             String
  createdById      String      @map("created_by_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@unique([projectId, store])
  @@map("mobile_store_credentials")
}

model MobileStoreListing {
  id               String      @id @default(cuid())
  projectId        String      @map("project_id")
  store            MobileStore
  appName          String      @map("app_name")
  /// Reverse-DNS application id / bundle id, e.g. com.example.app.
  bundleId         String      @map("bundle_id")
  shortDescription String      @default("") @map("short_description")
  description      String      @default("") @db.Text
  category         String      @default("")
  keywords         String      @default("")
  privacyUrl       String      @default("") @map("privacy_url")
  supportUrl       String      @default("") @map("support_url")
  /// Store rating questionnaire result, e.g. EVERYONE | TEEN | MATURE.
  ageRating        String      @default("") @map("age_rating")
  screenshotRefs   String[]    @map("screenshot_refs")
  updatedById      String      @map("updated_by_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@unique([projectId, store])
  @@map("mobile_store_listings")
}

/// Manual completion state for submission checklist items that cannot be verified automatically.
model MobileChecklistItem {
  id          String      @id @default(cuid())
  projectId   String      @map("project_id")
  store       MobileStore
  itemKey     String      @map("item_key")
  done        Boolean     @default(false)
  updatedById String      @map("updated_by_id")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@unique([projectId, store, itemKey])
  @@map("mobile_checklist_items")
}

// ---------------------------------------------------------------------------
// AI development team (lib/dev-team). Plain projectId columns (no Project relation): rows are removed by
// lib/dev-team when a project is purged; nothing here is ever applied to project files without a human approval.
// ---------------------------------------------------------------------------

enum DevTeamRole {
  ARCHITECT
  FRONTEND
  BACKEND
  DATABASE
  TESTING
  SECURITY
  DEVOPS
}

enum DevTeamRunStatus {
  PLANNING
  RUNNING
  NEEDS_DECISION
  AWAITING_APPROVAL
  APPLIED
  REJECTED
  FAILED
  CANCELLED
}

enum DevTeamTaskStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
  CANCELLED
}

enum DevTeamChangeOp {
  CREATE
  MODIFY
  DELETE
}

enum DevTeamMergeStatus {
  CLEAN
  MERGED
  CONFLICT
  RESOLVED
  STALE
  APPLIED
}

model DevTeamRun {
  id               String           @id @default(cuid())
  projectId        String           @map("project_id")
  artifactSlug     String           @map("artifact_slug")
  goal             String           @db.Text
  status           DevTeamRunStatus @default(PLANNING)
  requestedById    String           @map("requested_by_id")
  /// Placeholder-priced estimate shown before the run (see lib/dev-team/credits.ts).
  estimatedCredits Int              @default(0) @map("estimated_credits")
  reservedCredits  Int              @default(0) @map("reserved_credits")
  spentCredits     Int              @default(0) @map("spent_credits")
  /// Ledger idempotency key of the reservation; null when the user is not credit-metered.
  creditKey        String?          @unique @map("credit_key")
  planSummary      String?          @map("plan_summary") @db.Text
  error            String?          @db.Text
  /// Result of the pre-apply verification (scan + regression status). Null until verified.
  verification     Json?
  verifiedAt       DateTime?        @map("verified_at")
  decidedById      String?          @map("decided_by_id")
  decisionReason   String?          @map("decision_reason")
  decidedAt        DateTime?        @map("decided_at")
  appliedAt        DateTime?        @map("applied_at")
  startedAt        DateTime?        @map("started_at")
  finishedAt       DateTime?        @map("finished_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  tasks     DevTeamTask[]
  proposals DevTeamChangeProposal[]
  messages  DevTeamMessage[]
  files     DevTeamMergedFile[]

  @@index([projectId, createdAt])
  @@index([status, updatedAt])
  @@map("dev_team_runs")
}

model DevTeamTask {
  id         String            @id @default(cuid())
  runId      String            @map("run_id")
  /// Short id inside the run (t1, t2, ...); dependsOn refers to these keys.
  key        String
  role       DevTeamRole
  title      String
  description String           @default("") @db.Text
  status     DevTeamTaskStatus @default(PENDING)
  dependsOn  String[]          @map("depends_on")
  /// Planner hints: files the task should read.
  input      Json?
  /// { summary, notes } produced by the role; raw model text is never stored.
  output     Json?
  attempts   Int               @default(0)
  error      String?           @db.Text
  startedAt  DateTime?         @map("started_at")
  finishedAt DateTime?         @map("finished_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  run       DevTeamRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  proposals DevTeamChangeProposal[]

  @@unique([runId, key])
  @@index([runId, status])
  @@map("dev_team_tasks")
}

/// One proposed change to one file by one task. `baseHash` is the sha256 of the file when the role read it.
model DevTeamChangeProposal {
  id              String          @id @default(cuid())
  runId           String          @map("run_id")
  taskId          String          @map("task_id")
  role            DevTeamRole
  path            String
  op              DevTeamChangeOp
  baseHash        String?         @map("base_hash")
  baseContent     String?         @map("base_content") @db.Text
  proposedContent String?         @map("proposed_content") @db.Text
  rationale       String          @default("") @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")

  run  DevTeamRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  task DevTeamTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([runId, path])
  @@index([taskId])
  @@map("dev_team_change_proposals")
}

/// Shared context log between roles (handoffs, questions, conflict notes, system events).
model DevTeamMessage {
  id        String       @id @default(cuid())
  runId     String       @map("run_id")
  taskId    String?      @map("task_id")
  /// Null for system or human messages.
  role      DevTeamRole?
  kind      String       @default("NOTE")
  content   String       @db.Text
  createdAt DateTime     @default(now()) @map("created_at")

  run DevTeamRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@map("dev_team_messages")
}

/// Per-file result of merging every proposal for that file. Applying uses `finalContent` only after approval.
model DevTeamMergedFile {
  id           String             @id @default(cuid())
  runId        String             @map("run_id")
  path         String
  op           DevTeamChangeOp
  status       DevTeamMergeStatus
  baseHash     String?            @map("base_hash")
  baseContent  String?            @map("base_content") @db.Text
  finalContent String?            @map("final_content") @db.Text
  proposalIds  String[]           @map("proposal_ids")
  /// { reason, details[] } while status is CONFLICT or STALE.
  conflict     Json?
  /// Resolver-step suggestion; never used until a human accepts it.
  suggestion   String?            @db.Text
  resolution   String?
  resolvedById String?            @map("resolved_by_id")
  resolvedAt   DateTime?          @map("resolved_at")
  appliedAt    DateTime?          @map("applied_at")

  run DevTeamRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, path])
  @@map("dev_team_merged_files")
}
